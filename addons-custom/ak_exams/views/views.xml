<odoo>
  <data>

    <!-- Form View'a Company Field Ekleme -->
    <record id="survey_form_view_inherit" model="ir.ui.view">
        <field name="name">survey.survey.form.inherit.company</field>
        <field name="model">survey.survey</field>
        <field name="inherit_id" ref="survey.survey_survey_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='access_mode']" position="after">
                <field name="company_id" groups="base.group_multi_company"/>
            </xpath>
        </field>
    </record>
    
    <!-- Tree View'a Company Field Ekleme -->
    <record id="survey_tree_view_inherit" model="ir.ui.view">
        <field name="name">survey.survey.tree.inherit.company</field>
        <field name="model">survey.survey</field>
        <field name="inherit_id" ref="survey.survey_survey_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='title']" position="after">
                <field name="company_id" optional="show" groups="base.group_multi_company"/>
            </xpath>
        </field>
    </record>
    
    <!-- Search View'a Company Field Ekleme -->
    <record id="survey_search_view_inherit" model="ir.ui.view">
        <field name="name">survey.survey.search.inherit.company</field>
        <field name="model">survey.survey</field>
        <field name="inherit_id" ref="survey.survey_survey_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='title']" position="after">
                <field name="company_id" groups="base.group_multi_company"/>
                <filter string="My Company" name="my_company" domain="[('company_id', '=', company_id)]"/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter string="Company" name="company" domain="[]" context="{'group_by': 'company_id'}"/>
            </xpath>
        </field>
    </record>

    <!-- CRM Team views update-->
    <record id="view_crm_team_tree_inherit" model="ir.ui.view">
        <field name="name">crm.team.tree.inherit</field>
        <field name="model">crm.team</field>
        <field name="inherit_id" ref="sales_team.crm_team_view_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="parent_id" string="Parent Team" optional="show"/>
                <field name="external_id" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="view_crm_team_form_inherit" model="ir.ui.view">
        <field name="name">crm.team.form.inherit</field>
        <field name="model">crm.team</field>
        <field name="inherit_id" ref="sales_team.crm_team_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='alias_name']" position="before">
                <field name="external_id"/>
            </xpath>
         </field>
    </record>

   <!-- Users views update-->
    <record id="res_users_view_tree_inherit_external_id" model="ir.ui.view">
        <field name="name">res.users.view.tree.inherit.external.id</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_tree"/>
        <field name="arch" type="xml">
            <field name="login" position="after">
                <field name="external_id" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="res_users_view_form_inherit_external_id" model="ir.ui.view">
        <field name="name">res.users.view.form.inherit.external.id</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <field name="login" position="after">
                <group>
                    <!-- <label for="external_id" string="Harici ID"/> -->
                    <field name="external_id"/>
                </group>
            </field>
        </field>
    </record>


    <!-- Survey User Input views update for security violations -->
    <record id="survey_user_input_view_form_inherit_security" model="ir.ui.view">
        <field name="name">survey.user_input.form.inherit.security</field>
        <field name="model">survey.user_input</field>
        <field name="inherit_id" ref="survey.survey_user_input_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Security Violations" name="security_violations">
                        <group>
                            <group string="Violation Counts">
                                <field name="fullscreen_violation_count"/>
                                <field name="tab_switch_violation_count"/>
                                <field name="devtools_attempt_count"/>
                                <field name="print_screen_attempt_count"/>
                            </group>
                            <group string="Totals &amp; Status">
                                <field name="total_security_violations"/>
                                <field name="accumulated_penalty_points"/>
                                <field name="is_terminated"/>
                                <field name="exclude_from_statistics"/>
                            </group>
                        </group>
                    </page>
                    <page string="Captured Photos" name="captured_photos" invisible="photo_count == 0">
                        <group>
                            <group>
                                <field name="camera_permission_granted"/>
                                <field name="camera_permission_datetime"/>
                            </group>
                            <group>
                                <field name="photo_count"/>
                            </group>
                        </group>
                        <field name="photo_ids" mode="kanban" nolabel="1">
                            <kanban>
                                <field name="id"/>
                                <field name="photo"/>
                                <field name="capture_datetime"/>
                                <field name="capture_type"/>
                                <field name="capture_success"/>
                                <templates>
                                    <t t-name="kanban-box">
                                        <div class="oe_kanban_global_click" style="max-width: 250px; margin: 5px;">
                                            <div class="o_kanban_image" style="text-align: center;">
                                                <img t-att-src="kanban_image('survey.user_input.photo', 'photo', record.id.raw_value)"
                                                     alt="Exam Photo"
                                                     style="max-width: 230px; max-height: 200px; margin: 10px;"/>
                                            </div>
                                            <div class="oe_kanban_details" style="padding: 5px;">
                                                <strong>
                                                    <field name="capture_type"/>
                                                </strong>
                                                <div>
                                                    <field name="capture_datetime" widget="datetime"/>
                                                </div>
                                                <div>
                                                    <span t-if="record.capture_success.raw_value" class="badge badge-success">
                                                        Success
                                                    </span>
                                                    <span t-else="" class="badge badge-danger">
                                                        Failed
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                    </t>
                                </templates>
                            </kanban>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

    <record id="survey_user_input_view_tree_inherit_security" model="ir.ui.view">
        <field name="name">survey.user_input.tree.inherit.security</field>
        <field name="model">survey.user_input</field>
        <field name="inherit_id" ref="survey.survey_user_input_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="is_terminated" optional="show"/>
                <field name="exclude_from_statistics" optional="show"/>
                <field name="total_security_violations" optional="show"/>
                <field name="accumulated_penalty_points" optional="show"/>
                <field name="fullscreen_violation_count" optional="hide"/>
                <field name="tab_switch_violation_count" optional="hide"/>
                <field name="devtools_attempt_count" optional="hide"/>
                <field name="print_screen_attempt_count" optional="hide"/>
            </xpath>
        </field>
    </record>

  </data>
</odoo>
