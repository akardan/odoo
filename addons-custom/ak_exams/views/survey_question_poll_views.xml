<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Survey Question Poll Category Views -->
    <record id="survey_question_poll_category_view_tree" model="ir.ui.view">
        <field name="name">survey.question.poll.category.tree</field>
        <field name="model">survey.question.poll.category</field>
        <field name="arch" type="xml">
            <list string="Poll Categories">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="survey_question_poll_category_view_form" model="ir.ui.view">
        <field name="name">survey.question.poll.category.form</field>
        <field name="model">survey.question.poll.category</field>
        <field name="arch" type="xml">
            <form string="Poll Category">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Survey Question Poll Views -->
    <record id="survey_question_poll_view_tree" model="ir.ui.view">
        <field name="name">survey.question.poll.tree</field>
        <field name="model">survey.question.poll</field>
        <field name="arch" type="xml">
            <list string="Poll Templates">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="survey_question_poll_view_form" model="ir.ui.view">
        <field name="name">survey.question.poll.form</field>
        <field name="model">survey.question.poll</field>
        <field name="arch" type="xml">
            <form string="Poll Template">
                <header>
                    <button name="import_from_excel" string="Import from Excel" type="object" class="oe_highlight"/>
                </header>
                <sheet>
                    <group string="Excel Import">
                        <field name="excel_file" filename="excel_file_name"/>
                        <field name="excel_file_name" invisible="1"/>
                    </group>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="e.g. Customer Satisfaction Poll"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="category_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Add a description for this poll template..."/>
                        </page>
                        <page string="Options" name="options">
                            <field name="option_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="value_image" widget="image" options="{'size': [50, 50]}"/>
                                    <field name="is_correct"/>
                                    <field name="answer_score"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="survey_question_poll_category_action" model="ir.actions.act_window">
        <field name="name">Poll Categories</field>
        <field name="res_model">survey.question.poll.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="survey_question_poll_action" model="ir.actions.act_window">
        <field name="name">Poll Templates</field>
        <field name="res_model">survey.question.poll</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu Items -->
    <menuitem
        id="menu_survey_question_poll_config"
        name="Poll Templates Config"
        parent="survey.survey_menu_questions" 
        sequence="100"/> 
        <!-- Placing under Survey -> Questions & Answers -->

    <menuitem
        id="menu_survey_question_poll_category"
        name="Poll Categories"
        parent="menu_survey_question_poll_config"
        action="survey_question_poll_category_action"
        sequence="10"/>

    <menuitem
        id="menu_survey_question_poll"
        name="Poll Templates"
        parent="menu_survey_question_poll_config"
        action="survey_question_poll_action"
        sequence="20"/>

</odoo>