<odoo>
    <data>

        <template id="survey_fill_header_inherit" inherit_id="survey.survey_fill_header" name="Survey Fill Header Inherit">
            <!-- Remove the original timer div -->
            <xpath expr="//div[hasclass('o_survey_timer')]" position="replace"/>

            <!-- Add the timer div after the o_survey_nav div -->
            <xpath expr="//div[hasclass('o_survey_nav')]" position="after">
                <div class="o_survey_timer pt-4">
                    <h1 class="o_survey_timer_container timer text-end">
                    </h1>
                </div>
            </xpath>
        </template>

        <template id="survey_progression_inherit" inherit_id="survey.survey_progression" name="Survey Progression Inherit">
            <!-- Fix percentage calculation for correct progress display -->
            <xpath expr="//t[@t-set='percentage']" position="replace">
                <t t-set="percentage" t-value="round(100*((page_number + 1)/len(page_ids)))"/>
            </xpath>
            
            <!-- Update question number display -->
            <xpath expr="//t[@t-else][span[@t-esc='page_number']]" position="replace">
                <t t-else="">
                    Soru <span class="o_survey_progress_number" t-esc="page_number + 1"/> / <span t-esc="len(page_ids)"/>
                </t>
            </xpath>
            
            <!-- Fix percent mode display -->
            <xpath expr="//span[@class='o_survey_progress_percent']" position="replace">
                <span class="o_survey_progress_percent" t-esc="percentage"/> %
            </xpath>
        </template>
        
        <template id="brand_promotion_message_inherit" inherit_id="web.brand_promotion_message" name="Brand Promotion Message Inherit">
            <xpath expr="//t[@t-set='odoo_logo']" position="replace">
                <t t-set="odoo_logo">
                    <a target="_blank" href="https://digipharma.com.tr" class="badge text-bg-light">
                        <span class="o_logo_text">DigiPharma</span>
                    </a>
                </t>
            </xpath>
        </template>
        
        <template id="survey_fill_form_start_inherit" inherit_id="survey.survey_fill_form_start" name="Survey Fill Form Start Turkish">
            <!-- Türkçe zaman sınırı mesajı -->
            <xpath expr="//div[@t-if='survey.is_time_limited']/p" position="replace">
                <p>
                    <span t-if="survey.certification or survey.survey_type == 'assessment'">
                        Bu sınav için zaman sınırı: <span class="fw-bold text-danger" t-field="survey.time_limit" t-options="{'widget': 'duration', 'unit': 'minute'}"></span>
                    </span>
                    <span t-else="">
                        Bu anket için zaman sınırı: <span class="fw-bold text-danger" t-field="survey.time_limit" t-options="{'widget': 'duration', 'unit': 'minute'}"></span>
                    </span>
                </p>
            </xpath>
            
            <!-- Türkçe buton metinleri -->
            <xpath expr="//button[@type='submit']" position="replace">
                <button type="submit" value="start" class="btn btn-primary btn-lg disabled">
                    <t t-if="survey.certification">
                        Sertifikasyon Sınavını Başlat
                    </t>
                    <t t-elif="survey.survey_type == 'assessment'">
                        Sınavı Başlat
                    </t>
                    <t t-else="">
                        Anketi Başlat
                    </t>
                </button>
            </xpath>
            
            <!-- Türkçe Enter mesajı -->
            <xpath expr="//span[@class='o_survey_enter fw-bold text-muted ms-2 d-none d-md-inline']" position="replace">
                <span class="o_survey_enter fw-bold text-muted ms-2 d-none d-md-inline">veya Enter'a basın</span>
            </xpath>
        </template>
        
        <template id="survey_closed_expired_inherit" inherit_id="survey.survey_closed_expired" name="Survey Closed Turkish">
            <!-- Türkçe survey kapalı mesajı -->
            <xpath expr="//h1" position="replace">
                <h1><span t-field="survey.title"/> katılıma açık durumda değildir.</h1>
            </xpath>
            
            <xpath expr="//p" position="replace">
                <p>
                    <span t-if="survey.survey_type == 'assessment' or survey.certification">
                        Bu sınav şu an kapalıdır. İlginiz için teşekkür ederiz!
                    </span>
                    <span t-else="">
                        Bu anket şu an kapalıdır. İlginiz için teşekkür ederiz!
                    </span>
                </p>
            </xpath>
        </template>

    </data>
</odoo>
