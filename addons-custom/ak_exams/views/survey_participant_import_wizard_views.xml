<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_survey_participant_import_wizard_form" model="ir.ui.view">
        <field name="name">survey.participant.import.wizard.form</field>
        <field name="model">survey.participant.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Participants">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,analyzed,done"/>
                </header>
                <sheet>
                    <group>
                        <field name="excel_file" filename="excel_file_name" readonly="state != 'draft'"/>
                        <field name="excel_file_name" invisible="1"/>
                        <field name="partner_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                        <field name="tag_ids" widget="many2many_tags" options="{'no_create': False}" readonly="state != 'draft'"/>
                    </group>
                    <notebook invisible="state == 'draft'">
                        <page string="Analysis Result">
                            <field name="analysis_result" widget="html"/>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_analyze" string="Analyze" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_import" string="Import" type="object" class="btn-primary" invisible="state != 'analyzed'"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_survey_participant_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Participants</field>
        <field name="res_model">survey.participant.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_survey_participant_import_wizard"
              name="Import Participants"
              parent="menu_survey_question_poll_config"
              action="action_survey_participant_import_wizard"
              sequence="100"/>
</odoo>
