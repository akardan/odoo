<odoo>
    <data>
        <!-- Make scoring_percentage editable in form view -->
        <record id="survey_user_input_view_form_inherit_editable_score" model="ir.ui.view">
            <field name="name">survey.user_input.form.inherit.editable.score</field>
            <field name="model">survey.user_input</field>
            <field name="inherit_id" ref="survey.survey_user_input_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='scoring_success']" position="after">
                    <field name="scoring_percentage" readonly="0"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>