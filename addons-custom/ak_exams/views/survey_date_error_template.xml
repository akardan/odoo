<odoo>
    <data>
        <!-- Custom template for survey date/time errors -->
        <template id="survey_date_error" name="Survey Date Error">
            <t t-call="survey.layout">
                <div class="wrap">
                    <div class="container">
                        <div class="jumbotron mt32 text-center">
                            <h1><span t-field="survey.title"/></h1>
                            <p class="alert alert-warning mt-4">
                                <i class="fa fa-clock-o"/> <span t-esc="error_message"/>
                            </p>
                        </div>
                    </div>
                </div>
            </t>
        </template>
    </data>
</odoo>
