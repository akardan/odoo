<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Server Action to Reset Survey Inputs to New -->
        <record id="action_reset_survey_inputs_to_new" model="ir.actions.server">
            <field name="name">Durumu "Yeni" Yap</field>
            <field name="model_id" ref="survey.model_survey_user_input"/>
            <field name="binding_model_id" ref="survey.model_survey_user_input"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">
if records:
    action = records.action_reset_to_new()
            </field>
        </record>

        <!-- Server Action to Set Survey Inputs to In Progress -->
        <record id="action_set_survey_inputs_to_in_progress" model="ir.actions.server">
            <field name="name">Durumu "İşlemde" Yap</field>
            <field name="model_id" ref="survey.model_survey_user_input"/>
            <field name="binding_model_id" ref="survey.model_survey_user_input"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">
if records:
    action = records.action_set_to_in_progress()
            </field>
        </record>
    </data>
</odoo>
