<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Şirket Bazlı Erişim Kuralı -->
        <record id="survey_comp_rule" model="ir.rule">
            <field name="name">Survey: Multi-company rule</field>
            <field name="model_id" ref="survey.model_survey_survey"/>
            <field name="domain_force">[('company_id', 'in', [False, company_id])]</field>
            <field name="global" eval="True"/>
        </record>

        <!-- Anket Soruları için Şirket Bazlı Erişim Kuralı -->
        <record id="survey_question_comp_rule" model="ir.rule">
            <field name="name">Survey Questions: Multi-company rule</field>
            <field name="model_id" ref="survey.model_survey_question"/>
            <field name="domain_force">[('survey_id.company_id', 'in', [False, company_id])]</field>
            <field name="global" eval="True"/>
        </record>

        <!-- Anket Cevap Seçenekleri için Şirket Bazlı Erişim Kuralı -->
        <record id="survey_question_answer_comp_rule" model="ir.rule">
            <field name="name">Survey Question Answers: Multi-company rule</field>
            <field name="model_id" ref="survey.model_survey_question_answer"/>
            <field name="domain_force">['|', ('question_id.survey_id.company_id', '=', False), ('question_id.survey_id.company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        
        <!-- Eğer ihtiyaç duyarsanız user_input için de kural ekleyebilirsiniz -->
        <!-- <record id="survey_user_input_comp_rule" model="ir.rule">
            <field name="name">Survey Answer: Multi-company rule</field>
            <field name="model_id" ref="survey.model_survey_user_input"/>
            <field name="domain_force">[('survey_id.company_id', 'in', [False, company_id])]</field>
            <field name="global" eval="True"/>
        </record> -->
    </data>
</odoo>