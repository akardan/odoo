<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0"> <!-- noupdate="1" if you don't want them updated on module update after initial creation -->

        <record id="survey_question_poll_category_company_rule" model="ir.rule">
            <field name="name">Survey Poll Category Company Rule</field>
            <field name="model_id" ref="model_survey_question_poll_category"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="survey_question_poll_company_rule" model="ir.rule">
            <field name="name">Survey Poll Company Rule</field>
            <field name="model_id" ref="model_survey_question_poll"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>