<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Knowledge Builder Views -->
        <record id="view_ak_ai_knowledge_builder_form" model="ir.ui.view">
            <field name="name">ak_ai.knowledge_builder.form</field>
            <field name="model">ak_ai.knowledge_builder</field>
            <field name="arch" type="xml">
                <form string="AI Knowledge Entry">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="title" placeholder="Knowledge Title"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="category"/>
                                <field name="model_name"/>
                                <field name="tags"/>
                                <field name="active"/>
                            </group>
                            <group>
                                <field name="usage_count"/>
                                <field name="last_used"/>
                                <field name="accuracy_score"/>
                                <field name="user_rating"/>
                            </group>
                        </group>
                        <group>
                            <field name="content" widget="text"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        
        <record id="view_ak_ai_knowledge_builder_tree" model="ir.ui.view">
            <field name="name">ak_ai.knowledge_builder.tree</field>
            <field name="model">ak_ai.knowledge_builder</field>
            <field name="arch" type="xml">
                <list string="AI Knowledge Base">
                    <field name="title"/>
                    <field name="category"/>
                    <field name="usage_count"/>
                    <field name="accuracy_score"/>
                    <field name="active"/>
                </list>
            </field>
        </record>
        
        <record id="view_ak_ai_knowledge_builder_search" model="ir.ui.view">
            <field name="name">ak_ai.knowledge_builder.search</field>
            <field name="model">ak_ai.knowledge_builder</field>
            <field name="arch" type="xml">
                <search string="Search Knowledge">
                    <field name="title"/>
                    <field name="content"/>
                    <field name="tags"/>
                    <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                    <group expand="0" string="Group By">
                        <filter string="Category" name="category" context="{'group_by': 'category'}"/>
                        <filter string="Model" name="model" context="{'group_by': 'model_name'}"/>
                    </group>
                </search>
            </field>
        </record>
        
        <record id="action_ak_ai_knowledge_builder" model="ir.actions.act_window">
            <field name="name">AI Knowledge Base</field>
            <field name="res_model">ak_ai.knowledge_builder</field>
            <field name="view_mode">list,form</field>
        </record>
        
        <!-- Interaction Log Views -->
        <record id="view_ak_ai_interaction_log_tree" model="ir.ui.view">
            <field name="name">ak_ai.interaction_log.tree</field>
            <field name="model">ak_ai.interaction_log</field>
            <field name="arch" type="xml">
                <list string="AI Interaction Logs" create="false" edit="false">
                    <field name="create_date"/>
                    <field name="user_id"/>
                    <field name="ai_provider"/>
                    <field name="model_name"/>
                    <field name="tokens_input" sum="Total Input Tokens"/>
                    <field name="tokens_output" sum="Total Output Tokens"/>
                    <field name="tokens_used" sum="Total Tokens"/>
                    <field name="cost" sum="Total Cost" widget="monetary" groups="base.group_system"/>
                    <field name="response_time" avg="Average Response Time"/>
                </list>
            </field>
        </record>

        <record id="view_ak_ai_interaction_log_form" model="ir.ui.view">
            <field name="name">ak_ai.interaction_log.form</field>
            <field name="model">ak_ai.interaction_log</field>
            <field name="arch" type="xml">
                <form string="AI Interaction Log" create="false" edit="false">
                    <sheet>
                        <group>
                            <group>
                                <field name="user_id"/>
                                <field name="create_date"/>
                                <field name="ai_provider"/>
                                <field name="model_name"/>
                            </group>
                            <group>
                                <field name="tokens_input"/>
                                <field name="tokens_output"/>
                                <field name="tokens_used"/>
                                <field name="cost" widget="monetary" groups="base.group_system"/>
                                <field name="response_time"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Messages" name="messages">
                                <group>
                                    <field name="user_message"/>
                                    <field name="ai_response"/>
                                </group>
                            </page>
                            <page string="Context &amp; Audit" name="context_audit">
                                <group>
                                    <field name="context_data"/>
                                    <field name="ip_address"/>
                                    <field name="user_agent"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        
        <record id="action_ak_ai_interaction_log" model="ir.actions.act_window">
            <field name="name">AI Interaction Logs</field>
            <field name="res_model">ak_ai.interaction_log</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('user_id', '=', uid)]</field>
        </record>
        
    </data>
</odoo>