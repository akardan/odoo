<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- AI Assistant Views -->
        <record id="view_ak_ai_assistant_form" model="ir.ui.view">
            <field name="name">ak_ai.assistant.form</field>
            <field name="model">ak_ai.assistant</field>
            <field name="arch" type="xml">
                <form string="AI Assistant Configuration">
                    <header>
                        <button name="check_user_access" string="Test Access" type="object" class="btn-primary"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Assistant Name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="active"/>
                                <field name="ai_provider"/>
                                <field name="model_name"
                                       placeholder="e.g., gpt-4o-mini, claude-3-5-haiku-20241022, anthropic/claude-3.5-haiku"/>
                                <field name="api_key" password="True" groups="base.group_system"/>
                                <field name="api_base_url"
                                       placeholder="API base URL (set automatically)"/>
                            </group>
                            <group>
                                <field name="max_tokens"/>
                                <field name="temperature"/>
                                <field name="rate_limit_per_user"/>
                                <field name="enable_learning"/>
                                <field name="knowledge_retention_days"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="User Access">
                                <group>
                                    <field name="allowed_user_ids" widget="many2many_tags"/>
                                    <field name="allowed_group_ids" widget="many2many_tags"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        
        <record id="view_ak_ai_assistant_tree" model="ir.ui.view">
            <field name="name">ak_ai.assistant.tree</field>
            <field name="model">ak_ai.assistant</field>
            <field name="arch" type="xml">
                <list string="AI Assistants">
                    <field name="name"/>
                    <field name="ai_provider"/>
                    <field name="model_name"/>
                    <field name="active"/>
                </list>
            </field>
        </record>
        
        <record id="action_ak_ai_assistant" model="ir.actions.act_window">
            <field name="name">AI Assistant Configuration</field>
            <field name="res_model">ak_ai.assistant</field>
            <field name="view_mode">list,form</field>
        </record>
        
    </data>
</odoo>