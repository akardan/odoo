<?xml version="1.0" encoding="UTF-8"?>
<svg width="128" height="128" viewBox="0 0 128 128" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#875A7B;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#6d4661;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Background Circle -->
  <circle cx="64" cy="64" r="60" fill="url(#grad1)" stroke="#fff" stroke-width="4"/>
  
  <!-- Robot Head -->
  <rect x="40" y="35" width="48" height="40" rx="8" fill="#fff"/>
  
  <!-- Eyes -->
  <circle cx="52" cy="50" r="4" fill="#875A7B"/>
  <circle cx="76" cy="50" r="4" fill="#875A7B"/>
  
  <!-- Mouth -->
  <rect x="56" y="62" width="16" height="2" rx="1" fill="#875A7B"/>
  
  <!-- Antenna -->
  <line x1="64" y1="35" x2="64" y2="25" stroke="#fff" stroke-width="2"/>
  <circle cx="64" cy="23" r="3" fill="#fff"/>
  
  <!-- Body -->
  <rect x="45" y="75" width="38" height="30" rx="6" fill="#fff"/>
  
  <!-- Arms -->
  <rect x="30" y="80" width="15" height="6" rx="3" fill="#fff"/>
  <rect x="83" y="80" width="15" height="6" rx="3" fill="#fff"/>
  
  <!-- Text -->
  <text x="64" y="118" text-anchor="middle" font-family="Arial, sans-serif" font-size="12" font-weight="bold" fill="#fff">KAI</text>
</svg>