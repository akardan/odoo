<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Patch mail.Chatter template to add Ask KAI button -->
    <t t-name="mail.Chatter" t-inherit="mail.Chatter" t-inherit-mode="extension" owl="1">
        <!-- Add Ask KAI button after "Activities" button and before the spacer -->
        <xpath expr="//span[hasclass('o-mail-Chatter-topbarGrow')]" position="before">
            <button t-if="hasAiButton"
                    class="btn btn-secondary text-nowrap me-1 o_chatter_button_ask_kai"
                    t-att-class="{'my-2': !props.compactHeight}"
                    type="button"
                    title="Ask KAI - AI Assistant"
                    t-on-click="toggleAiInput">
                <img src="/ak_ai/static/description/icon.png" style="width: 16px; height: 16px; margin-right: 4px; vertical-align: middle;" alt="KAI"/> Ask KAI
            </button>
        </xpath>
        
        <!-- Add AI input area below chatter topbar -->
        <xpath expr="//div[hasclass('o-mail-Chatter-topbar')]" position="after">
            <div t-if="state.showAiInput and hasAiButton" class="o-mail-AiInput border rounded p-3 mb-3" style="background-color: #f8f9fa;">
                <div class="mb-2">
                    <label class="fw-bold text-primary">
                        <img src="/ak_ai/static/description/icon.png" style="width: 18px; height: 18px; margin-right: 6px; vertical-align: middle;" alt="KAI"/> Ask KAI - AI Assistant
                    </label>
                </div>
                <div class="d-flex gap-2">
                    <textarea
                        class="form-control flex-grow-1"
                        t-model="state.aiMessage"
                        placeholder="Type your question or request here..."
                        rows="3"
                        style="resize: vertical; min-height: 80px;"/>
                </div>
                <div class="mt-2 d-flex gap-2 justify-content-end">
                    <button class="btn btn-secondary btn-sm" t-on-click="closeAiInput" type="button">
                        <i class="fa fa-times"/> Cancel
                    </button>
                    <button class="btn btn-primary btn-sm" t-on-click="sendAiMessage" type="button">
                        <img src="/ak_ai/static/description/icon.png" style="width: 14px; height: 14px; margin-right: 4px; vertical-align: middle;" alt="KAI"/> Send to KAI
                    </button>
                </div>
            </div>
        </xpath>
    </t>

</templates>
