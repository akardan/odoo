<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    
    <t t-name="ak_ai.ChatWidget" owl="1">
        <div class="ak_ai_chat_widget">
            <div class="ak_ai_chat_header">
                <i class="fa fa-robot"/> KAI Assistant
            </div>
            
            <div class="ak_ai_chat_messages">
                <t t-foreach="state.messages" t-as="message" t-key="message.id">
                    <div t-attf-class="ak_ai_message #{message.message_type}">
                        <div class="ak_ai_message_content">
                            <t t-esc="message.content"/>
                            
                            <t t-if="message.message_type === 'assistant'">
                                <div class="ak_ai_rating">
                                    <t t-foreach="[1,2,3,4,5]" t-as="star" t-key="star">
                                        <i t-attf-class="fa fa-star #{message.rating >= star ? '' : 'empty'}"
                                           t-on-click="() => this.rateMessage(message.id, star)"/>
                                    </t>
                                </div>
                            </t>
                        </div>
                    </div>
                </t>
                
                <t t-if="state.isTyping">
                    <div class="ak_ai_typing">
                        <i class="fa fa-circle-o-notch fa-spin"/> KAI yazıyor...
                    </div>
                </t>
            </div>
            
            <div class="ak_ai_chat_input">
                <input type="text" 
                       placeholder="Mesajınızı yazın..."
                       t-model="state.inputValue"
                       t-on-keypress="onKeyPress"
                       t-ref="input"/>
                <button t-on-click="sendMessage">
                    <i class="fa fa-paper-plane"/>
                </button>
            </div>
        </div>
    </t>
    
</templates>