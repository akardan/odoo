<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- AI Conversation Security Rules -->
        <record id="ak_ai_conversation_user_rule" model="ir.rule">
            <field name="name">AI Conversation: User Access</field>
            <field name="model_id" ref="model_ak_ai_conversation"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        
        <!-- AI Message Security Rules -->
        <record id="ak_ai_message_user_rule" model="ir.rule">
            <field name="name">AI Message: User Access</field>
            <field name="model_id" ref="model_ak_ai_message"/>
            <field name="domain_force">[('conversation_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        
        <!-- AI Learning Security Rules -->
        <record id="ak_ai_learning_user_rule" model="ir.rule">
            <field name="name">AI Learning: User Access</field>
            <field name="model_id" ref="model_ak_ai_learning"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        
        <!-- AI Interaction Log Security Rules -->
        <record id="ak_ai_interaction_log_user_rule" model="ir.rule">
            <field name="name">AI Interaction Log: User Access</field>
            <field name="model_id" ref="model_ak_ai_interaction_log"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        
        <!-- System Admin Full Access -->
        <record id="ak_ai_admin_rule" model="ir.rule">
            <field name="name">AI Models: Admin Full Access</field>
            <field name="model_id" ref="model_ak_ai_conversation"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        </record>
        
        <record id="ak_ai_admin_message_rule" model="ir.rule">
            <field name="name">AI Messages: Admin Full Access</field>
            <field name="model_id" ref="model_ak_ai_message"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        </record>
        
        <record id="ak_ai_admin_learning_rule" model="ir.rule">
            <field name="name">AI Learning: Admin Full Access</field>
            <field name="model_id" ref="model_ak_ai_learning"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        </record>
        
        <record id="ak_ai_admin_log_rule" model="ir.rule">
            <field name="name">AI Logs: Admin Full Access</field>
            <field name="model_id" ref="model_ak_ai_interaction_log"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        </record>
        
    </data>
</odoo>