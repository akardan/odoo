<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        
        <!-- Security Groups -->
        <record id="group_ak_ai_user" model="res.groups">
            <field name="name">KAI User</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="comment">Users who can use KAI AI Assistant</field>
        </record>
        
        <record id="group_ak_ai_manager" model="res.groups">
            <field name="name">KAI Manager</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="implied_ids" eval="[(4, ref('group_ak_ai_user'))]"/>
            <field name="comment">Users who can manage KAI AI Assistant configuration</field>
        </record>
        
        <!-- Give System Admins automatic access to KAI -->
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_ak_ai_user'))]"/>
        </record>
        
    </data>
    
    <data noupdate="1">
        
        <!-- AI Conversation Security Rules -->
        <record id="ak_ai_conversation_user_rule" model="ir.rule">
            <field name="name">AI Conversation: KAI User Access</field>
            <field name="model_id" ref="model_ak_ai_conversation"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_ak_ai_user'))]"/>
        </record>
        
        <!-- AI Message Security Rules -->
        <record id="ak_ai_message_user_rule" model="ir.rule">
            <field name="name">AI Message: KAI User Access</field>
            <field name="model_id" ref="model_ak_ai_message"/>
            <field name="domain_force">[('conversation_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_ak_ai_user'))]"/>
        </record>
        
        <!-- AI Learning Security Rules -->
        <record id="ak_ai_learning_user_rule" model="ir.rule">
            <field name="name">AI Learning: KAI User Access</field>
            <field name="model_id" ref="model_ak_ai_learning"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_ak_ai_user'))]"/>
        </record>
        
        <!-- AI Interaction Log Security Rules -->
        <record id="ak_ai_interaction_log_user_rule" model="ir.rule">
            <field name="name">AI Interaction Log: KAI User Access</field>
            <field name="model_id" ref="model_ak_ai_interaction_log"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_ak_ai_user'))]"/>
        </record>
        
        <!-- System Admin Full Access -->
        <record id="ak_ai_admin_rule" model="ir.rule">
            <field name="name">AI Models: Admin Full Access</field>
            <field name="model_id" ref="model_ak_ai_conversation"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        </record>
        
        <record id="ak_ai_admin_message_rule" model="ir.rule">
            <field name="name">AI Messages: Admin Full Access</field>
            <field name="model_id" ref="model_ak_ai_message"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        </record>
        
        <record id="ak_ai_admin_learning_rule" model="ir.rule">
            <field name="name">AI Learning: Admin Full Access</field>
            <field name="model_id" ref="model_ak_ai_learning"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        </record>
        
        <record id="ak_ai_admin_log_rule" model="ir.rule">
            <field name="name">AI Logs: Admin Full Access</field>
            <field name="model_id" ref="model_ak_ai_interaction_log"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        </record>
        
    </data>
</odoo>