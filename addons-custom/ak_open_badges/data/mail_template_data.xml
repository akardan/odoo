<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <record id="email_template_course_certificate" model="mail.template">
            <field name="name">Course: Certificate Notification</field>
            <field name="model_id" ref="ak_open_badges.model_badge_assertion"/>
            <field name="subject">Certificate Awarded: {{ object.badge_class_id.name }}</field>
            <field name="email_from">{{ object.badge_class_id.issuer_id.email|safe }}</field>
            <field name="email_to">{{ object.recipient_id.email|safe }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p>Dear {{ object.recipient_id.name }},</p>
                    <p>Congratulations! You have been awarded the "{{ object.badge_class_id.name }}".</p>
                     
                    <!-- Verification URL -->
                   <p>You can view and verify your certificate using this link:</p>
                     <div style="margin: 16px 0px 16px 0px; text-align: center;">
                        <a href="{{ object.assertion_url }}"
                           style="background-color: #875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;">
                            Verify Certificate
                        </a>
                    </div>
                    <p style="font-size: 12px; color: #666666;">
                        Or copy this URL: {{ object.assertion_url }}
                    </p>

                    <br/>
                    <p>Best regards,</p>
                    <p>{{ object.badge_class_id.issuer_id.name }}</p>
                </div>
            </field>
            <field name="lang">{{ object.recipient_id.lang }}</field>
            <field name="auto_delete" eval="False"/>
        </record>
    </data>
</odoo>
