                <!-- Logo and Welcome Section -->
                <div class="logo-section">
                    <div class="logo-container">
                        <a href="https://www.digipharma.com.tr" target="_blank">
                            <img src="/web/image/website/1/logo/DigiPharma.com.tr" alt="Digipharma Logo"/>
                        </a>
                    </div>
                    <div class="welcome-text">
                        <h4>Sertifika Doğrulama servisine hoş geldiniz.</h4>
                        <h5>Welcome to Certificate Verification service</h5>
                    </div>
                </div>
                <!-- Error Message Section -->
                <div class="alert alert-danger" role="alert">
                    <h4 class="alert-heading">Doğrulama Hatası</h4>
                    <p>Üzgünüz, bu sertifika doğrulanamadı. Lütfen sertifika bilgilerini kontrol edin ve tekrar deneyin.</p>
                    <hr/>
                    <p class="mb-0">Sorry, this certificate could not be verified. Please check the certificate details and try again.</p>
                </div>
            </div>
        </t>
    </template>

</odoo>