<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Kullanım Analitiği List View -->
    <record id="usage_analytics_list_view" model="ir.ui.view">
        <field name="name">Usage Analytics List</field>
        <field name="model">prospectus.usage.analytics</field>
        <field name="arch" type="xml">
            <list create="false" edit="false">
                <field name="access_date"/>
                <field name="prospectus_id"/>
                <field name="action"/>
                <field name="user_ip"/>
                <field name="language"/>
                <field name="country_code"/>
                <field name="city"/>
            </list>
        </field>
    </record>

    <!-- Kullanım Analitiği Form View -->
    <record id="usage_analytics_form_view" model="ir.ui.view">
        <field name="name">Usage Analytics Form</field>
        <field name="model">prospectus.usage.analytics</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="prospectus_id"/>
                            <field name="action"/>
                            <field name="access_date"/>
                            <field name="language"/>
                        </group>
                        <group>
                            <field name="user_ip"/>
                            <field name="country_code"/>
                            <field name="city"/>
                        </group>
                    </group>
                    
                    <group string="Tarayıcı Bilgisi">
                        <field name="user_agent" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Kullanım Analitiği Graph View -->
    <record id="usage_analytics_graph_view" model="ir.ui.view">
        <field name="name">Usage Analytics Graph</field>
        <field name="model">prospectus.usage.analytics</field>
        <field name="arch" type="xml">
            <graph string="Kullanım Analitiği">
                <field name="access_date" type="row" interval="day"/>
                <field name="action" type="col"/>
            </graph>
        </field>
    </record>

    <!-- Kullanım Analitiği Pivot View -->
    <record id="usage_analytics_pivot_view" model="ir.ui.view">
        <field name="name">Usage Analytics Pivot</field>
        <field name="model">prospectus.usage.analytics</field>
        <field name="arch" type="xml">
            <pivot string="Kullanım Analitiği">
                <field name="prospectus_id" type="row"/>
                <field name="action" type="col"/>
                <field name="access_date" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Dashboard View -->
    <record id="usage_analytics_dashboard_view" model="ir.ui.view">
        <field name="name">Usage Analytics Dashboard</field>
        <field name="model">prospectus.usage.analytics</field>
        <field name="arch" type="xml">
            <dashboard>
                <view type="graph" ref="usage_analytics_graph_view"/>
                <group expand="1" string="Filtreler">
                    <filter name="today" string="Bugün" 
                            domain="[('access_date', '&gt;=', (context_today()).strftime('%Y-%m-%d'))]"/>
                    <filter name="this_week" string="Bu Hafta" 
                            domain="[('access_date', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                    <filter name="this_month" string="Bu Ay" 
                            domain="[('access_date', '&gt;=', (context_today().replace(day=1)).strftime('%Y-%m-%d'))]"/>
                    <separator/>
                    <filter name="view_action" string="Görüntüleme" domain="[('action', '=', 'view')]"/>
                    <filter name="download_action" string="İndirme" domain="[('action', '=', 'download')]"/>
                    <filter name="audio_action" string="Ses Oynatma" domain="[('action', '=', 'audio_play')]"/>
                </group>
                <group expand="0" string="Gruplama">
                    <filter name="group_prospectus" string="Prospektüs" context="{'group_by': 'prospectus_id'}"/>
                    <filter name="group_action" string="Eylem" context="{'group_by': 'action'}"/>
                    <filter name="group_country" string="Ülke" context="{'group_by': 'country_code'}"/>
                    <filter name="group_language" string="Dil" context="{'group_by': 'language'}"/>
                </group>
            </dashboard>
        </field>
    </record>
    
    <!-- Search View -->
    <record id="usage_analytics_search_view" model="ir.ui.view">
        <field name="name">Usage Analytics Search</field>
        <field name="model">prospectus.usage.analytics</field>
        <field name="arch" type="xml">
            <search>
                <field name="prospectus_id"/>
                <field name="user_ip"/>
                <field name="country_code"/>
                <field name="language"/>
                <separator/>
                <filter string="Görüntüleme" name="view" domain="[('action', '=', 'view')]"/>
                <filter string="İndirme" name="download" domain="[('action', '=', 'download')]"/>
                <filter string="Ses Oynatma" name="audio_play" domain="[('action', '=', 'audio_play')]"/>
                <filter string="Dil Değişikliği" name="language_change" domain="[('action', '=', 'language_change')]"/>
                <separator/>
                <filter string="Bugün" name="today" 
                        domain="[('access_date', '&gt;=', (context_today()).strftime('%Y-%m-%d'))]"/>
                <filter string="Bu Hafta" name="this_week" 
                        domain="[('access_date', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <filter string="Bu Ay" name="this_month" 
                        domain="[('access_date', '&gt;=', (context_today().replace(day=1)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Prospektüs" name="group_by_prospectus" context="{'group_by': 'prospectus_id'}"/>
                    <filter string="Eylem" name="group_by_action" context="{'group_by': 'action'}"/>
                    <filter string="Tarih" name="group_by_date" context="{'group_by': 'access_date:day'}"/>
                    <filter string="Ülke" name="group_by_country" context="{'group_by': 'country_code'}"/>
                    <filter string="Dil" name="group_by_language" context="{'group_by': 'language'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="usage_analytics_action" model="ir.actions.act_window">
        <field name="name">Kullanım Analitiği</field>
        <field name="res_model">prospectus.usage.analytics</field>
        <field name="view_mode">list,graph,pivot,dashboard,form</field>
        <field name="context">{
            'search_default_this_month': 1,
            'search_default_group_prospectus': 1
        }</field>
    </record>
</odoo>