<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Prospektüs Form View -->
    <record id="digital_prospectus_form_view" model="ir.ui.view">
        <field name="name">Digital Prospectus Form</field>
        <field name="model">digital.prospectus</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button string="İnceleme Gönder" name="action_submit_for_review" 
                            states="draft" type="object" class="btn-primary"/>
                    <button string="Onayla" name="action_approve" 
                            states="review" type="object" class="btn-primary"/>
                    <button string="Yayınla" name="action_publish" 
                            states="approved" type="object" class="btn-success"/>
                    <button string="İptal Et" name="action_cancel" 
                            states="draft,review" type="object" class="btn-secondary"/>
                    <field name="state" widget="statusbar" 
                           statusbar_visible="draft,review,approved,published"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_analytics" icon="fa-chart-line">
                            <field string="Görüntülenme" name="view_count" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_view_analytics" icon="fa-download">
                            <field string="İndirme" name="download_count" widget="statinfo"/>
                        </button>
                    </div>
                    
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Prospektüs Adı"/></h1>
                    </div>
                    
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="partner_id"/>
                            <field name="responsible_user_id"/>
                        </group>
                        <group>
                            <field name="active_ingredient"/>
                            <field name="atc_code"/>
                            <field name="barcode"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="İçerik">
                            <group>
                                <field name="content_turkish" widget="html"/>
                            </group>
                            <group string="Çoklu Dil Desteği">
                                <field name="content_english" widget="html"/>
                                <field name="content_arabic" widget="html"/>
                            </group>
                        </page>
                        
                        <page string="Ses Dosyaları">
                            <group>
                                <field name="audio_turkish" filename="audio_turkish_filename"/>
                                <field name="audio_turkish_filename" invisible="1"/>
                                <field name="audio_english" filename="audio_english_filename"/>
                                <field name="audio_english_filename" invisible="1"/>
                                <field name="audio_arabic" filename="audio_arabic_filename"/>
                                <field name="audio_arabic_filename" invisible="1"/>
                            </group>
                        </page>
                        
                        <page string="QR Kod ve Erişim">
                            <group>
                                <field name="unique_code" readonly="1"/>
                                <field name="public_url" readonly="1" widget="url"/>
                                <field name="qr_code_image" widget="image" class="oe_avatar"/>
                            </group>
                        </page>
                        
                        <page string="Tarihler">
                            <group>
                                <field name="approval_date" readonly="1"/>
                                <field name="publication_date" readonly="1"/>
                                <field name="expiry_date"/>
                                <field name="last_accessed" readonly="1"/>
                            </group>
                        </page>
                        
                        <page string="Analitik">
                            <field name="usage_analytics_ids">
                                <list>
                                    <field name="access_date"/>
                                    <field name="action"/>
                                    <field name="user_ip"/>
                                    <field name="language"/>
                                    <field name="country_code"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Prospektüs Tree View -->
    <record id="digital_prospectus_tree_view" model="ir.ui.view">
        <field name="name">Digital Prospectus Tree</field>
        <field name="model">digital.prospectus</field>
        <field name="arch" type="xml">
            <list decoration-success="state=='published'" 
                  decoration-info="state=='approved'"
                  decoration-muted="state=='cancelled'">
                <field name="name"/>
                <field name="product_id"/>
                <field name="partner_id"/>
                <field name="state" widget="badge"/>
                <field name="view_count"/>
                <field name="download_count"/>
                <field name="last_accessed"/>
            </list>
        </field>
    </record>
    
    <!-- Prospektüs Search View -->
    <record id="digital_prospectus_search_view" model="ir.ui.view">
        <field name="name">Digital Prospectus Search</field>
        <field name="model">digital.prospectus</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="product_id"/>
                <field name="partner_id"/>
                <field name="unique_code"/>
                <field name="active_ingredient"/>
                <field name="atc_code"/>
                <field name="barcode"/>
                <separator/>
                <filter string="Taslak" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="İncelemede" name="review" domain="[('state', '=', 'review')]"/>
                <filter string="Onaylı" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Yayında" name="published" domain="[('state', '=', 'published')]"/>
                <filter string="Süresi Dolmuş" name="expired" domain="[('state', '=', 'expired')]"/>
                <filter string="İptal" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="Benim Sorumluluğumda" name="my_prospectus" domain="[('responsible_user_id', '=', uid)]"/>
                <group expand="0" string="Group By">
                    <filter string="Durum" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="İlaç Firması" name="group_by_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Ürün" name="group_by_product" context="{'group_by': 'product_id'}"/>
                    <filter string="Sorumlu" name="group_by_responsible" context="{'group_by': 'responsible_user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Prospektüs Kanban View -->
    <record id="digital_prospectus_kanban_view" model="ir.ui.view">
        <field name="name">Digital Prospectus Kanban</field>
        <field name="model">digital.prospectus</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="product_id"/>
                <field name="partner_id"/>
                <field name="state"/>
                <field name="view_count"/>
                <field name="download_count"/>
                <field name="qr_code_image"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <img t-att-src="kanban_image('digital.prospectus', 'qr_code_image', record.id.raw_value)" alt="QR Code"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="product_id"/>
                                </div>
                                <div>
                                    <field name="partner_id"/>
                                </div>
                                <div>
                                    <span class="badge badge-pill" t-attf-class="badge-#{record.state.raw_value == 'published' ? 'success' : (record.state.raw_value == 'approved' ? 'info' : 'secondary')}">
                                        <field name="state"/>
                                    </span>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <span title="Görüntülenme">
                                            <i class="fa fa-eye"/> <field name="view_count"/>
                                        </span>
                                        <span title="İndirme" class="ml-2">
                                            <i class="fa fa-download"/> <field name="download_count"/>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action -->
    <record id="digital_prospectus_action" model="ir.actions.act_window">
        <field name="name">Dijital Prospektüsler</field>
        <field name="res_model">digital.prospectus</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                İlk dijital prospektüsünüzü oluşturun!
            </p>
        </field>
    </record>
</odoo>