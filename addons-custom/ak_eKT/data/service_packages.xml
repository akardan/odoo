<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- S Paketi -->
        <record id="service_package_s" model="digital.service.package">
            <field name="name">S Paket</field>
            <field name="code">S</field>
            <field name="max_prospectus">25</field>
            <field name="price">999.00</field>
            <field name="currency_id" ref="base.TRY"/>
            <field name="ai_voice_included">False</field>
            <field name="studio_voice_included">False</field>
            <field name="multi_language">False</field>
            <field name="custom_development">False</field>
            <field name="account_manager">False</field>
            <field name="description"><![CDATA[
                <h3>S Paket - Başlangıç Düzeyi</h3>
                <ul>
                    <li>25 Adet Dijital Prospektüs</li>
                    <li>Temel QR Kod Erişimi</li>
                    <li>Türkçe İçerik Desteği</li>
                    <li>Temel Raporlama</li>
                    <li>E-posta Desteği</li>
                </ul>
            ]]></field>
        </record>

