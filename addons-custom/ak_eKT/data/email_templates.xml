<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Prospektüs Onay E-postası -->
        <record id="email_template_prospectus_approved" model="mail.template">
            <field name="name">Prospektüs Onaylandı</field>
            <field name="model_id" ref="model_digital_prospectus"/>
            <field name="subject">✅ ${object.product_id.name} Prospektüsü Onaylandı</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px; font-family: 'Lucida Grande', Ubuntu, Arial, Verdana, sans-serif; background-color: #f9f9f9;">
                    <table border="0" cellpadding="0" cellspacing="0" style="margin: 0px auto; width: 600px; background-color: white; border: 1px solid #e0e0e0;">
                        <tbody>
                            <tr>
                                <td style="padding: 20px; background-color: #28a745; color: white;">
                                    <h2 style="margin: 0px;">🎉 Prospektüsünüz Onaylandı!</h2>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 20px;">
                                    <p>Merhaba,</p>
                                    <p><strong>${object.product_id.name}</strong> için hazırladığınız dijital prospektüs başarıyla onaylanmıştır.</p>
                                    
                                    <div style="background-color: #f8f9fa; padding: 15px; border-left: 4px solid #28a745; margin: 20px 0;">
                                        <h4>Prospektüs Bilgileri:</h4>
                                        <ul>
                                            <li><strong>Ürün Adı:</strong> ${object.product_id.name}</li>
                                            <li><strong>İlaç Firması:</strong> ${object.partner_id.name}</li>
                                            <li><strong>Onay Tarihi:</strong> ${object.approval_date}</li>
                                            <li><strong>Durum:</strong> Onaylandı ✅</li>
                                        </ul>
                                    </div>

                                    <p>Artık prospektüsünüzü yayınlayabilirsiniz. Yayınlandıktan sonra QR kod ve URL üzerinden erişilebilir olacaktır.</p>
                                    
                                    <div style="text-align: center; margin: 30px 0;">
                                        <a href="${object.get_base_url()}/web#id={{ object.id }}&model=digital.prospectus&view_type=form"
                                           style="background-color: #007bff; color: white; padding: 12px 25px; text-decoration: none; border-radius: 5px; display: inline-block;">
                                            Prospektüsü Görüntüle
                                        </a>
                                    </div>
                                    
                                    <p>İyi çalışmalar,<br/>
                                    Dijital Prospektüs Yönetim Sistemi</p>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

        <!-- Prospektüs Yayınlandı E-postası -->
        <record id="email_template_prospectus_published" model="mail.template">
            <field name="name">Prospektüs Yayınlandı</field>
            <field name="model_id" ref="model_digital_prospectus"/>
            <field name="subject">🚀 ${object.product_id.name} Prospektüsü Yayında!</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px; font-family: 'Lucida Grande', Ubuntu, Arial, Verdana, sans-serif; background-color: #f9f9f9;">
                    <table border="0" cellpadding="0" cellspacing="0" style="margin: 0px auto; width: 600px; background-color: white; border: 1px solid #e0e0e0;">
                        <tbody>
                            <tr>
                                <td style="padding: 20px; background-color: #007bff; color: white;">
                                    <h2 style="margin: 0px;">🚀 Prospektüsünüz Yayında!</h2>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 20px;">
                                    <p>Merhaba,</p>
                                    <p><strong>${object.product_id.name}</strong> için hazırladığınız dijital prospektüs başarıyla yayınlanmıştır!</p>
                                    
                                    <div style="background-color: #e3f2fd; padding: 15px; border-left: 4px solid #007bff; margin: 20px 0;">
                                        <h4>Erişim Bilgileri:</h4>
                                        <ul>
                                            <li><strong>Herkese Açık URL:</strong><br/>
                                                <a href="${object.public_url}">${object.public_url}</a>
                                            </li>
                                            <li><strong>Benzersiz Kod:</strong> ${object.unique_code}</li>
                                            <li><strong>Yayın Tarihi:</strong> ${object.publication_date}</li>
                                        </ul>
                                    </div>

                                    <div style="text-align: center; margin: 20px 0;">
                                        <h4>QR Kod ile Erişim:</h4>
                                        <img src="/web/image/digital.prospectus/${object.id}/qr_code_image" 
                                             alt="QR Kod" style="max-width: 200px; border: 1px solid #ddd; padding: 10px;"/>
                                        <p style="font-size: 12px; color: #666;">
                                            QR kodu okutarak dijital prospektüse erişin
                                        </p>
                                    </div>
                                    
                                    <div style="text-align: center; margin: 30px 0;">
                                        <a href="${object.public_url}" 
                                           style="background-color: #28a745; color: white; padding: 12px 25px; text-decoration: none; border-radius: 5px; display: inline-block; margin: 5px;">
                                            Prospektüsü Görüntüle
                                        </a>
                                        <a href="${object.get_base_url()}/web#id={{ object.id }}&model=digital.prospectus&view_type=form"
                                           style="background-color: #6c757d; color: white; padding: 12px 25px; text-decoration: none; border-radius: 5px; display: inline-block; margin: 5px;">
                                            Yönetim Paneli
                                        </a>
                                    </div>
                                    
                                    <div style="background-color: #fff3cd; padding: 15px; border: 1px solid #ffeeba; border-radius: 5px; margin: 20px 0;">
                                        <h5 style="color: #856404; margin: 0;">📊 Takip Edebilecekleriniz:</h5>
                                        <ul style="color: #856404; margin: 10px 0;">
                                            <li>Görüntülenme sayısı</li>
                                            <li>İndirme istatistikleri</li>
                                            <li>Dil tercihleri</li>
                                            <li>Erişim analitikleri</li>
                                        </ul>
                                    </div>
                                    
                                    <p>İyi çalışmalar,<br/>
                                    Dijital Prospektüs Yönetim Sistemi</p>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>
        
        <!-- Abonelik Süresi Dolacak Uyarısı -->
        <record id="email_template_subscription_expiry_warning" model="mail.template">
            <field name="name">Abonelik Süresi Dolacak</field>
            <field name="model_id" ref="model_digital_customer_subscription"/>
            <field name="subject">⚠️ Dijital Prospektüs Aboneliğiniz Yakında Sona Eriyor</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px; font-family: 'Lucida Grande', Ubuntu, Arial, Verdana, sans-serif; background-color: #f9f9f9;">
                    <table border="0" cellpadding="0" cellspacing="0" style="margin: 0px auto; width: 600px; background-color: white; border: 1px solid #e0e0e0;">
                        <tbody>
                            <tr>
                                <td style="padding: 20px; background-color: #ffc107; color: #212529;">
                                    <h2 style="margin: 0px;">⚠️ Abonelik Uyarısı</h2>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 20px;">
                                    <p>Sayın ${object.partner_id.name},</p>
                                    <p>Dijital prospektüs aboneliğiniz <strong>${object.end_date}</strong> tarihinde sona erecektir.</p>
                                    
                                    <div style="background-color: #fff3cd; padding: 15px; border: 1px solid #ffeeba; border-radius: 5px; margin: 20px 0;">
                                        <h4 style="color: #856404; margin: 0;">📋 Abonelik Bilgileriniz:</h4>
                                        <ul style="color: #856404; margin: 10px 0;">
                                            <li><strong>Paket:</strong> ${object.package_id.name}</li>
                                            <li><strong>Mevcut Prospektüs:</strong> ${object.prospectus_count}</li>
                                            <li><strong>Bitiş Tarihi:</strong> ${object.end_date}</li>
                                        </ul>
                                    </div>

                                    <p>Hizmetinizde kesinti yaşamamak için lütfen aboneliğinizi yenileyin.</p>
                                    
                                    <div style="text-align: center; margin: 30px 0;">
                                        <a href="${object.get_base_url()}/web#id={{ object.id }}&model=digital.customer.subscription&view_type=form"
                                           style="background-color: #28a745; color: white; padding: 12px 25px; text-decoration: none; border-radius: 5px; display: inline-block;">
                                            Aboneliği Yenile
                                        </a>
                                    </div>
                                    
                                    <p>Sorularınız için bizimle iletişime geçebilirsiniz.</p>
                                    <p>Saygılarımızla,<br/>
                                    Dijital Prospektüs Destek Ekibi</p>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>