<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Kategoriler -->
    <record id="module_category_digital_prospectus" model="ir.module.category">
        <field name="name">Dijital Prospektüs</field>
        <field name="description">Dijital Prospektüs Yönetimi</field>
        <field name="sequence">50</field>
    </record>

    <!-- Güvenlik Grupları -->
    <record id="group_prospectus_user" model="res.groups">
        <field name="name">Kullanıcı</field>
        <field name="category_id" ref="module_category_digital_prospectus"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_prospectus_manager" model="res.groups">
        <field name="name">Yönetici</field>
        <field name="category_id" ref="module_category_digital_prospectus"/>
        <field name="implied_ids" eval="[(4, ref('group_prospectus_user'))]"/>
    </record>

    <!-- Record Rules -->
    <record id="prospectus_user_rule" model="ir.rule">
        <field name="name">Kullanıcı: Kendi Şirketinin Prospektüsleri</field>
        <field name="model_id" ref="model_digital_prospectus"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.commercial_partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_prospectus_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="prospectus_manager_rule" model="ir.rule">
        <field name="name">Yönetici: Tüm Prospektüsler</field>
        <field name="model_id" ref="model_digital_prospectus"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_prospectus_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    
    <!-- Service Package Rules -->
    <record id="service_package_user_rule" model="ir.rule">
        <field name="name">Kullanıcı: Sadece Okuma</field>
        <field name="model_id" ref="model_digital_service_package"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_prospectus_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    
    <!-- Analytics Rules -->
    <record id="analytics_user_rule" model="ir.rule">
        <field name="name">Kullanıcı: Kendi Şirketinin Analitikleri</field>
        <field name="model_id" ref="model_prospectus_usage_analytics"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.commercial_partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_prospectus_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    
    <!-- Subscription Rules -->
    <record id="subscription_user_rule" model="ir.rule">
        <field name="name">Kullanıcı: Kendi Şirketinin Abonelikleri</field>
        <field name="model_id" ref="model_digital_customer_subscription"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.commercial_partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_prospectus_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>