<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Herkese Açık Prospektüs Görüntüleme Template -->
    <template id="prospectus_public_view" name="Digital Prospectus Public View">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <div class="container-fluid bg-light py-5">
                    <div class="container">
                        <div class="row">
                            <div class="col-12">
                                <!-- Header -->
                                <div class="card shadow-sm mb-4">
                                    <div class="card-header bg-primary text-white">
                                        <div class="row align-items-center">
                                            <div class="col-md-8">
                                                <h1 class="mb-0">
                                                    <i class="fa fa-file-medical-alt me-2"/>
                                                    <t t-esc="prospectus.product_id.name"/>
                                                </h1>
                                                <p class="mb-0 mt-2">
                                                    <strong>Üretici:</strong> <t t-esc="prospectus.partner_id.name"/>
                                                </p>
                                            </div>
                                            <div class="col-md-4 text-end">
                                                <div class="btn-group" role="group">
                                                    <a href="#" class="btn btn-outline-light btn-sm lang-btn" 
                                                       data-lang="tr" t-att-class="'btn btn-outline-light btn-sm active' if current_lang == 'tr' else 'btn btn-outline-light btn-sm'">
                                                        🇹🇷 TR
                                                    </a>
                                                    <a href="#" class="btn btn-outline-light btn-sm lang-btn" 
                                                       data-lang="en" t-att-class="'btn btn-outline-light btn-sm active' if current_lang == 'en' else 'btn btn-outline-light btn-sm'">
                                                        🇬🇧 EN
                                                    </a>
                                                    <a href="#" class="btn btn-outline-light btn-sm lang-btn" 
                                                       data-lang="ar" t-att-class="'btn btn-outline-light btn-sm active' if current_lang == 'ar' else 'btn btn-outline-light btn-sm'">
                                                        🇸🇦 AR
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-6">
                                                <p><strong>Etken Madde:</strong> <t t-esc="prospectus.active_ingredient"/></p>
                                                <p><strong>ATC Kodu:</strong> <t t-esc="prospectus.atc_code"/></p>
                                            </div>
                                            <div class="col-md-6">
                                                <!-- Ses Oynatma -->
                                                <div class="audio-controls" t-if="audio">
                                                    <button class="btn btn-success btn-sm" id="playAudioBtn">
                                                        <i class="fa fa-play me-1"/>Seslendirmeyi Oynat
                                                    </button>
                                                    <audio id="prospectusAudio" style="display:none;">
                                                        <source t-att-src="'/web/content/digital.prospectus/%s/audio_%s' % (prospectus.id, current_lang)" type="audio/mpeg"/>
                                                    </audio>
                                                </div>
                                                
                                                <!-- İndirme Butonları -->
                                                <div class="mt-2">
                                                    <t t-set="download_url" t-value="'/ekt/download/%s' % prospectus.unique_code"/>
                                                    <a t-att-href="download_url + '?format=pdf'" class="btn btn-outline-primary btn-sm me-2">
                                                        <i class="fa fa-download me-1"/>PDF İndir
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- İçerik -->
                                <div class="card shadow-sm">
                                    <div class="card-body">
                                        <div id="prospectus-content" class="prospectus-content">
                                            <t t-raw="content"/>
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- Footer -->
                                <div class="text-center mt-4">
                                    <p class="text-muted">
                                        <small>
                                            Bu dijital prospektüs <t t-esc="prospectus.publication_date"/> tarihinde yayınlanmıştır.
                                            <br/>Son erişim: <span id="access-time"></span>
                                        </small>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- JavaScript -->
            <script type="text/javascript">
                $(document).ready(function() {
                    // Erişim zamanını güncelle
                    $('#access-time').text(new Date().toLocaleString('tr-TR'));
                    
                    // Dil değiştirme
                    $('.lang-btn').click(function(e) {
                        e.preventDefault();
                        var lang = $(this).data('lang');
                        window.location.href = window.location.pathname + '?lang=' + lang;
                    });
                    
                    // Ses oynatma
                    $('#playAudioBtn').click(function() {
                        var audio = document.getElementById('prospectusAudio');
                        if (audio.paused) {
                            audio.play();
                            $(this).html('<i class="fa fa-pause me-1"></i>Durdur');
                            
                            // Analitik kayıt
                            odoo.jsonRpc('/ekt/analytics', 'call', {
                                'unique_code': '<t t-esc="prospectus.unique_code"/>',
                                'action': 'audio_play',
                                'language': '<t t-esc="current_lang"/>'
                            });
                        } else {
                            audio.pause();
                            $(this).html('<i class="fa fa-play me-1"></i>Seslendirmeyi Oynat');
                        }
                    });
                    
                    // Audio bittiğinde
                    $('#prospectusAudio').on('ended', function() {
                        $('#playAudioBtn').html('<i class="fa fa-play me-1"></i>Seslendirmeyi Oynat');
                    });
                });
            </script>
        </t>
    </template>
    
    <!-- QR Kod Sayfası Template -->
    <template id="qr_code_page" name="QR Code Page">
        <t t-call="website.layout">
            <div class="container py-5 text-center">
                <h2>QR Kod ile Erişim</h2>
                <div class="mt-4">
                    <img t-att-src="'/web/image/digital.prospectus/%s/qr_code_image' % prospectus.id" 
                         class="img-fluid" style="max-width: 300px;"/>
                </div>
                <p class="mt-3">Bu QR kodu okutarak dijital prospektüse erişebilirsiniz.</p>
            </div>
        </t>
    </template>
</odoo>