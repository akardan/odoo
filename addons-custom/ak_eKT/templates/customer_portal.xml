<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Müşteri Portal Dashboard -->
    <template id="portal_my_prospectus" name="My Digital Prospectus">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Dijital Prospektüslerim</t>
            </t>
            
            <div class="row">
                <div class="col-12">
                    <div class="card mb-4">
                        <div class="card-header">
                            <div class="row align-items-center">
                                <div class="col-md-6">
                                    <h4 class="mb-0">Abonelik Bilgileri</h4>
                                </div>
                                <div class="col-md-6 text-end">
                                    <span t-if="subscription" class="badge badge-success">Aktif</span>
                                    <span t-else="" class="badge badge-warning">Pasif</span>
                                </div>
                            </div>
                        </div>
                        <div class="card-body" t-if="subscription">
                            <div class="row">
                                <div class="col-md-3">
                                    <strong>Paket:</strong><br/>
                                    <span t-field="subscription.package_id.name"/>
                                </div>
                                <div class="col-md-3">
                                    <strong>Kota:</strong><br/>
                                    <span t-field="subscription.prospectus_count"/> / 
                                    <span t-field="subscription.package_id.max_prospectus"/>
                                </div>
                                <div class="col-md-3">
                                    <strong>Başlangıç:</strong><br/>
                                    <span t-field="subscription.start_date"/>
                                </div>
                                <div class="col-md-3">
                                    <strong>Bitiş:</strong><br/>
                                    <span t-field="subscription.end_date"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <div class="row align-items-center">
                                <div class="col-md-6">
                                    <h4 class="mb-0">Prospektüslerim</h4>
                                </div>
                                <div class="col-md-6 text-end">
                                    <a href="/my/prospectus/new" class="btn btn-primary">
                                        <i class="fa fa-plus me-1"/>Yeni Prospektüs
                                    </a>
                                </div>
                            </div>
                        </div>
                        <div class="card-body">
                            <div t-if="not prospectus_list" class="text-center py-5">
                                <p class="text-muted">Henüz prospektüsünüz bulunmuyor.</p>
                                <a href="/my/prospectus/new" class="btn btn-primary">
                                    İlk Prospektüsünüzü Oluşturun
                                </a>
                            </div>
                            
                            <div t-if="prospectus_list" class="table-responsive">
                                <table class="table table-hover">
                                    <thead>
                                        <tr>
                                            <th>Prospektüs Adı</th>
                                            <th>Ürün</th>
                                            <th>Durum</th>
                                            <th>Görüntülenme</th>
                                            <th>İndirme</th>
                                            <th>Son Erişim</th>
                                            <th>İşlemler</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="prospectus_list" t-as="prospectus">
                                            <tr>
                                                <td>
                                                    <strong t-field="prospectus.name"/>
                                                </td>
                                                <td t-field="prospectus.product_id"/>
                                                <td>
                                                    <span t-field="prospectus.state" class="badge"
                                                          t-att-class="'badge badge-success' if prospectus.state == 'published' else 'badge badge-warning'"/>
                                                </td>
                                                <td t-field="prospectus.view_count"/>
                                                <td t-field="prospectus.download_count"/>
                                                <td t-field="prospectus.last_accessed"/>
                                                <td>
                                                    <div class="btn-group">
                                                        <a t-att-href="'/my/prospectus/' + str(prospectus.id)" 
                                                           class="btn btn-sm btn-outline-primary">
                                                            <i class="fa fa-eye"/>
                                                        </a>
                                                        <a t-if="prospectus.state == 'published'"
                                                           t-att-href="prospectus.public_url" 
                                                           class="btn btn-sm btn-outline-success"
                                                           target="_blank">
                                                            <i class="fa fa-external-link-alt"/>
                                                        </a>
                                                        <a t-att-href="'/my/prospectus/' + str(prospectus.id) + '/qr'" 
                                                           class="btn btn-sm btn-outline-info">
                                                            <i class="fa fa-qrcode"/>
                                                        </a>
                                                    </div>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
    
    <!-- Prospektüs Detay Sayfası -->
    <template id="portal_prospectus_detail" name="Prospectus Detail Portal">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            
            <div class="container">
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <div class="row align-items-center">
                                    <div class="col-md-8">
                                        <h3 t-field="prospectus.name"/>
                                        <p class="mb-0">
                                            <strong>Ürün:</strong> <t t-esc="prospectus.product_id.name"/>
                                        </p>
                                    </div>
                                    <div class="col-md-4 text-end">
                                        <span t-field="prospectus.state" class="badge"
                                              t-att-class="'badge badge-success' if prospectus.state == 'published' else 'badge badge-warning'"/>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <h5>İstatistikler</h5>
                                        <ul class="list-group">
                                            <li class="list-group-item d-flex justify-content-between">
                                                <span>Görüntülenme:</span>
                                                <span t-field="prospectus.view_count"/>
                                            </li>
                                            <li class="list-group-item d-flex justify-content-between">
                                                <span>İndirme:</span>
                                                <span t-field="prospectus.download_count"/>
                                            </li>
                                            <li class="list-group-item d-flex justify-content-between">
                                                <span>Son Erişim:</span>
                                                <span t-field="prospectus.last_accessed"/>
                                            </li>
                                        </ul>
                                    </div>
                                    
                                    <div class="col-md-6 text-center" t-if="prospectus.state == 'published'">
                                        <h5>QR Kod</h5>
                                        <img t-att-src="'/web/image/digital.prospectus/%s/qr_code_image' % prospectus.id" 
                                             class="img-fluid" style="max-width: 200px;"/>
                                        <p class="mt-2">
                                            <a t-att-href="prospectus.public_url" target="_blank" class="btn btn-success">
                                                Prospektüsü Görüntüle
                                            </a>
                                        </p>
                                    </div>
                                </div>
                                
                                <hr/>
                                
                                <div class="row">
                                    <div class="col-12">
                                        <h5>İçerik Önizleme</h5>
                                        <div class="border p-3" style="max-height: 300px; overflow-y: auto;">
                                            <t t-raw="prospectus.content_turkish[:500]"/>
                                            <span t-if="len(prospectus.content_turkish) > 500">...</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="mt-3">
                            <a href="/my/prospectus" class="btn btn-secondary">
                                <i class="fa fa-arrow-left me-1"/>Geri Dön
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
    
    <!-- Portal Ana Menü -->
    <template id="portal_my_home_menu_prospectus" name="Portal layout : prospectus menu entries" inherit_id="portal.portal_my_home" priority="40">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Dijital Prospektüsler</t>
                <t t-set="url" t-value="'/my/prospectus'"/>
                <t t-set="placeholder_count" t-value="'prospectus_count'"/>
            </t>
        </xpath>
    </template>

    <!-- Portal Breadcrumb -->
    <template id="portal_my_home_prospectus" name="My Prospectus" inherit_id="portal.portal_breadcrumbs" priority="40">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'prospectus'" t-attf-class="breadcrumb-item #{'active ' if not prospectus else ''}">
                <a t-if="prospectus" t-attf-href="/my/prospectus?{{ keep_query() }}">Dijital Prospektüsler</a>
                <t t-else="">Dijital Prospektüsler</t>
            </li>
            <li t-if="prospectus" class="breadcrumb-item active">
                <span t-field="prospectus.name"/>
            </li>
        </xpath>
    </template>
</odoo>