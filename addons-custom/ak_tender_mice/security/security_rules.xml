<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================================ -->
        <!-- ak.tender.scenario — Kayıt Bazlı Erişim Kuralları            -->
        <!-- ============================================================ -->

        <!-- Tender Requester: Sadece kendi ihalelerine ait senaryoları görebilir -->
        <record id="rule_scenario_requester_own" model="ir.rule">
            <field name="name">MICE Senaryo: Talep Edici Kendi İhalesini Görür</field>
            <field name="model_id" ref="ak_tender_mice.model_ak_tender_scenario"/>
            <field name="groups" eval="[(4, ref('ak_tender.group_tender_requester'))]"/>
            <field name="domain_force">[
                ('tender_id.buyer_id', '=', user.id)
            ]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Tender User: Kendi ihalelerini tam yönetebilir -->
        <record id="rule_scenario_user_own" model="ir.rule">
            <field name="name">MICE Senaryo: Kullanıcı Kendi İhalesini Yönetir</field>
            <field name="model_id" ref="ak_tender_mice.model_ak_tender_scenario"/>
            <field name="groups" eval="[(4, ref('ak_tender.group_tender_user'))]"/>
            <field name="domain_force">[
                ('tender_id.buyer_id', '=', user.id)
            ]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Tender Manager: Tüm senaryolara erişir (domain kısıtı yok) -->
        <record id="rule_scenario_manager_all" model="ir.rule">
            <field name="name">MICE Senaryo: Yönetici Tüm Senaryolara Erişir</field>
            <field name="model_id" ref="ak_tender_mice.model_ak_tender_scenario"/>
            <field name="groups" eval="[(4, ref('ak_tender.group_tender_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>
