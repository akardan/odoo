<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Paket Ekleme Sihirbazı — Form View                          -->
    <!-- ============================================================ -->
    <record id="view_add_packages_wizard_form" model="ir.ui.view">
        <field name="name">ak.tender.add.packages.wizard.form</field>
        <field name="model">ak.tender.add.packages.wizard</field>
        <field name="arch" type="xml">
            <form string="Paket Ekle">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="scenario_id" readonly="1" options="{'no_open': True}"/>
                        </h1>
                        <p class="text-muted">
                            Bu senaryo altına eklemek istediğiniz paket tiplerini seçin.
                        </p>
                    </div>

                    <group>
                        <group string="Ortak Bilgiler">
                            <field name="tender_id" readonly="1" options="{'no_open': True}"/>
                            <field name="location_id" options="{'no_create': True}"/>
                            <field name="person_count"/>
                        </group>
                    </group>

                    <separator string="Eklenecek Paketler"/>
                    <group>
                        <group string="Temel Paketler">
                            <field name="add_flight" widget="boolean_toggle"/>
                            <field name="add_transfer" widget="boolean_toggle"/>
                            <field name="add_location_hotel" widget="boolean_toggle"/>
                        </group>
                        <group string="Ek Paketler">
                            <field name="add_technical" widget="boolean_toggle"/>
                            <field name="add_meal" widget="boolean_toggle"/>
                            <field name="add_tour" widget="boolean_toggle"/>
                            <field name="add_custom" widget="boolean_toggle"/>
                        </group>
                    </group>

                    <div class="alert alert-info mt-3" role="alert">
                        <i class="fa fa-info-circle me-2"/>
                        <strong>Bilgi:</strong> Seçtiğiniz her paket tipi için otomatik olarak
                        yeni bir alt senaryo oluşturulacaktır. Daha sonra her senaryonun
                        detaylarını düzenleyebilirsiniz.
                    </div>
                </sheet>

                <footer>
                    <button name="action_add_packages"
                            string="Paketleri Ekle"
                            type="object"
                            class="btn-primary"
                            data-hotkey="q"/>
                    <button string="İptal"
                            class="btn-secondary"
                            special="cancel"
                            data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
