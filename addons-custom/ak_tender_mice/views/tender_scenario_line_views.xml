<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- ak.tender.scenario.line — LIST VIEW                          -->
    <!-- ============================================================ -->
    <record id="view_tender_scenario_line_list" model="ir.ui.view">
        <field name="name">ak.tender.scenario.line.list</field>
        <field name="model">ak.tender.scenario.line</field>
        <field name="arch" type="xml">
            <list string="Senaryo Kalemleri" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="line_type"/>
                <field name="name"/>
                <field name="product_id" optional="hide"/>
                <field name="quantity"/>
                <field name="uom_id" groups="uom.group_uom"/>
                <field name="days"/>
                <field name="mice_room_type" optional="show" column_invisible="parent.line_type != 'accommodation'"/>
                <field name="mice_view_type" optional="hide" column_invisible="parent.line_type != 'accommodation'"/>
                <field name="mice_meal_plan" optional="show"/>
                <field name="transfer_type" optional="show" column_invisible="parent.line_type != 'transfer'"/>
                <field name="vehicle_type" optional="hide" column_invisible="parent.line_type != 'transfer'"/>
                <field name="meal_type" optional="show" column_invisible="parent.line_type != 'meal'"/>
                <field name="menu_type" optional="hide" column_invisible="parent.line_type != 'meal'"/>
                <field name="technical_service_type" optional="show" column_invisible="parent.line_type != 'technical'"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="target_price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="computed_target_total" 
                       widget="monetary" 
                       options="{'currency_field': 'currency_id'}"
                       sum="Toplam"/>
                <field name="line_summary" optional="show"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- ak.tender.scenario.line — FORM VIEW                          -->
    <!-- ============================================================ -->
    <record id="view_tender_scenario_line_form" model="ir.ui.view">
        <field name="name">ak.tender.scenario.line.form</field>
        <field name="model">ak.tender.scenario.line</field>
        <field name="arch" type="xml">
            <form string="Senaryo Kalemi">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" 
                                type="object"
                                class="oe_stat_button" 
                                icon="fa-archive">
                            <field name="active" widget="boolean_button" options="{'terminology': 'archive'}"/>
                        </button>
                    </div>
                    
                    <group>
                        <group name="main_info">
                            <field name="scenario_id" readonly="1"/>
                            <field name="line_type"/>
                            <field name="name"/>
                            <field name="product_id"/>
                            <field name="sequence"/>
                        </group>
                        <group name="quantity_info">
                            <field name="quantity"/>
                            <field name="uom_id" groups="uom.group_uom"/>
                            <field name="days"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="target_price" widget="monetary"/>
                            <field name="computed_target_total" widget="monetary"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- KONAKLAMA DETAYLARI -->
                        <page string="Konaklama Detayları" 
                              name="accommodation_details"
                              invisible="line_type != 'accommodation'">
                            <group>
                                <group>
                                    <field name="mice_room_type"/>
                                    <field name="mice_view_type"/>
                                    <field name="mice_meal_plan"/>
                                </group>
                                <group>
                                    <field name="mice_amenities" placeholder="WiFi, Havuz, Spa, Butler, Minibar"/>
                                </group>
                            </group>
                            <group>
                                <field name="mice_special_requests" placeholder="Özel talepler ve notlar..."/>
                            </group>
                        </page>

                        <!-- TRANSFER DETAYLARI -->
                        <page string="Transfer Detayları" 
                              name="transfer_details"
                              invisible="line_type != 'transfer'">
                            <group>
                                <group>
                                    <field name="transfer_type"/>
                                    <field name="vehicle_type"/>
                                </group>
                            </group>
                        </page>

                        <!-- YEMEK DETAYLARI -->
                        <page string="Yemek Detayları" 
                              name="meal_details"
                              invisible="line_type != 'meal'">
                            <group>
                                <group>
                                    <field name="meal_type"/>
                                    <field name="menu_type"/>
                                </group>
                            </group>
                        </page>

                        <!-- TEKNİK HİZMET DETAYLARI -->
                        <page string="Teknik Hizmet Detayları" 
                              name="technical_details"
                              invisible="line_type != 'technical'">
                            <group>
                                <field name="technical_service_type"/>
                            </group>
                        </page>

                        <!-- NOTLAR -->
                        <page string="Notlar" name="notes">
                            <field name="notes" placeholder="Ek notlar ve açıklamalar..."/>
                        </page>

                        <!-- ÖZET -->
                        <page string="Özet" name="summary">
                            <group>
                                <field name="line_summary" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- ak.tender.scenario.line — SEARCH VIEW                        -->
    <!-- ============================================================ -->
    <record id="view_tender_scenario_line_search" model="ir.ui.view">
        <field name="name">ak.tender.scenario.line.search</field>
        <field name="model">ak.tender.scenario.line</field>
        <field name="arch" type="xml">
            <search string="Senaryo Kalemleri Ara">
                <field name="name" string="Açıklama" filter_domain="[('name', 'ilike', self)]"/>
                <field name="scenario_id"/>
                <field name="product_id"/>
                <field name="line_type"/>
                
                <filter string="Konaklama" name="filter_accommodation" domain="[('line_type', '=', 'accommodation')]"/>
                <filter string="Yemek" name="filter_meal" domain="[('line_type', '=', 'meal')]"/>
                <filter string="Transfer" name="filter_transfer" domain="[('line_type', '=', 'transfer')]"/>
                <filter string="Teknik" name="filter_technical" domain="[('line_type', '=', 'technical')]"/>
                <filter string="Uçuş" name="filter_flight" domain="[('line_type', '=', 'flight')]"/>
                
                <separator/>
                <filter string="Aktif" name="filter_active" domain="[('active', '=', True)]"/>
                <filter string="Arşiv" name="filter_inactive" domain="[('active', '=', False)]"/>
                
                <group expand="0" string="Grupla">
                    <filter string="Senaryo" name="group_scenario" context="{'group_by': 'scenario_id'}"/>
                    <filter string="Satır Tipi" name="group_line_type" context="{'group_by': 'line_type'}"/>
                    <filter string="Oda Tipi" name="group_room_type" context="{'group_by': 'mice_room_type'}"/>
                    <filter string="Pansiyon" name="group_meal_plan" context="{'group_by': 'mice_meal_plan'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- ak.tender.scenario.line — KANBAN VIEW                        -->
    <!-- ============================================================ -->
    <record id="view_tender_scenario_line_kanban" model="ir.ui.view">
        <field name="name">ak.tender.scenario.line.kanban</field>
        <field name="model">ak.tender.scenario.line</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="line_type"/>
                <field name="quantity"/>
                <field name="days"/>
                <field name="computed_target_total"/>
                <field name="currency_id"/>
                <field name="line_summary"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="row">
                                <div class="col-12">
                                    <strong><field name="name"/></strong>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-6">
                                    <span class="badge badge-pill">
                                        <field name="line_type"/>
                                    </span>
                                </div>
                                <div class="col-6 text-end">
                                    <field name="computed_target_total" widget="monetary"/>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12">
                                    <small><field name="line_summary"/></small>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-6">
                                    <i class="fa fa-users"/> <field name="quantity"/> × <field name="days"/> gün
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- ak.tender.scenario.line — ACTION                             -->
    <!-- ============================================================ -->
    <record id="action_tender_scenario_line" model="ir.actions.act_window">
        <field name="name">Senaryo Kalemleri</field>
        <field name="res_model">ak.tender.scenario.line</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Yeni Senaryo Kalemi Oluştur
            </p>
            <p>
                Senaryo kalemleri, ihale senaryolarınız için planlama aşamasında kullanılan kalemlerdir.
                Konaklama, yemek, transfer, teknik hizmet gibi farklı kategorilerde kalemler oluşturabilirsiniz.
            </p>
        </field>
    </record>

</odoo>
