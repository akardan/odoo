<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- ak.tender.scenario — LIST VIEW                               -->
    <!-- ============================================================ -->
    <record id="view_tender_scenario_list" model="ir.ui.view">
        <field name="name">ak.tender.scenario.list</field>
        <field name="model">ak.tender.scenario</field>
        <field name="arch" type="xml">
            <list string="İhale Senaryoları"
                  decoration-success="scenario_status == 'awarded'"
                  decoration-info="scenario_status == 'shortlisted'"
                  decoration-muted="scenario_status == 'eliminated'">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="scenario_type"/>
                <field name="parent_id" optional="show"/>
                <field name="level" optional="hide"/>
                <field name="location_id"/>
                <field name="hotel_partner_id"/>
                <field name="meal_plan"/>
                <field name="person_count"/>
                <field name="date_option_count" string="Tarihler"/>
                <field name="line_count" string="Kalemler"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="total_target_price"
                       widget="monetary"
                       options="{'currency_field': 'currency_id'}"/>
                <field name="best_npv_offer"
                       widget="monetary"
                       options="{'currency_field': 'currency_id'}"/>
                <field name="best_npv_partner_id"/>
                <field name="scenario_status"
                       widget="badge"
                       decoration-success="scenario_status == 'awarded'"
                       decoration-info="scenario_status == 'shortlisted'"
                       decoration-warning="scenario_status == 'active'"
                       decoration-danger="scenario_status == 'eliminated'"/>
                <field name="is_mandatory" widget="boolean_toggle"/>
                <field name="is_shortlisted" column_invisible="1"/>
                <button name="action_add_to_shortlist"
                        string="Kısa Liste"
                        type="object"
                        icon="fa-star"
                        invisible="is_shortlisted or scenario_status == 'eliminated'"/>
                <button name="action_eliminate_scenario"
                        string="Ele"
                        type="object"
                        icon="fa-times"
                        invisible="scenario_status in ['eliminated', 'awarded']"/>
                <button name="action_view_comparison"
                        string="Karşılaştır"
                        type="object"
                        icon="fa-bar-chart"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- ak.tender.scenario — FORM VIEW                               -->
    <!-- ============================================================ -->
    <record id="view_tender_scenario_form" model="ir.ui.view">
        <field name="name">ak.tender.scenario.form</field>
        <field name="model">ak.tender.scenario</field>
        <field name="arch" type="xml">
            <form string="İhale Senaryosu">
                <header>
                    <button name="action_add_to_shortlist"
                            string="Kısa Listeye Ekle"
                            type="object"
                            class="oe_highlight"
                            invisible="is_shortlisted or scenario_status == 'eliminated'"/>
                    <button name="action_remove_from_shortlist"
                            string="Kısa Listeden Çıkar"
                            type="object"
                            class="btn-warning"
                            invisible="not is_shortlisted"/>
                    <button name="action_eliminate_scenario"
                            string="Senaroyu ele"
                            type="object"
                            class="btn-danger"
                            invisible="scenario_status in ['eliminated', 'awarded']"/>
                    <button name="action_award"
                            string="Kazanan Seç"
                            type="object"
                            class="btn-success"
                            invisible="scenario_status == 'awarded'"/>
                    <button name="action_view_comparison"
                            string="Teklif Karşılaştır"
                            type="object"
                            class="btn-primary"/>
                    <button name="action_add_child_scenario"
                            string="Alt Senaryo Ekle"
                            type="object"
                            class="btn-secondary"
                            invisible="scenario_type != 'region'"/>
                    <field name="scenario_status"
                           widget="statusbar"
                           statusbar_visible="active,shortlisted,awarded"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_lines"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-list"
                                invisible="scenario_type == 'region'">
                            <field name="line_count" widget="statinfo" string="Kalemler"/>
                        </button>
                        <button name="action_view_children"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-sitemap"
                                invisible="scenario_type != 'region'">
                            <field name="child_count" widget="statinfo" string="Oteller"/>
                        </button>
                        <button name="action_view_comparison"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-balance-scale"
                                invisible="scenario_type == 'region'">
                            <span class="o_stat_text">Teklifler</span>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Senaryo adı... (Örn: Titanic Beach 5★ — HB)"/>
                        </h1>
                    </div>

                    <group>
                        <group name="basic_info" string="Temel Bilgiler">
                            <field name="tender_id" readonly="1"/>
                            <field name="parent_id"
                                   options="{'no_create': True}"
                                   invisible="scenario_type == 'region'"/>
                            <field name="scenario_type"/>
                            <field name="sequence"/>
                            <field name="is_mandatory"/>
                            <field name="scenario_source"/>
                            <field name="supplier_id"
                                   invisible="scenario_source != 'supplier_counter'"/>
                        </group>
                        <group name="location_info" string="Lokasyon ve Otel">
                            <field name="location_id"/>
                            <field name="country_id" readonly="1"/>
                            <field name="hotel_partner_id"
                                   options="{'no_create': True}"
                                   invisible="scenario_type == 'region'"/>
                            <field name="meal_plan"
                                   invisible="scenario_type == 'region'"/>
                            <field name="person_count"
                                   invisible="scenario_type == 'region'"/>
                            <field name="vip_count"
                                   invisible="scenario_type == 'region'"/>
                        </group>
                    </group>

                    <notebook>

                        <!-- Alt Senaryolar (Bölge tipinde) -->
                        <page string="Oteller / Alt Senaryolar"
                              name="children"
                              invisible="scenario_type != 'region'">
                            <field name="child_ids">
                                <list decoration-success="scenario_status == 'awarded'"
                                      decoration-info="scenario_status == 'shortlisted'"
                                      decoration-muted="scenario_status == 'eliminated'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="hotel_partner_id"/>
                                    <field name="meal_plan"/>
                                    <field name="date_option_count" string="Tarihler"/>
                                    <field name="line_count" string="Kalemler"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="total_target_price"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                    <field name="best_npv_offer"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                    <field name="best_npv_partner_id"/>
                                    <field name="scenario_status" widget="badge"/>
                                    <field name="is_shortlisted" widget="boolean_toggle"/>
                                </list>
                            </field>
                            <div class="oe_right mt-2">
                                <button name="action_add_child_scenario"
                                        string="Otel Ekle"
                                        type="object"
                                        class="btn btn-primary"/>
                            </div>
                        </page>

                        <!-- Tarih Seçenekleri (Otel tipinde) -->
                        <page string="Tarih Seçenekleri"
                              name="dates"
                              invisible="scenario_type == 'region'">
                            <field name="date_option_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="days" readonly="1"/>
                                    <field name="season_type"/>
                                    <field name="cost_multiplier"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="estimated_total_cost"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                    <field name="is_preferred" widget="boolean_toggle"/>
                                    <field name="offer_count" readonly="1"/>
                                    <field name="best_offer_amount"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           readonly="1"/>
                                    <field name="best_offer_partner_id" readonly="1"/>
                                    <button name="action_view_offers"
                                            string="Teklifler"
                                            type="object"
                                            icon="fa-eye"/>
                                </list>
                            </field>
                        </page>

                        <!-- Kalemler -->
                        <page string="İhale Kalemleri"
                              name="lines"
                              invisible="scenario_type == 'region'">
                            <field name="line_ids">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="line_type"/>
                                    <field name="quantity"/>
                                    <field name="days"/>
                                    <field name="uom_id"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="target_price"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                    <field name="computed_target_total"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           sum="Toplam"/>
                                </list>
                            </field>
                        </page>

                        <!-- Fiyatlandırma ve Teklifler -->
                        <page string="Fiyatlandırma ve Teklifler"
                              name="pricing"
                              invisible="scenario_type == 'region'">
                            <group>
                                <group string="Hedef Fiyatlar">
                                    <field name="currency_id" invisible="1"/>
                                    <field name="total_target_price"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                </group>
                                <group string="En İyi Teklifler (Tur Bazlı)">
                                    <field name="best_offer_round_1"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                    <field name="best_offer_round_2"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                    <field name="improvement_percentage"
                                           widget="percentage"/>
                                </group>
                            </group>
                            <group>
                                <group string="NPV Bazlı En İyi Teklif">
                                    <field name="best_npv_offer"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                    <field name="best_npv_partner_id"/>
                                </group>
                            </group>
                        </page>

                        <!-- Kısa Liste Bilgileri -->
                        <page string="Kısa Liste"
                              name="shortlist"
                              invisible="not is_shortlisted and scenario_status != 'shortlisted'">
                            <group>
                                <field name="is_shortlisted"/>
                                <field name="shortlist_round" readonly="1"/>
                                <field name="shortlist_date" readonly="1"/>
                                <field name="shortlist_by" readonly="1"/>
                                <field name="shortlist_notes"/>
                            </group>
                        </page>

                        <!-- Eleme Bilgileri -->
                        <page string="Eleme Bilgileri"
                              name="elimination"
                              invisible="scenario_status != 'eliminated'">
                            <group>
                                <field name="elimination_reason"/>
                            </group>
                        </page>

                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- ak.tender.scenario — KANBAN VIEW                             -->
    <!-- ============================================================ -->
    <record id="view_tender_scenario_kanban" model="ir.ui.view">
        <field name="name">ak.tender.scenario.kanban</field>
        <field name="model">ak.tender.scenario</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile"
                    default_group_by="scenario_status">
                <field name="name"/>
                <field name="scenario_type"/>
                <field name="parent_id"/>
                <field name="hotel_partner_id"/>
                <field name="location_id"/>
                <field name="total_target_price"/>
                <field name="best_npv_offer"/>
                <field name="best_npv_partner_id"/>
                <field name="scenario_status"/>
                <field name="is_mandatory"/>
                <field name="line_count"/>
                <field name="date_option_count"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <div class="o_kanban_record_subtitle text-muted">
                                        <field name="scenario_type"/>
                                        <t t-if="record.parent_id.raw_value">
                                            ← <field name="parent_id"/>
                                        </t>
                                        <t t-if="record.is_mandatory.raw_value">
                                            <span class="badge text-bg-warning ms-1">Zorunlu</span>
                                        </t>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <t t-if="record.hotel_partner_id.raw_value">
                                    <i class="fa fa-building me-1"/>
                                    <field name="hotel_partner_id"/>
                                </t>
                                <t t-if="record.location_id.raw_value">
                                    <br/>
                                    <i class="fa fa-map-marker me-1"/>
                                    <field name="location_id"/>
                                </t>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <span class="badge text-bg-secondary">
                                        <i class="fa fa-list me-1"/>
                                        <field name="line_count"/> kalem
                                    </span>
                                    <span class="badge text-bg-secondary ms-1">
                                        <i class="fa fa-calendar me-1"/>
                                        <field name="date_option_count"/> tarih
                                    </span>
                                </div>
                                <div class="oe_kanban_bottom_right text-end">
                                    <strong>
                                        <field name="best_npv_offer"
                                               widget="monetary"
                                               options="{'currency_field': 'currency_id'}"/>
                                    </strong>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- ak.tender.scenario — SEARCH VIEW                             -->
    <!-- ============================================================ -->
    <record id="view_tender_scenario_search" model="ir.ui.view">
        <field name="name">ak.tender.scenario.search</field>
        <field name="model">ak.tender.scenario</field>
        <field name="arch" type="xml">
            <search string="Senaryo Ara">
                <field name="name"/>
                <field name="tender_id"/>
                <field name="hotel_partner_id"/>
                <field name="location_id"/>
                <separator/>
                <filter string="Aktif" name="active"
                        domain="[('scenario_status', '=', 'active')]"/>
                <filter string="Kısa Listede" name="shortlisted"
                        domain="[('is_shortlisted', '=', True)]"/>
                <filter string="Kazananlar" name="awarded"
                        domain="[('scenario_status', '=', 'awarded')]"/>
                <filter string="Elenenler" name="eliminated"
                        domain="[('scenario_status', '=', 'eliminated')]"/>
                <separator/>
                <filter string="Zorunlu Senaryolar" name="mandatory"
                        domain="[('is_mandatory', '=', True)]"/>
                <filter string="Bölge Senaryoları" name="region"
                        domain="[('scenario_type', '=', 'region')]"/>
                <filter string="Otel Senaryoları" name="hotel"
                        domain="[('scenario_type', '=', 'location_hotel')]"/>
                <separator/>
                <group string="Grupla">
                    <filter string="İhaleye Göre" name="group_tender"
                            context="{'group_by': 'tender_id'}"/>
                    <filter string="Duruma Göre" name="group_status"
                            context="{'group_by': 'scenario_status'}"/>
                    <filter string="Lokasyona Göre" name="group_location"
                            context="{'group_by': 'location_id'}"/>
                    <filter string="Üst Senaryoya Göre" name="group_parent"
                            context="{'group_by': 'parent_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- ak.tender.scenario — ACTION                                  -->
    <!-- ============================================================ -->
    <record id="action_tender_scenario" model="ir.actions.act_window">
        <field name="name">MICE Senaryoları</field>
        <field name="res_model">ak.tender.scenario</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="search_view_id" ref="view_tender_scenario_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Yeni bir MICE senaryosu oluşturun
            </p>
            <p>
                MICE ihaleleri için bölge, otel ve tarih kombinasyonlarını
                senaryo olarak tanımlayın.
            </p>
        </field>
    </record>

</odoo>
