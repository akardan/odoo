<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- ak.tender.scenario — LIST VIEW                               -->
    <!-- ============================================================ -->
    <record id="view_tender_scenario_list" model="ir.ui.view">
        <field name="name">ak.tender.scenario.list</field>
        <field name="model">ak.tender.scenario</field>
        <field name="arch" type="xml">
            <list string="İhale Senaryoları"
                  decoration-success="scenario_status == 'awarded'"
                  decoration-info="scenario_status == 'shortlisted'"
                  decoration-muted="scenario_status == 'eliminated'">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="scenario_type_id"/>
                <field name="type_is_root" column_invisible="1"/>
                <field name="type_can_have_children" column_invisible="1"/>
                <field name="parent_id" optional="show"/>
                <field name="level" optional="hide"/>
                <field name="location_id"/>
                <field name="hotel_partner_id"/>
                <field name="meal_plan"/>
                <field name="person_count"/>
                <field name="date_option_count" string="Tarihler"/>
                <field name="line_count" string="Kalemler"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="total_target_price"
                       widget="monetary"
                       options="{'currency_field': 'currency_id'}"/>
                <field name="best_npv_offer"
                       widget="monetary"
                       options="{'currency_field': 'currency_id'}"/>
                <field name="best_npv_partner_id"/>
                <field name="scenario_status"
                       widget="badge"
                       decoration-success="scenario_status == 'awarded'"
                       decoration-info="scenario_status == 'shortlisted'"
                       decoration-warning="scenario_status == 'active'"
                       decoration-danger="scenario_status == 'eliminated'"/>
                <field name="is_mandatory" widget="boolean_toggle"/>
                <field name="is_shortlisted" column_invisible="1"/>
                <button name="action_add_to_shortlist"
                        string="Kısa Liste"
                        type="object"
                        icon="fa-star"
                        invisible="is_shortlisted or scenario_status == 'eliminated'"/>
                <button name="action_eliminate_scenario"
                        string="Ele"
                        type="object"
                        icon="fa-times"
                        invisible="scenario_status in ['eliminated', 'awarded']"/>
                <button name="action_view_comparison"
                        string="Karşılaştır"
                        type="object"
                        icon="fa-bar-chart"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- ak.tender.scenario — FORM VIEW                               -->
    <!-- ============================================================ -->
    <record id="view_tender_scenario_form" model="ir.ui.view">
        <field name="name">ak.tender.scenario.form</field>
        <field name="model">ak.tender.scenario</field>
        <field name="arch" type="xml">
            <form string="İhale Senaryosu">
                <header>
                    <button name="action_add_to_shortlist"
                            string="Kısa Listeye Ekle"
                            type="object"
                            class="oe_highlight"
                            invisible="is_shortlisted or scenario_status == 'eliminated'"/>
                    <button name="action_remove_from_shortlist"
                            string="Kısa Listeden Çıkar"
                            type="object"
                            class="btn-warning"
                            invisible="not is_shortlisted"/>
                    <button name="action_eliminate_scenario"
                            string="Senaroyu ele"
                            type="object"
                            class="btn-danger"
                            invisible="scenario_status in ['eliminated', 'awarded']"/>
                    <button name="action_award"
                            string="Kazanan Seç"
                            type="object"
                            class="btn-success"
                            invisible="scenario_status == 'awarded'"/>
                    <button name="action_view_comparison"
                            string="Teklif Karşılaştır"
                            type="object"
                            class="btn-primary"/>
                    <button name="action_add_child_scenario"
                            string="Alt Senaryo Ekle"
                            type="object"
                            class="btn-secondary"
                            invisible="not type_can_have_children"/>
                    <button name="action_copy_scenario"
                            string="Kopyala"
                            type="object"
                            class="btn-secondary"
                            icon="fa-copy"/>
                    <field name="scenario_status"
                           widget="statusbar"
                           statusbar_visible="active,shortlisted,awarded"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_scenario_lines"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-tasks"
                                invisible="type_is_root">
                            <field name="scenario_line_count" widget="statinfo" string="Senaryo Kalemleri"/>
                        </button>
                        <button name="action_view_lines"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-list"
                                invisible="type_is_root">
                            <field name="line_count" widget="statinfo" string="İhale Kalemleri"/>
                        </button>
                        <button name="action_view_children"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-sitemap"
                                invisible="not type_can_have_children">
                            <field name="child_count" widget="statinfo" string="Paketler"/>
                        </button>
                        <button name="action_view_comparison"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-balance-scale"
                                invisible="type_is_root">
                            <span class="o_stat_text">Teklifler</span>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Senaryo adı... (Örn: Titanic Beach 5★ — HB)"/>
                        </h1>
                    </div>

                    <group>
                        <group name="basic_info" string="Temel Bilgiler">
                            <field name="type_is_root" invisible="1"/>
                            <field name="type_can_have_children" invisible="1"/>
                            <field name="tender_id" readonly="1"/>
                            <field name="parent_id"
                                   options="{'no_create': True}"
                                   invisible="type_is_root"/>
                            <field name="scenario_type_id" options="{'no_create': True}"/>
                            <field name="sequence"/>
                            <field name="is_mandatory"/>
                            <field name="scenario_source"/>
                            <field name="supplier_id"
                                   invisible="scenario_source != 'supplier_counter'"/>
                        </group>
                        <group name="location_info" string="Lokasyon ve Otel">
                            <field name="location_id"/>
                            <field name="country_id" readonly="1"/>
                            <field name="hotel_partner_id"
                                   options="{'no_create': True}"
                                   invisible="type_is_root"/>
                            <field name="meal_plan"
                                   invisible="type_is_root"/>
                            <field name="person_count"
                                   invisible="type_is_root"/>
                            <field name="vip_count"
                                   invisible="type_is_root"/>
                        </group>
                    </group>

                    <notebook>

                        <!-- Alt Senaryolar (Bölge ve Otel tipinde) -->
                        <page string="Paketler / Alt Senaryolar"
                              name="children"
                              invisible="not type_can_have_children">
                            <field name="child_ids">
                                <list decoration-success="scenario_status == 'awarded'"
                                      decoration-info="scenario_status == 'shortlisted'"
                                      decoration-muted="scenario_status == 'eliminated'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="hotel_partner_id"/>
                                    <field name="meal_plan"/>
                                    <field name="date_option_count" string="Tarihler"/>
                                    <field name="line_count" string="Kalemler"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="total_target_price"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                    <field name="best_npv_offer"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                    <field name="best_npv_partner_id"/>
                                    <field name="scenario_status" widget="badge"/>
                                    <field name="is_shortlisted" widget="boolean_toggle"/>
                                </list>
                            </field>
                            <div class="oe_right mt-2">
                                <button name="action_add_packages"
                                        string="Paket Ekle"
                                        type="object"
                                        class="btn btn-primary"/>
                                <button name="action_add_child_scenario"
                                        string="Tekil Senaryo Ekle"
                                        type="object"
                                        class="btn btn-secondary ms-2"/>
                            </div>
                        </page>

                        <!-- Tarih Seçenekleri (Otel tipinde) -->
                        <page string="Tarih Seçenekleri"
                              name="dates"
                              invisible="type_is_root">
                            <field name="date_option_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="days" readonly="1"/>
                                    <field name="season_type"/>
                                    <field name="cost_multiplier"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="estimated_total_cost"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                    <field name="is_preferred" widget="boolean_toggle"/>
                                    <field name="offer_count" readonly="1"/>
                                    <field name="best_offer_amount"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           readonly="1"/>
                                    <field name="best_offer_partner_id" readonly="1"/>
                                    <button name="action_view_offers"
                                            string="Teklifler"
                                            type="object"
                                            icon="fa-eye"/>
                                </list>
                            </field>
                        </page>

                        <!-- Senaryo Kalemleri (Planlama) -->
                        <page string="Senaryo Kalemleri"
                              name="scenario_lines"
                              invisible="type_is_root">

                            <p class="text-muted mb-2">
                                <i class="fa fa-info-circle me-1"/>
                                <b>Senaryo Kalemleri</b> planlama aşamasında kullanılır.
                                Farklı senaryo alternatifleri için özel kalemler oluşturabilirsiniz.
                            </p>

                            <field name="scenario_line_ids"
                                   context="{
                                       'default_scenario_id': id
                                   }">
                                <list editable="bottom"
                                      decoration-info="line_type == 'accommodation'"
                                      decoration-warning="line_type == 'flight'">
                                    <field name="sequence" widget="handle"/>

                                    <!-- Satır tipi — her zaman görünür, ilk sütun -->
                                    <field name="line_type" required="1"/>

                                    <!-- Konaklama alanları -->
                                    <field name="mice_room_type"
                                           optional="show"
                                           invisible="line_type not in ('accommodation', 'package')"/>
                                    <field name="mice_meal_plan"
                                           optional="show"
                                           invisible="line_type not in ('accommodation', 'meal', 'package')"/>
                                    <field name="mice_view_type"
                                           optional="hide"
                                           invisible="line_type not in ('accommodation', 'package')"/>

                                    <!-- Transfer alanları -->
                                    <field name="transfer_type"
                                           optional="show"
                                           invisible="line_type != 'transfer'"/>
                                    <field name="vehicle_type"
                                           optional="hide"
                                           invisible="line_type != 'transfer'"/>

                                    <!-- Yemek/F&B alanları -->
                                    <field name="meal_type"
                                           optional="show"
                                           invisible="line_type != 'meal'"/>
                                    <field name="menu_type"
                                           optional="hide"
                                           invisible="line_type != 'meal'"/>

                                    <!-- Teknik hizmet alanları -->
                                    <field name="technical_service_type"
                                           optional="show"
                                           invisible="line_type != 'technical'"/>

                                    <!-- Açıklama ve genel alanlar -->
                                    <field name="name"/>
                                    <field name="product_id" optional="hide"/>
                                    <field name="quantity"/>
                                    <field name="days"/>
                                    <field name="uom_id" optional="show" groups="uom.group_uom"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="target_price"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                    <field name="computed_target_total"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           sum="Toplam"/>
                                    <field name="line_summary" optional="show"/>
                                </list>
                            </field>
                        </page>

                        <!-- İhale Kalemleri -->
                        <page string="İhale Kalemleri"
                              name="lines"
                              invisible="True">

                            <p class="text-muted mb-2">
                                <i class="fa fa-info-circle me-1"/>
                                <b>İhale Kalemleri</b> tedarikçilere gönderilir.
                                Her kalem için önce <b>Hizmet Tipi</b> seçin, ardından
                                oda tipi / pansiyon / miktar / gün / hedef fiyat girin.
                                Tedarikçiler <b>Tarih Seçenekleri</b> sekmesindeki her
                                tarih için ayrı fiyat verebilecek.
                            </p>

                            <field name="line_ids"
                                   context="{
                                       'default_scenario_id': id,
                                       'default_tender_id': tender_id,
                                       'default_tender_type': 'mice',
                                       'form_view_ref': 'ak_tender_mice.view_tender_line_mice_form'
                                   }">
                                <list editable="bottom"
                                      decoration-info="line_type == 'accommodation'"
                                      decoration-warning="line_type == 'flight'">
                                    <field name="tender_id" column_invisible="1"/>
                                    <field name="scenario_id" column_invisible="1"/>
                                    <field name="sequence" widget="handle"/>

                                    <!-- Hizmet kategorisi — en önemli sütun -->
                                    <field name="line_type" required="1"/>

                                    <!-- Konaklama özel alanları — varsayılan görünür -->
                                    <field name="mice_room_type"
                                           optional="show"
                                           invisible="line_type not in ('accommodation', 'package')"/>
                                    <field name="mice_meal_plan"
                                           optional="show"
                                           invisible="line_type not in ('accommodation', 'meal', 'package')"/>

                                    <!-- Miktar ve süre -->
                                    <field name="quantity"/>
                                    <field name="days"/>
                                    <field name="uom_id" optional="show"/>

                                    <!-- Açıklama — isteğe bağlı -->
                                    <field name="name" optional="show"/>

                                    <!-- Ürün bağlantısı — MICE'da genellikle gerekmez -->
                                    <field name="product_id" optional="hide"/>

                                    <!-- Fiyatlandırma -->
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="target_price"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           string="Hedef Birim Fiyat"/>
                                    <field name="computed_target_total"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           readonly="1"
                                           sum="Toplam Hedef"/>
                                </list>
                            </field>

                            <!-- Özet -->
                            <group class="mt-2">
                                <group>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="total_target_price"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           readonly="1"
                                           string="Toplam Hedef Fiyat"/>
                                </group>
                            </group>
                        </page>

                        <!-- Fiyatlandırma ve Teklifler -->
                        <page string="Fiyatlandırma ve Teklifler"
                              name="pricing"
                              invisible="type_is_root">
                            <group>
                                <group string="Hedef Fiyatlar">
                                    <field name="currency_id" invisible="1"/>
                                    <field name="total_target_price"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                </group>
                                <group string="En İyi Teklifler (Tur Bazlı)">
                                    <field name="best_offer_round_1"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                    <field name="best_offer_round_2"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                    <field name="improvement_percentage"
                                           widget="percentage"/>
                                </group>
                            </group>
                            <group>
                                <group string="NPV Bazlı En İyi Teklif">
                                    <field name="best_npv_offer"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                    <field name="best_npv_partner_id"/>
                                </group>
                            </group>
                        </page>

                        <!-- Kısa Liste Bilgileri -->
                        <page string="Kısa Liste"
                              name="shortlist"
                              invisible="not is_shortlisted and scenario_status != 'shortlisted'">
                            <group>
                                <field name="is_shortlisted"/>
                                <field name="shortlist_round" readonly="1"/>
                                <field name="shortlist_date" readonly="1"/>
                                <field name="shortlist_by" readonly="1"/>
                                <field name="shortlist_notes"/>
                            </group>
                        </page>

                        <!-- Eleme Bilgileri -->
                        <page string="Eleme Bilgileri"
                              name="elimination"
                              invisible="scenario_status != 'eliminated'">
                            <group>
                                <field name="elimination_reason"/>
                            </group>
                        </page>

                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- ak.tender.scenario — KANBAN VIEW                             -->
    <!-- ============================================================ -->
    <record id="view_tender_scenario_kanban" model="ir.ui.view">
        <field name="name">ak.tender.scenario.kanban</field>
        <field name="model">ak.tender.scenario</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile"
                    default_group_by="scenario_status"
                    records_draggable="false">
                <field name="name"/>
                <field name="scenario_type_id"/>
                <field name="parent_id"/>
                <field name="hotel_partner_id"/>
                <field name="location_id"/>
                <field name="meal_plan"/>
                <field name="person_count"/>
                <field name="vip_count"/>
                <field name="total_target_price"/>
                <field name="best_npv_offer"/>
                <field name="best_npv_partner_id"/>
                <field name="scenario_status"/>
                <field name="is_mandatory"/>
                <field name="line_count"/>
                <field name="scenario_line_count"/>
                <field name="date_option_count"/>
                <field name="child_count"/>
                <field name="currency_id"/>
                <field name="kanban_date_summary"/>
                <field name="kanban_line_summary"/>
                <field name="kanban_child_summary"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click mb-3 shadow-sm" style="min-width: 500px; min-height: 350px; border: 1px solid #dee2e6; border-radius: 8px; background: white; padding: 16px;">
                            <!-- Başlık Bölümü -->
                            <div class="o_kanban_record_top mb-3 pb-2 border-bottom">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title" style="font-size: 1.15em;">
                                        <field name="name"/>
                                    </strong>
                                    <div class="o_kanban_record_subtitle text-muted mt-1">
                                        <span class="badge text-bg-info me-1">
                                            <field name="scenario_type_id"/>
                                        </span>
                                        <t t-if="record.parent_id.raw_value">
                                            <span class="badge text-bg-secondary me-1">
                                                ← <field name="parent_id"/>
                                            </span>
                                        </t>
                                        <t t-if="record.is_mandatory.raw_value">
                                            <span class="badge text-bg-warning">Zorunlu</span>
                                        </t>
                                    </div>
                                </div>
                            </div>

                            <!-- Ana Bilgiler -->
                            <div class="o_kanban_record_body mb-3">
                                <div class="row g-2 mb-3">
                                    <t t-if="record.hotel_partner_id.raw_value">
                                        <div class="col-12">
                                            <i class="fa fa-building text-primary me-1"/>
                                            <strong><field name="hotel_partner_id"/></strong>
                                        </div>
                                    </t>
                                    <t t-if="record.location_id.raw_value">
                                        <div class="col-12">
                                            <i class="fa fa-map-marker text-danger me-1"/>
                                            <field name="location_id"/>
                                        </div>
                                    </t>
                                    <t t-if="record.meal_plan.raw_value">
                                        <div class="col-6">
                                            <i class="fa fa-cutlery text-success me-1"/>
                                            <field name="meal_plan"/>
                                        </div>
                                    </t>
                                    <t t-if="record.person_count.raw_value">
                                        <div class="col-6">
                                            <i class="fa fa-users text-info me-1"/>
                                            <field name="person_count"/> kişi
                                            <t t-if="record.vip_count.raw_value">
                                                (<field name="vip_count"/> VIP)
                                            </t>
                                        </div>
                                    </t>
                                </div>

                                <!-- Alternatif Tarihler -->
                                <t t-if="record.date_option_count.raw_value > 0">
                                    <div class="mb-3 p-2 bg-light border-start border-4 border-primary">
                                        <div class="mb-2">
                                            <strong class="text-primary">
                                                <i class="fa fa-calendar me-1"/>
                                                Alternatif Tarihler (<t t-esc="record.date_option_count.raw_value"/>)
                                            </strong>
                                        </div>
                                        <div class="ms-2">
                                            <field name="kanban_date_summary" widget="html"/>
                                        </div>
                                    </div>
                                </t>

                                <!-- Senaryo Kalemleri -->
                                <t t-if="record.scenario_line_count.raw_value > 0">
                                    <div class="mb-3 p-2 bg-light border-start border-4 border-success">
                                        <div class="mb-2">
                                            <strong class="text-success">
                                                <i class="fa fa-tasks me-1"/>
                                                Senaryo Kalemleri (<t t-esc="record.scenario_line_count.raw_value"/>)
                                            </strong>
                                        </div>
                                        <div class="ms-2">
                                            <field name="kanban_line_summary" widget="html"/>
                                        </div>
                                    </div>
                                </t>

                                <!-- Alt Senaryolar (Recursive) -->
                                <t t-if="record.child_count.raw_value > 0">
                                    <div class="mb-3 p-2 bg-light border-start border-4 border-warning">
                                        <div class="mb-2">
                                            <strong class="text-warning">
                                                <i class="fa fa-sitemap me-1"/>
                                                Alt Senaryolar (<t t-esc="record.child_count.raw_value"/>)
                                            </strong>
                                        </div>
                                        <div class="ms-2">
                                            <field name="kanban_child_summary" widget="html"/>
                                        </div>
                                    </div>
                                </t>

                                <!-- İhale Kalemleri -->
                                <t t-if="record.line_count.raw_value > 0">
                                    <div class="mb-2 p-2 bg-light border-start border-4 border-info">
                                        <div class="mb-1">
                                            <strong class="text-info">
                                                <i class="fa fa-list-alt me-1"/>
                                                İhale Kalemleri (<t t-esc="record.line_count.raw_value"/>)
                                            </strong>
                                        </div>
                                        <div class="small text-muted ms-3">
                                            Tedarikçilere gönderilecek <t t-esc="record.line_count.raw_value"/> ihale kalemi
                                        </div>
                                    </div>
                                </t>
                            </div>

                            <!-- Alt Bilgiler ve Fiyatlar -->
                            <div class="o_kanban_record_bottom mt-3 pt-3 border-top">
                                <div class="row g-2">
                                    <div class="col-6">
                                        <div class="mb-2">
                                            <small class="text-muted d-block">Hedef Fiyat:</small>
                                            <strong class="text-primary" style="font-size: 1.1em;">
                                                <field name="total_target_price"
                                                       widget="monetary"
                                                       options="{'currency_field': 'currency_id'}"/>
                                            </strong>
                                        </div>
                                    </div>
                                    <div class="col-6 text-end">
                                        <t t-if="record.best_npv_offer.raw_value">
                                            <div class="mb-2">
                                                <small class="text-muted d-block">En İyi Teklif:</small>
                                                <strong class="text-success" style="font-size: 1.1em;">
                                                    <field name="best_npv_offer"
                                                           widget="monetary"
                                                           options="{'currency_field': 'currency_id'}"/>
                                                </strong>
                                                <t t-if="record.best_npv_partner_id.raw_value">
                                                    <div class="small text-muted">
                                                        <field name="best_npv_partner_id"/>
                                                    </div>
                                                </t>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- ak.tender.scenario — SEARCH VIEW                             -->
    <!-- ============================================================ -->
    <record id="view_tender_scenario_search" model="ir.ui.view">
        <field name="name">ak.tender.scenario.search</field>
        <field name="model">ak.tender.scenario</field>
        <field name="arch" type="xml">
            <search string="Senaryo Ara">
                <field name="name"/>
                <field name="tender_id"/>
                <field name="hotel_partner_id"/>
                <field name="location_id"/>
                <separator/>
                <filter string="Aktif" name="active"
                        domain="[('scenario_status', '=', 'active')]"/>
                <filter string="Kısa Listede" name="shortlisted"
                        domain="[('is_shortlisted', '=', True)]"/>
                <filter string="Kazananlar" name="awarded"
                        domain="[('scenario_status', '=', 'awarded')]"/>
                <filter string="Elenenler" name="eliminated"
                        domain="[('scenario_status', '=', 'eliminated')]"/>
                <separator/>
                <filter string="Zorunlu Senaryolar" name="mandatory"
                        domain="[('is_mandatory', '=', True)]"/>
                <filter string="Bölge Senaryoları" name="region"
                        domain="[('scenario_type', '=', 'region')]"/>
                <filter string="Otel Senaryoları" name="hotel"
                        domain="[('scenario_type', '=', 'location_hotel')]"/>
                <separator/>
                <group string="Grupla">
                    <filter string="İhaleye Göre" name="group_tender"
                            context="{'group_by': 'tender_id'}"/>
                    <filter string="Duruma Göre" name="group_status"
                            context="{'group_by': 'scenario_status'}"/>
                    <filter string="Lokasyona Göre" name="group_location"
                            context="{'group_by': 'location_id'}"/>
                    <filter string="Üst Senaryoya Göre" name="group_parent"
                            context="{'group_by': 'parent_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- ak.tender.scenario — ACTION                                  -->
    <!-- ============================================================ -->
    <record id="action_tender_scenario" model="ir.actions.act_window">
        <field name="name">MICE Senaryoları</field>
        <field name="res_model">ak.tender.scenario</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="search_view_id" ref="view_tender_scenario_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Yeni bir MICE senaryosu oluşturun
            </p>
            <p>
                MICE ihaleleri için bölge, otel ve tarih kombinasyonlarını
                senaryo olarak tanımlayın.
            </p>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- ak.tender.scenario.type — List View                          -->
    <!-- ============================================================ -->
    <record id="view_scenario_type_list" model="ir.ui.view">
        <field name="name">ak.tender.scenario.type.list</field>
        <field name="model">ak.tender.scenario.type</field>
        <field name="arch" type="xml">
            <list string="Senaryo Tipleri">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="parent_id"/>
                <field name="can_have_children" widget="boolean_toggle"/>
                <field name="is_root" widget="boolean_toggle"/>
                <field name="is_default" widget="boolean_toggle"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- ak.tender.scenario.type — Form View                          -->
    <!-- ============================================================ -->
    <record id="view_scenario_type_form" model="ir.ui.view">
        <field name="name">ak.tender.scenario.type.form</field>
        <field name="model">ak.tender.scenario.type</field>
        <field name="arch" type="xml">
            <form string="Senaryo Tipi">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Tip adı..."/></h1>
                    </div>
                    <group>
                        <group string="Temel Bilgiler">
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="parent_id" options="{'no_create': True}"/>
                            <field name="active"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                        <group string="Davranış">
                            <field name="is_root" widget="boolean_toggle"/>
                            <field name="can_have_children" widget="boolean_toggle"/>
                            <field name="is_default" widget="boolean_toggle"/>
                            <field name="show_hotel_fields" widget="boolean_toggle"/>
                            <field name="show_pricing_fields" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group string="İzin Verilen Alt Tipler">
                        <p class="text-muted" invisible="can_have_children">
                            Bu tip alt paket alamaz (can_have_children kapalı).
                        </p>
                        <field name="allowed_child_type_ids"
                               widget="many2many_tags"
                               invisible="not can_have_children"
                               options="{'no_create': True}"/>
                        <p class="text-muted" invisible="not can_have_children or allowed_child_type_ids">
                            Boş bırakılırsa tüm aktif tipler (kök hariç) alt paket olarak eklenebilir.
                        </p>
                    </group>
                    <group string="Alt Tipler" invisible="not child_ids">
                        <field name="child_ids" nolabel="1">
                            <list>
                                <field name="name"/>
                                <field name="code"/>
                                <field name="can_have_children" widget="boolean_toggle"/>
                                <field name="is_default" widget="boolean_toggle"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- ak.tender.scenario.type — Action                             -->
    <!-- ============================================================ -->
    <record id="action_scenario_type" model="ir.actions.act_window">
        <field name="name">Senaryo Tipleri</field>
        <field name="res_model">ak.tender.scenario.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Yeni senaryo tipi oluşturun</p>
            <p>MICE senaryo tiplerini ve alt paket ilişkilerini buradan yönetin.</p>
        </field>
    </record>

</odoo>
