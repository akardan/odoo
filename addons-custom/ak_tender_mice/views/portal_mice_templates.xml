<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        MICE İhale Portal Şablonu

        ak_tender'ın 'ak_purchase_order_portal_content' şablonunu genişletir.
        MICE (tender_type='mice') ihalelerinde senaryo bazlı teklif arayüzü ekler:

        1. Her satırın ürün bilgisi altına "Tarih Seçeneği" dropdown'ı eklenir
        2. "Senaryo Bilgisi" bölümü satır üzerinde gösterilir (otel, lokasyon, pansiyon)
        3. Kaydet butonu MICE özel endpoint'i çağıran JS ile güncellenir
    -->

    <!-- ============================================================ -->
    <!-- Satır başına Tarih Seçeneği dropdown'ı ekle                  -->
    <!-- (sadece MICE ihalelerinde ve scenario_id varsa görünür)       -->
    <!-- ============================================================ -->
    <template id="portal_mice_scenario_date_field"
              inherit_id="ak_tender.ak_purchase_order_portal_content"
              name="MICE — Tarih Seçeneği Alanı">

        <!-- Ürün adı bloğunun içine, mevcut tender_line_id name div'inden sonra ekle -->
        <xpath expr="//div[hasclass('d-flex')]/following-sibling::div[contains(@class,'mt-2') and @t-if]" position="after">
            <!-- MICE ihalelerinde tarih seçeneği göster -->
            <t t-if="order.tender_id and order.tender_id.tender_type == 'mice' and line.scenario_id and line.scenario_id.date_option_ids">
                <div class="mt-2 mice-date-selection">
                    <label class="form-label fw-bold" style="font-size: 0.9em;">
                        <i class="fa fa-calendar me-1" style="color: #6c757d;"/>
                        Tarih Seçeneği
                    </label>
                    <select t-attf-name="scenario_date_id_line_{{line.id}}"
                            t-attf-id="scenario_date_{{line.id}}"
                            class="form-select form-select-sm editable-field mice-date-select"
                            style="font-size: 0.9em;">
                        <option value="">-- Tarih seçiniz --</option>
                        <t t-foreach="line.scenario_id.date_option_ids" t-as="date_opt">
                            <option t-att-value="date_opt.id"
                                    t-att-selected="date_opt.id == line.scenario_date_id.id if line.scenario_date_id else False">
                                <t t-esc="date_opt.name"/>
                                <t t-if="date_opt.season_type">
                                    (<t t-esc="dict([('low','Düşük'),('mid','Orta'),('high','Yüksek'),('peak','Pik')]).get(date_opt.season_type, date_opt.season_type)"/> Sezon)
                                </t>
                            </option>
                        </t>
                    </select>
                    <!-- Seçili tarih bilgisi -->
                    <div t-if="line.scenario_date_id" class="mt-1" style="font-size: 0.8em; color: #28a745;">
                        <i class="fa fa-check-circle me-1"/>
                        <strong>Seçilen:</strong>
                        <t t-esc="line.scenario_date_id.name"/>
                    </div>
                </div>
            </t>
            <!-- MICE ama tarih seçeneği yok — senaryoyu bilgi olarak göster -->
            <t t-elif="order.tender_id and order.tender_id.tender_type == 'mice' and line.scenario_id">
                <div class="mt-1" style="font-size: 0.8em; color: #6c757d;">
                    <i class="fa fa-map-marker me-1"/>
                    <strong>Senaryo:</strong>
                    <t t-esc="line.scenario_id.name"/>
                    <t t-if="line.scenario_id.hotel_partner_id">
                        — <t t-esc="line.scenario_id.hotel_partner_id.name"/>
                    </t>
                </div>
            </t>
        </xpath>

    </template>

    <!-- ============================================================ -->
    <!-- MICE Senaryo Özeti Bölümü — tablo öncesine ekle              -->
    <!-- ============================================================ -->
    <template id="portal_mice_scenario_summary"
              inherit_id="ak_tender.ak_purchase_order_portal_content"
              name="MICE — Senaryo Özeti">

        <xpath expr="//section[@id='details']" position="before">
            <t t-if="order.tender_id and order.tender_id.tender_type == 'mice'">
                <section class="mt-4 mb-3" id="mice_scenarios">
                    <h4>
                        <i class="fa fa-map me-2" style="color: #0d6efd;"/>
                        MICE Senaryoları
                    </h4>
                    <div class="alert alert-info py-2" style="font-size: 0.9em;">
                        <i class="fa fa-info-circle me-1"/>
                        Bu ihale <strong><t t-esc="order.tender_id.tender_round"/>. tur</strong> teklifine açıktır.
                        Her senaryo için ilgili kalemlere fiyat giriniz. Birden fazla tarih seçeneği olan senaryolarda hangi tarih için teklif verdiğinizi belirtiniz.
                    </div>

                    <!-- Senaryo kartları -->
                    <t t-set="tender_scenarios" t-value="order.tender_id.scenario_ids.filtered(lambda s: s.scenario_type != 'region' and s.scenario_status != 'eliminated')"/>
                    <t t-if="tender_scenarios">
                        <div class="row">
                            <t t-foreach="tender_scenarios" t-as="sc">
                                <div class="col-md-6 col-lg-4 mb-3">
                                    <div class="card h-100 border" t-att-style="'border-color: #198754 !important;' if sc.scenario_status == 'shortlisted' else ''">
                                        <div class="card-body py-2 px-3">
                                            <h6 class="card-title mb-1">
                                                <t t-if="sc.scenario_status == 'shortlisted'">
                                                    <i class="fa fa-star text-warning me-1"/>
                                                </t>
                                                <t t-esc="sc.name"/>
                                            </h6>
                                            <div style="font-size: 0.85em; color: #555;">
                                                <div t-if="sc.hotel_partner_id">
                                                    <i class="fa fa-building me-1"/>
                                                    <t t-esc="sc.hotel_partner_id.name"/>
                                                </div>
                                                <div t-if="sc.location_id">
                                                    <i class="fa fa-map-marker me-1"/>
                                                    <t t-esc="sc.location_id.name"/>
                                                </div>
                                                <div t-if="sc.meal_plan">
                                                    <i class="fa fa-cutlery me-1"/>
                                                    <t t-esc="sc.meal_plan.upper()"/>
                                                </div>
                                                <div t-if="sc.person_count">
                                                    <i class="fa fa-users me-1"/>
                                                    <t t-esc="sc.person_count"/> kişi
                                                    <t t-if="sc.vip_count">
                                                        (<t t-esc="sc.vip_count"/> VIP)
                                                    </t>
                                                </div>
                                                <div t-if="sc.date_option_ids" class="mt-1">
                                                    <i class="fa fa-calendar me-1"/>
                                                    <strong>Tarih Seçenekleri:</strong>
                                                    <t t-foreach="sc.date_option_ids" t-as="dt">
                                                        <span class="badge bg-secondary ms-1" style="font-size: 0.8em;">
                                                            <t t-esc="dt.name"/>
                                                        </span>
                                                    </t>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </t>
                </section>
            </t>
        </xpath>

    </template>

    <!-- ============================================================ -->
    <!-- MICE Tarih Seçeneklerini Kaydet — JS ile                     -->
    <!-- ============================================================ -->
    <template id="portal_mice_js"
              inherit_id="ak_tender.ak_purchase_order_portal_content"
              name="MICE — Tarih Kaydet JS">

        <xpath expr="//section[@id='details']" position="after">
            <t t-if="order.tender_id and order.tender_id.tender_type == 'mice'">
                <div class="mt-3 text-end" id="mice_date_save_area">
                    <button type="button"
                            id="btn_save_mice_dates"
                            class="btn btn-outline-primary btn-sm"
                            t-att-data-order-id="order.id"
                            t-att-data-token="order.access_token">
                        <i class="fa fa-calendar-check-o me-1"/>
                        Tarih Seçeneklerini Kaydet
                    </button>
                    <span id="mice_date_save_msg" class="ms-2 text-success" style="display:none; font-size:0.9em;">
                        <i class="fa fa-check me-1"/>Kaydedildi!
                    </span>
                </div>

                <script type="text/javascript">
                    document.addEventListener('DOMContentLoaded', function() {
                        var btn = document.getElementById('btn_save_mice_dates');
                        if (!btn) return;

                        btn.addEventListener('click', function() {
                            var orderId = parseInt(btn.dataset.orderId);
                            var token = btn.dataset.token;
                            var selects = document.querySelectorAll('.mice-date-select');
                            var lines = [];

                            selects.forEach(function(sel) {
                                var nameAttr = sel.name || sel.getAttribute('name') || '';
                                var match = nameAttr.match(/scenario_date_id_line_(\d+)/);
                                if (match) {
                                    lines.push({
                                        line_id: parseInt(match[1]),
                                        scenario_date_id: sel.value ? parseInt(sel.value) : ''
                                    });
                                }
                            });

                            if (lines.length === 0) return;

                            btn.disabled = true;
                            btn.innerHTML = '<i class="fa fa-spinner fa-spin me-1"/>Kaydediliyor...';

                            fetch('/my/purchase/mice/update_scenario_date', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                    'X-Requested-With': 'XMLHttpRequest'
                                },
                                body: JSON.stringify({
                                    jsonrpc: '2.0',
                                    method: 'call',
                                    params: {
                                        order_id: orderId,
                                        access_token: token,
                                        lines: lines
                                    }
                                })
                            })
                            .then(function(r) { return r.json(); })
                            .then(function(data) {
                                btn.disabled = false;
                                btn.innerHTML = '<i class="fa fa-calendar-check-o me-1"/>Tarih Seçeneklerini Kaydet';
                                if (data.result &amp;&amp; data.result.success) {
                                    var msg = document.getElementById('mice_date_save_msg');
                                    if (msg) {
                                        msg.style.display = 'inline';
                                        setTimeout(function() { msg.style.display = 'none'; }, 3000);
                                    }
                                }
                            })
                            .catch(function(err) {
                                btn.disabled = false;
                                btn.innerHTML = '<i class="fa fa-calendar-check-o me-1"/>Tarih Seçeneklerini Kaydet';
                                console.error('MICE date save error:', err);
                            });
                        });
                    });
                </script>
            </t>
        </xpath>

    </template>

</odoo>
