<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_crm_promotion_distribution_plan_wizard_form" model="ir.ui.view">
        <field name="name">crm.promotion.distribution.plan.wizard.form</field>
        <field name="model">crm.promotion.distribution.plan.wizard</field>
        <field name="arch" type="xml">
            <form>
                <header>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="available_quantity"/>
                            <field name="sales_team_id"/>
                            <field name="team_member_count"/>
                        </group>
                        <group>
                            <field name="distribution_type"/>
                            <field name="planned_quantity"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="Apply" class="btn btn-primary" type="object" name="action_distribute"
                            data-hotkey="a"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="q"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>