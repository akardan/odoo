<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="crm_brick_search_view">
        <field name="name">crm.brick.search</field>
        <field name="model">crm.brick</field>
        <field name="arch" type="xml">
            <search>
                <field string="Name" name="name"/>
                <filter string="Country" name="country_id"/>
                <separator/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="active" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>
    <record model="ir.ui.view" id="crm_brick_tree_view">
        <field name="name">crm.brick.tree</field>
        <field name="model">crm.brick</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="state_id"/>
                <field name="country_id"/>
                <field name="territory_id"/>
                <field name="active"/>
                <field name="unit_ids"/>
            </list>
        </field>
    </record>
    <record model="ir.ui.view" id="crm_brick_form_view">
        <field name="name">crm.brick.form</field>
        <field name="model">crm.brick</field>
        <field name="arch" type="xml">
            <form>
                <header>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-check">
                            <field name="active" widget="boolean_button" options='{"terminology": "active"}'/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" required="1"/>
                        </h1>
                    </div>
                    <group>
                        <field name="code"/>
                        <field name="state_id" placeholder="State" class="o_address_state"
                               options="{&quot;no_open&quot;: True}"/>
                        <field name="country_id" placeholder="Country" class="o_address_country"
                               options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}"/>
                        <field name="territory_id"/>
                    </group>
                    <notebook>
                        <page string="Units">
                            <field name="unit_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
