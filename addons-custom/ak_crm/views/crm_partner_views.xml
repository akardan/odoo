<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_partner_tree_inherit" model="ir.ui.view">
        <field name="name">res.partner.tree.inherit.pharma</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='display_name']" position="after">
                <field name="medical_type" optional="show"/>
                <field name="specialization_ids" widget="many2many_tags" optional="hide"/>
                <field name="unit_id"/>
                <field name="brick_id"/>
            </xpath>
        </field>
    </record>
    <record id="view_res_partner_form_inherit_pharma_related" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.pharma</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='geo_location']" position="after">
                <page string="Pharma Related" name="pharma_related">
                    <group>
                        <group>
                            <field name="medical_type"/>
                            <field string="Specializations" name="specialization_ids" colspan="2"
                                   widget="many2many_tags"/>
                            <field name="unit_id"/>
                            <field name="brick_id"/>
                        </group>
                        <group string="Segment By Groups" name="segmentbygroups">
                            <field name="segmentation_ids" nolabel="1" colspan="2" context="{}"
                                   on_change="1">
                                <tree editable="bottom">
                                    <field name="sales_team_id"/>
                                    <field name="segment_id"/>
                                </tree>
                            </field>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
