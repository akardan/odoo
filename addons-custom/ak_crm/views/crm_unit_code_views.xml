<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_crm_unit_code_tree" model="ir.ui.view">
            <field name="name">crm.unit.code.tree</field>
            <field name="model">crm.unit.code</field>
            <field name="arch" type="xml">
                <list string="CRM Unit Code" editable="top">
                    <field name="name"/>
                    <field name="ref_code"/>
                </list>
            </field>
        </record>

        <record id="view_crm_unit_code_form" model="ir.ui.view">
            <field name="name">crm.unit.code.form</field>
            <field name="model">crm.unit.code</field>
            <field name="arch" type="xml">
                <form string="CRM Unit Code">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="ref_code"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

    </data>
</odoo>
