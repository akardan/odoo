<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_crm_promotion_dist" model="ir.actions.act_window">
        <field name="name">action.promotion.distribution.plan</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">crm.promotion.distribution.plan.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_crm_promotion_distribution_plan_tree" model="ir.ui.view">
        <field name="name">crm.promotion.distribution.plan.tree</field>
        <field name="model">crm.promotion.distribution.plan</field>
        <field name="arch" type="xml">
            <tree string="Promotion / Sample Distribution Plan" editable="top">
                <header>
                    <button name="%(action_crm_promotion_dist)d" string="New Promotion" type="action"
                            class="oe_highlight"/>
                    <!-- <button name="action_promotion_dist" string="New Promotion" type="object" class="oe_highlight"/>-->
                    <button name="create_delivery_order" string="Sevk İrsaliyesi" type="object" class="oe_highlight"/>
                </header>
                <field name="product_id"/>
                <field name="planned_quantity"/>
                <field name="team_member_id"/>
                <field name="sales_team_id"/>
                <field name="state"/>
            </tree>
        </field>
    </record>


    <record id="view_crm_promotion_distribution_plan_pivot" model="ir.ui.view">
        <field name="name">crm.promotion.distribution.plan.pivot</field>
        <field name="model">crm.promotion.distribution.plan</field>
        <field name="arch" type="xml">
            <pivot string="Promotion / Sample Distribution Plan">
                <field name="team_member_id" type="row"/>
                <field name="planned_quantity" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_crm_promotion_distribution_plan_form" model="ir.ui.view">
        <field name="name">crm.promotion.distribution.plan.form</field>
        <field name="model">crm.promotion.distribution.plan</field>
        <field name="arch" type="xml">
            <form string="Promotion/ DR.Sample Distribution Plan">
                <sheet>
                    <group>
                        <field name="product_id"/>
                        <field name="planned_quantity"/>
                        <field name="team_member_id"/>
                        <field name="sales_team_id"/>
                        <field name="state"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
