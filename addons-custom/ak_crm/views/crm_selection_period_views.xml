<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_crm_selection_period_tree" model="ir.ui.view">
            <field name="name">crm.selection.period.tree</field>
            <field name="model">crm.selection.period</field>
            <field name="arch" type="xml">
                 <tree string="Selection Periods" editable="top" default_order="date_start desc">
                    <field name="name"/>
                    <field name="date_start"/>
                    <field name="date_end"/>
                    <field name="planning_date_start" optional="show"/>
                    <field name="planning_date_end" optional="show"/>
                    <field name="year" optional="hide"/>
                    <field name="month" optional="hide"/>
                    <field name="active_for_planning"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>
    </data>
</odoo>
