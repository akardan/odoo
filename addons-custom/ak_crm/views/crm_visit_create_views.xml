<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_crm_visit_create_form" model="ir.ui.view">
        <field name="name">crm.visit.create.form</field>
        <field name="model">crm.VisitTransient</field>
        <field name="arch" type="xml">
            <form string="Crm visit">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="ListCustomers" type="object" class="oe_stat_button"
                                string='List Customers'></button>
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" required="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <!-- <field name="visitdate"/>  -->
                            <field name="brick_id"/>
                            <field name="unit_id"/>
                            <field name="customer_type"/>
                        </group>
                    </group>
                    <field name='selected_customer_ids'>
                        <tree string="Partners">
                            <field name="customer_id"/>
                            <field name="visit_type"/>
                            <!-- <field name="state_id"/>
                            <field name="city"/>
                            <field name="specialization_ids" widget="many2many_tags" optional="hide"/> -->
                        </tree>
                    </field>
                </sheet>
                <footer>
                    <button name="search_customers" string="Ara" type="object" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
