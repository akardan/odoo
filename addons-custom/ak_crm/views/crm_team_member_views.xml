<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- CRM Team Member views update-->
    <record id="view_crm_team_member_tree_inherit" model="ir.ui.view">
        <field name="name">crm.team.member.tree.inherit</field>
        <field name="model">crm.team.member</field>
        <field name="inherit_id" ref="sales_team.crm_team_member_view_tree"/>
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="brick_ids" widget="many2many_tags"/>
            </field>
        </field>
    </record>
    <record id="view_crm_team_member_form_inherit" model="ir.ui.view">
        <field name="name">crm.team.member.form.inherit</field>
        <field name="model">crm.team.member</field>
        <field name="inherit_id" ref="sales_team.crm_team_member_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='crm_team_id']" position="after">
                <field name="brick_ids" widget="many2many_tags"/>
            </xpath>
        </field>
    </record>
