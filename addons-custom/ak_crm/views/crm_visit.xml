<odoo>
    <data>

        <record id="view_crm_visits_transient_form" model="ir.ui.view">
            <field name="name">crm.visits.transient.form</field>
            <field name="model">crm.visits.transient</field>
            <field name="arch" type="xml">
                <form>
                    <group col="3">
                        <group col="1">
                            <field name="visit_date"/>
                        </group>
                        <group col="1">
                            <field name="team_member_id"/>
                        </group>
                        <group col="1">
                            <button string="Filter Visits" type="object" class="oe_highlight"
                                    name="button_filter_visits" colspan="2"/>
                            <button string="Create Visit" type="object" name="button_crate_crm_visit" colspan="2"/>
                        </group>
                    </group>
                    <separator string="Partners to Visit"/>
                    <group col="4" invisible="false">
                        <group col="1">
                            <field name="brick_id"/>
                        </group>
                        <group col="1">
                            <field name="unit_id"/>
                        </group>
                        <group col="1">
                            <field name="medical_type"/>
                        </group>
                        <group col="1">
                            <button string="Find Partners" type="object" class="oe_highlight"
                                    name="button_find_partners" colspan="2"/>
                        </group>
                    </group>
                    <field name="crm_visit_transient_ids" no_label="1"/>
                    <separator string="Visits"/>
                    <field name="crm_visit_ids" no_label="1"/>
                </form>
            </field>
        </record>

        <!-- Tree View for crm.visit.transient -->
        <record model="ir.ui.view" id="crm_visit_transient_tree_view">
            <field name="name">crm.visit.transient.tree</field>
            <field name="model">crm.visit.transient</field>
            <field name="arch" type="xml">
                <list editable="bottom" create="False">
                    <field name="customer_id" readonly="True"/>
                    <field name="unit_id"/>
                    <field name="brick_id"/>
                    <field name="visit_type_id"/>
                </list>
            </field>
        </record>


        <!-- Tree View for crm.visit -->
        <record model="ir.ui.view" id="crm_visit_tree_view">
            <field name="name">crm.visit.tree</field>
            <field name="model">crm.visit</field>
            <field name="arch" type="xml">
                <list>
                    <field name="visit_date"/>
                    <field name="unit_id"/>
                    <field name="customer_ids" widget="many2many_tags"/>
                    <field name="visit_type_id"/>
                </list>
            </field>
        </record>

        <!-- Form View for crm.visit -->
        <record id="view_crm_visit_form" model="ir.ui.view">
            <field name="name">crm.visit.form</field>
            <field name="model">crm.visit</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="visit_date"/>
                            <field name="team_member_id"/>
                            <field name="brick_id"/>
                            <field name="unit_id"/>
                            <field name="customer_ids" widget="many2many_tags"/>
                            <field name="visit_type_id"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Tree View for crm.visit.type -->
        <record id="view_crm_visit_type_tree" model="ir.ui.view">
            <field name="name">crm.visit.type.tree</field>
            <field name="model">crm.visit.type</field>
            <field name="arch" type="xml">
                <list string="Visit Types">
                    <field name="name"/>
                    <field name="code"/>
                </list>
            </field>
        </record>
        <!-- Form View for crm.visit.type -->
        <record id="view_crm_visit_type_form" model="ir.ui.view">
            <field name="name">crm.visit.type.form</field>
            <field name="model">crm.visit.type</field>
            <field name="arch" type="xml">
                <form string="Visit Type">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Form view for crm.visit.dashboard -->
        <record id="view_form_crm_visit_dashboard" model="ir.ui.view">
            <field name="name">crm.visit.dashboard.form</field>
            <field name="model">crm.visit.dashboard</field>
            <field name="arch" type="xml">
                <form>
                    <group col="3">
                        <group col="1">
                            <field name="active_period_id"/>
                        </group>
                        <group col="1">
                            <field name="team_member_id"/>
                        </group>
                        <group col="1">
                            <button string="Filter Visits" type="object" class="oe_highlight"
                                    name="button_filter_visits"/>
                        </group>
                    </group>
                    <separator string="Visits"/>
                    <field name="daily_stats_ids" options="{'no_open': True}" mode="list" readonly="1">
                        <list editable="top" create="false" delete="false">
                            <button type="object" name="open_daily_visits" icon="fa-bars" class="oe_highlight"/>
                            <field name="visit_date"/>
                            <field name="visit_count"/>
                            <field name="doctor_count"/>
                            <field name="pharmacy_count"/>
                        </list>
                    </field>
                </form>
            </field>
        </record>


    </data>
</odoo>
