<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_crm_unit_type_tree" model="ir.ui.view">
            <field name="name">crm.unit.type.tree</field>
            <field name="model">crm.unit.type</field>
            <field name="arch" type="xml">
                <tree string="CRM Unit Type" editable="top">
                    <field name="name"/>
                    <field name="ref_code"/>
                </tree>
            </field>
        </record>

        <record id="view_crm_unit_type_form" model="ir.ui.view">
            <field name="name">crm.unit.type.form</field>
            <field name="model">crm.unit.type</field>
            <field name="arch" type="xml">
                <form string="CRM Unit Type">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="ref_code"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

    </data>
</odoo>
