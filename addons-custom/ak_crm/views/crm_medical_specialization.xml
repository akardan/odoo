<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_medical_specialization_tree" model="ir.ui.view">
        <field name="name">crm.medical.specialization.tree</field>
        <field name="model">crm.medical.specialization</field>
        <field name="arch" type="xml">
            <tree string="CRM Medical Specializations">
                <field name="code"/>
                <field name="name"/>
            </tree>
        </field>
    </record>
    <record id="view_crm_medical_specialization_form" model="ir.ui.view">
        <field name="name">crm.medical.specialization.form</field>
        <field name="model">crm.medical.specialization</field>
        <field name="arch" type="xml">
            <form string="CRM Medical Specialization">
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
