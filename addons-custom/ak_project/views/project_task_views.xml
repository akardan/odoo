<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_task_form2" model="ir.ui.view">
        <field name="name">project.task.view.form.inherit.ak.project</field>
        <field name="model">project.task</field>
        <field name="mode">extension</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_assign_to_me" string="Assign to Me" type="object" class="oe_highlight"
                        invisible="[('user_ids', 'in', [uid])]" />
            </xpath>
            <xpath expr="//div[hasclass('oe_button_box')]"
                   position="inside">
                <button class="oe_stat_button" name="button_task_document"
                        type="object"
                        icon="fa-book">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="document_count" readonly="1"/>
                        </span>
                        <span class="o_stat_text">
                            Documents
                        </span>
                    </div>
                </button>
            </xpath>
            <field name="partner_id" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>

            <field name="partner_id" position="after">
                <field name="board_type" invisible="1" />
                <field name="issue_type" cond="invisible: board_type =='kanban'"  widget="selection_issue_type"/>
                <field name="version_id" domain="[('project_id', '=', project_id)]" cond="invisible: board_type =='kanban'" />
                <field name="project_department_id" />
            </field>

            <field name="user_ids" position="before">
                <field name="allowed_assigned_user_ids" invisible="1" />
            </field>        
            <field name="user_ids" position="attributes">
                <attribute name="domain">[('share', '=', False), ('active', '=', True), ('id', 'in', allowed_assigned_user_ids)]</attribute>
            </field>      
            <xpath expr="//field[@name='user_ids']" position="after">
                <field name="sprint_id"  cond="invisible: board_type =='kanban'"/>
            </xpath>
            <xpath expr="//notebook/page[@name='extra_info']" position="after">
                <page name="sprint_history" string="Sprint History"  cond="invisible: board_type =='kanban'">
                    <field name="sprint_history_ids" readonly="1">
                        <list>
                            <field name='sprint_id'/>
                            <field name='date_added'/>
                        </list>
                    </field>                    
                </page>
            </xpath>                  
            <xpath expr="//notebook/page[@name='sub_tasks_page']/field[@name='child_ids']/list/field[@name='user_ids']" position="before">  
                <field name="allowed_assigned_user_ids" invisible="1" />
            </xpath>                                 
            <xpath expr="//notebook/page[@name='sub_tasks_page']/field[@name='child_ids']/list/field[@name='user_ids']" position="attributes">  
                <attribute name="domain">[('share', '=', False), ('active', '=', True), ('id', 'in', allowed_assigned_user_ids)]</attribute>
            </xpath>  
            <xpath expr="//notebook/page[@name='extra_info']" position="attributes">     
                <attribute name="groups">project.group_project_manager</attribute>
            </xpath>      
            
            <field name="displayed_image_id" position="attributes"><attribute name="groups">project.group_project_manager</attribute></field>
            <field name="email_cc" position="attributes"><attribute name="groups">project.group_project_manager</attribute></field>
            <field name="sequence" position="attributes"><attribute name="groups">project.group_project_manager</attribute></field>
            <field name="date_assign" position="attributes"><attribute name="groups">project.group_project_manager</attribute></field>
            <field name="date_last_stage_update" position="attributes"><attribute name="groups">project.group_project_manager</attribute></field>            
        </field>
    </record>

    <record id="view_task_tree2" model="ir.ui.view">
        <field name="name">project.task.view.tree.ak.project</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2" />
        <field eval="2" name="priority" />
        <field name="arch" type="xml">       
            <field name="sequence" position="replace">
                <field name="sequence" widget="handle" />
            </field>
            <field name="sequence" position="attributes">
                <attribute name="invisible">0</attribute>
                <attribute name="widget">handle</attribute>
            </field>        
            <field name="user_ids" position="after">
                <field name="project_department_id" />
                <field name="project_team_id" optional="hide"/>
                <field name="sprint_id"/>
                <field name="sprint_history_ids" optional="hide"/>
            </field>
        </field>
    </record>


    <record id="view_task_search_form" model="ir.ui.view">
        <field name="name">project.task.search.form</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form" />
        <field name="arch" type="xml">
            <field name="user_ids" position="after">
                <field name="project_department_id" />
            </field>
            <field name="user_ids" position="before">
                <field name="allowed_assigned_user_ids" invisible="1" />
            </field>
            <field name="user_ids" position="attributes">
                <attribute name="domain">[('id', 'in', allowed_assigned_user_ids)]</attribute>
            </field>            

            <!-- <xpath expr="//filter[@name='unassigned']" position="before">                
                <filter string="My Project Team's Tasks" name="my_project_team_tasks" domain="[('project_team_id', 'in', [uid.project_team_ids])]" />
            </xpath> -->
            <xpath expr="//filter[@name='stage']" position="before">
                <filter string="Project Department" name="group_department_id" context="{'group_by':'project_department_id'}" />
                <filter string="Sprint" name="group_by_sprint" domain="[]" context="{'group_by': 'sprint_id'}"/>
            </xpath>            

        </field>
    </record>    

    <record id="view_task_search_form_with_panel" model="ir.ui.view">
        <field name="name">project.task.search.form.with.panel</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form"/>      
        <field name="mode">primary</field>  
        <field name="arch" type="xml">
            <search position="inside">
                <searchpanel>
<!--                    <field name="kanban_state" expand="1" select="multi" icon="fa-check-square-o" enable_counters="1"/>-->
                    <field name="project_team_id" expand="1" select="multi"  icon="fa fa-group"  enable_counters="1" domain="[('type_team', '=', 'project')]" /> 
                    <field name="project_id" expand="1" select="multi"  icon="fa-bars"  enable_counters="1"/>                    
                </searchpanel>
            </search>
        </field>
    </record>    

    <record model="ir.ui.view" id="quick_create_task_form">
        <field name="name">project.task.form.quick_create</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.quick_create_task_form" />
        <field name="arch" type="xml">
            <field name="user_ids" position="before">
                <field name="allowed_assigned_user_ids" invisible="1" />
            </field>
            <field name="user_ids" position="attributes">
                <attribute name="domain">[('id', 'in', allowed_assigned_user_ids)]</attribute>
            </field>
        </field>
    </record>

    <record id="action_server_assign_to_me" model="ir.actions.server">
        <field name="name">Assign to Me</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="binding_model_id" ref="project.model_project_task"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
            for task in records:
                task.action_assign_to_me()
        </field>
    </record>

    <record id="action_server_duplicate_subtasks" model="ir.actions.server">
        <field name="name">Duplicate With Subtasks</field>
        <field name="model_id" ref="project.model_project_task" />
        <field name="binding_model_id" ref="project.model_project_task" />
        <field name="state">code</field>
        <field name="code">action = records.action_duplicate_subtasks()</field>
    </record>

    <!-- Task stages -->
    <record id="task_type_edit" model="ir.ui.view">
        <field name="name">project.task.type.form.ay.project</field>
        <field name="model">project.task.type</field>
        <field name="inherit_id" ref="project.task_type_edit" />
        <field name="arch" type="xml">
            <field name="project_ids" position="after">
                <field name="authorised_group" />
            </field>
        </field>
    </record>

    <record id="project_all_tasks_action" model="ir.actions.act_window">
        <field name="name">All Tasks</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">list,kanban,form,calendar,pivot,graph,activity</field>
        <field name="domain">[]</field>                   
        <field name="search_view_id" ref="ak_project.view_task_search_form_with_panel"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No tasks found. Let's create one!
            </p>
            <p>
                Organize your tasks by dispatching them across the pipeline.<br/>
                Collaborate efficiently by chatting in real-time or via email.
            </p>
        </field>
    </record>

    <record id="open_project_all_tasks_view_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="10"/>
        <field name="view_mode">list</field>
        <field name="act_window_id" ref="project_all_tasks_action"/>
    </record>
    
    <record id="open_project_all_tasks_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="20"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="project.view_task_kanban_inherit_my_task"/>
        <field name="act_window_id" ref="project_all_tasks_action"/>
    </record>        
     

    <menuitem id="project_tasks_main_menu"
                name="Tasks"                
                parent="project.menu_main_pm"
                groups="project.group_project_user"
                sequence="1"/>

    <menuitem id="project_all_tasks_menu"
                name="All Tasks"
                action="project_all_tasks_action"
                parent="project_tasks_main_menu"
                groups="project.group_project_user"
                sequence="3"/>

    <menuitem name="My Tasks" id="project.menu_project_management" parent="project_tasks_main_menu" />
    
    <!-- <record id="project.menu_project_management" model="ir.ui.menu">
        <field name="parent" eval="project_tasks_main_menu"/>
    </record>                -->

    <record id="view_task_kanban_inherit_assign_to_me" model="ir.ui.view">
        <field name="name">project.task.kanban.inherit.assign</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//templates//t[@t-name='card']//footer//div[contains(@class, 'd-flex ms-auto')]" position="replace">
                <div class="d-flex ms-auto">
                    <button name="action_assign_to_me" type="object"
                            class="btn btn-sm btn-secondary o_kanban_manage_button"
                            confirm="Are you sure you want to assign this task to yourself?"
                            title="Assign to Me">
                        <i class="fa fa-plus"/>
                    </button>
                    <field name="user_ids" widget="many2many_avatar_user"/>
                    <field name="state" class="ms-1" widget="project_task_state_selection" options="{'is_toggle_mode': false}" on_change="1"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
