<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    Form view for the model project.phase-->
    <record id="project_phase_view_form" model="ir.ui.view">
        <field name="name">project.phase.view.form</field>
        <field name="model">project.phase</field>
        <field name="arch" type="xml">
            <form string="project_phase">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="get_project_tasks" type="object"
                                icon="fa-edit"
                                class="oe_stat_button" string="Tasks">
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                        </group>
                        <notebook>
                            <page string="Internal Note">
                                <field name="internal_notes"/>
                            </page>
                        </notebook>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!--    Kanban view of model project.phase-->
    <record id="project_phase_view_kanban" model="ir.ui.view">
        <field name="name">project.phase.view.kanban</field>
        <field name="model">project.phase</field>
        <field name="arch" type="xml">
            <kanban class="oe_background_grey o_kanban_dashboard o_emphasize_colors o_stock_kanban">
                <field name="task_count" />
                <field name="project_id" />
                <templates>
                    <t t-name="kanban-box">
                        <div name="board">
                            <div t-attf-class="oe_kanban_global_click o_kanban_card_header">
                                <div class="o_kanban_card_header_title">
                                    <div class="o_primary">
                                        <h3>
                                            <field name="name"/>
                                        </h3>
                                    </div>
                                    <div class="o_secondary">
                                        <small>
                                            <i class="fa fa-bars" role="img" aria-label="Project" title="Project"/> <field name="project_id"/>
                                        </small>
                                    </div>                                
                                </div>
                            </div>
                            <div class="container o_kanban_card_content">
                                <div class="row o_kanban_card_upper_content">
                                    <div class="col-6 o_kanban_primary_left">                            
                                        <button class="btn btn-primary" name="get_project_tasks" type="object">
                                            <t t-esc="record.task_count.value"/> Task<span t-if="record.task_count.value > 1">s</span>
                                        </button>                            
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <!--    List view of the model project.phase-->
    <record id="project_phase_view_tree" model="ir.ui.view">
        <field name="name">project.phase.view.tree</field>
        <field name="model">project.phase</field>
        <field name="arch" type="xml">
            <list string="phase">
                <field name="project_id"/>
                <field name="name"/>                
            </list>
        </field>
    </record>

    <record id="project_phase_view_search" model="ir.ui.view">
        <field name="name">project.phase.view.search</field>
        <field name="model">project.phase</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="project_id" />                
                <filter string="Project" name="groupby_project_id" context="{'group_by':'project_id'}" />                
            </search>
        </field>
    </record>      

    <!--    Action for model-->
    <record id="project_phase_action" model="ir.actions.act_window">
        <field name="name">Project Phases</field>
        <field name="res_model">project.phase</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="ak_project.project_phase_view_search" />
        <field name="context">{}</field>  
    </record>


    <!--    Menu item for show it in project module-->

    <menuitem id="project_phase_menu_action"
              name="Phases"
              action="project_phase_action"
              parent="ak_project.menu_project_definition"
              sequence="50"/>
</odoo>