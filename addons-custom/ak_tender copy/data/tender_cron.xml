<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron Job: Auto-transition tenders when deadline expires -->
        <record id="ir_cron_auto_transition_tender_deadline" model="ir.cron">
            <field name="name">İhale: Otomatik Durum Geçişi (Deadline)</field>
            <field name="model_id" ref="model_ak_tender"/>
            <field name="state">code</field>
            <field name="code">model._cron_auto_transition_on_deadline()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Cron Job: Send reminder emails to suppliers -->
        <record id="ir_cron_send_supplier_bid_reminders" model="ir.cron">
            <field name="name">İhale: Tedarikçi Hatırlatma Maili</field>
            <field name="model_id" ref="model_ak_tender"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_supplier_bid_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>