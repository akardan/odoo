<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_add_supplier_wizard_form" model="ir.ui.view">
            <field name="name">ak.tender.add.supplier.wizard.form</field>
            <field name="model">ak.tender.add.supplier.wizard</field>
            <field name="arch" type="xml">
                <form string="Tedarikçi Ekle">
                    <sheet>
                        <group>
                            <field name="tender_id"/>
                            <field name="partner_ids" widget="many2many_tags"/>
                            <field name="send_invitation"/>
                        </group>
                        <group invisible="send_invitation == False">
                            <field name="invitation_message" widget="html" nolabel="1" placeholder="Davet mesajı..."/>
                        </group>
                        <div class="alert alert-info" role="alert">
                            <p><strong>Bilgi:</strong> Bu sihirbaz, ihaleye yeni tedarikçiler eklemenizi sağlar.</p>
                            <p>İhale süreci devam ederken bile yeni tedarikçiler ekleyebilirsiniz.</p>
                        </div>
                    </sheet>
                    <footer>
                        <button name="action_add_suppliers" string="Tedarikçileri Ekle" type="object" class="btn-primary"/>
                        <button string="İptal" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_add_supplier_wizard" model="ir.actions.act_window">
            <field name="name">Tedarikçi Ekle</field>
            <field name="res_model">ak.tender.add.supplier.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="binding_model_id" ref="model_ak_tender"/>
            <field name="binding_view_types">form</field>
        </record>
    </data>
</odoo>