<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Geçmiş Dönem PO Import Wizard Form -->
    <record id="view_import_historical_po_wizard_form" model="ir.ui.view">
        <field name="name">import.historical.po.wizard.form</field>
        <field name="model">import.historical.po.wizard</field>
        <field name="arch" type="xml">
            <form string="Geçmiş Dönem Satınalma Siparişleri İmport">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="file_name" invisible="1"/>
                            Geçmiş Dönem PO İmport
                        </h1>
                    </div>
                    
                    <group>
                        <group>
                            <field name="excel_file" filename="file_name"/>
                            <field name="file_name" invisible="1"/>
                        </group>
                        <group>
                            <field name="create_partners"/>
                            <field name="create_products"/>
                            <field name="skip_duplicates"/>
                            <field name="confirm_orders"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Açıklamalar">
                            <group>
                                <div class="alert alert-info" role="alert">
                                    <h4>Excel Import Formatı</h4>
                                    <p>
                                        <strong>Gerekli Kolonlar:</strong><br/>
                                        • SIPARIS_NO: SAP Sipariş Numarası (Zorunlu)<br/>
                                        • TEDARIKCI_ADI: Tedarikçi Ünvanı (Zorunlu)<br/>
                                        • MALZEME_ADI: Malzeme/Ürün Açıklaması (Zorunlu)<br/>
                                        • MIKTAR: Sipariş Miktarı (Zorunlu)<br/>
                                        • BIRIM_FIYAT: Birim Fiyat (Zorunlu)<br/>
                                        • SIPARIS_TARIHI: Sipariş Tarihi (YYYY-MM-DD formatında)<br/>
                                    </p>
                                    <p>
                                        <strong>İsteğe Bağlı Kolonlar:</strong><br/>
                                        • KALEM_NO: Sipariş Kalem Numarası<br/>
                                        • TEDARIKCI_KODU: Tedarikçi SAP Kodu<br/>
                                        • MALZEME_KODU: Malzeme SAP Kodu<br/>
                                        • BIRIM: Ölçü Birimi (KG, LT, AD vb.)<br/>
                                        • PARA_BIRIMI: Para Birimi (TRY, USD, EUR)<br/>
                                        • TOPLAM_TUTAR: Toplam Tutar<br/>
                                        • VADE: Ödeme Vadesi (örn: 30 Gün)<br/>
                                        • IHALE_TIPI: İhale Tipi (direct/indirect/promotion/mice)<br/>
                                        • SIRKET_KODU: SAP Şirket Kodu<br/>
                                        • TESIS: Tesis/Depo Adı<br/>
                                        • SATIN_ALMACI: Satınalmacı Adı<br/>
                                        • MALZEME_GRUBU: SAP Malzeme Grubu<br/>
                                        • TESLIMAT_TARIHI: Teslimat Tarihi (YYYY-MM-DD)<br/>
                                        • NOTLAR: Ek Notlar<br/>
                                    </p>
                                    <p>
                                        <strong>Analiz Boyutları için Önemli Alanlar:</strong><br/>
                                        • <strong>Zaman:</strong> SIPARIS_TARIHI (yıl, çeyrek, ay bazında analiz için)<br/>
                                        • <strong>İhale Tipi:</strong> IHALE_TIPI (direct/indirect/promotion karşılaştırması için)<br/>
                                        • <strong>Satınalmacı:</strong> SATIN_ALMACI (kişi bazlı performans analizi için)<br/>
                                        • <strong>Ürün/Hizmet:</strong> MALZEME_ADI, MALZEME_KODU, MALZEME_GRUBU<br/>
                                        • <strong>Fiyat:</strong> BIRIM_FIYAT, TOPLAM_TUTAR (fiyat trend analizi için)<br/>
                                        • <strong>Vade:</strong> VADE (nakit akışı analizi için)<br/>
                                        • <strong>Tedarikçi:</strong> TEDARIKCI_ADI (tedarikçi performans analizi için)<br/>
                                        • <strong>Şirket/Tesis:</strong> SIRKET_KODU, TESIS (lokasyon bazlı analiz için)<br/>
                                    </p>
                                </div>
                            </group>
                        </page>
                        
                        <page string="İşlem Seçenekleri">
                            <group>
                                <group string="Veri Eşleştirme">
                                    <div class="alert alert-warning" role="alert">
                                        <strong>Yeni Tedarikçi Oluştur:</strong> İşaretlenirse, Excel'de bulunan ancak sistemde olmayan tedarikçiler otomatik olarak oluşturulur.
                                    </div>
                                    <div class="alert alert-warning" role="alert">
                                        <strong>Yeni Ürün Oluştur:</strong> İşaretlenirse, Excel'de bulunan ancak sistemde olmayan ürünler otomatik olarak oluşturulur.
                                    </div>
                                </group>
                                <group string="İşlem Kontrolleri">
                                    <div class="alert alert-info" role="alert">
                                        <strong>Duplikaları Atla:</strong> Aynı sipariş numarası zaten varsa bu sipariş atlanır.
                                    </div>
                                    <div class="alert alert-info" role="alert">
                                        <strong>Siparişleri Onayla:</strong> İmport edilen siparişler otomatik olarak onaylanır (RFQ → Purchase Order).
                                    </div>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                
                <footer>
                    <button name="action_download_template" 
                            string="Excel Şablonu İndir" 
                            type="object" 
                            class="btn-secondary"/>
                    <button name="action_import_po" 
                            string="İmport Et" 
                            type="object" 
                            class="btn-primary"/>
                    <button string="İptal" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard Action -->
    <record id="action_import_historical_po_wizard" model="ir.actions.act_window">
        <field name="name">Geçmiş Dönem PO İmport</field>
        <field name="res_model">import.historical.po.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="purchase.model_purchase_order"/>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_import_historical_po"
              name="Geçmiş Dönem PO İmport"
              parent="purchase.menu_purchase_config"
              action="action_import_historical_po_wizard"
              sequence="100"/>
</odoo>
