<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ak_tender_action_wizard_form_view" model="ir.ui.view">
        <field name="name">ak.tender.action.wizard.form</field>
        <field name="model">ak.tender.action.wizard</field>
        <field name="arch" type="xml">
            <form string="İşlem Onayı">
                <group>
                    <field name="tender_id" invisible="1"/>
                    <field name="action_type" invisible="1"/>
                    <p>Bu ihale için "<field name="action_type"/>" işlemini gerçekleştirmek istediğinizden emin misiniz?</p>
                    <field name="notes" placeholder="Ek notlarınızı girin..."/>
                </group>
                <footer>
                    <button string="Onayla" name="confirm_action" type="object" class="oe_highlight"/>
                    <button string="İptal" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_tender_action_wizard" model="ir.actions.act_window">
        <field name="name">İhale İşlemini Onayla</field>
        <field name="res_model">ak.tender.action.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
