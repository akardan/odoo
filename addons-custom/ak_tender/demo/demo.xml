        <record id="tender_completed" model="ak.tender">
            <field name="name">Sunucu Altyapı Yenileme İhalesi</field>
            <field name="code">TENDER/2025/001</field>
            <field name="erp_pr_id">ERP-PR-10025</field>
            <field name="erp_company_code">TR01</field>
            <field name="erp_plant_code">IST01</field>
            <field name="tender_type">open_auction</field>
            <field name="start_date" eval="(DateTime.today() - relativedelta(months=2)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="end_date" eval="(DateTime.today() - relativedelta(days=15)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="description">
                <![CDATA[
                <h3>Sunucu Altyapı Yenileme İhalesi</h3>
                <p>Bu ihale, şirketimizin veri merkezi sunucu altyapısının yenilenmesi için açılmıştır.</p>
                <ul>
                    <li>Yüksek performanslı sunucu donanımı</li>
                    <li>Ağ ekipmanları</li>
                    <li>Kurulum ve konfigürasyon hizmetleri</li>
                </ul>
                <p>Teknik şartname ekte sunulmuştur.</p>
                ]]>
            </field>
            <field name="state">done</field>
            <field name="target_price">120000.00</field>
            <field name="approval_user_id" ref="base.user_admin"/>
            <field name="approval_date" eval="(DateTime.today() - relativedelta(days=10)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="invited_partners" eval="[(6, 0, [ref('supplier_tech_solutions'), ref('supplier_global_tech')])]"/>
        </record>

