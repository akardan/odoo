<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Tender Manager can see and modify all tenders -->
        <record id="tender_rule_manager" model="ir.rule">
            <field name="name">Tender: Manager Access</field>
            <field name="model_id" ref="model_ak_tender"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('ak_tender.group_tender_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Tender User can see all tenders but only modify their own -->
        <record id="tender_rule_user" model="ir.rule">
            <field name="name">Tender: User Access</field>
            <field name="model_id" ref="model_ak_tender"/>
            <field name="domain_force">['|', ('create_uid', '=', user.id), ('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('ak_tender.group_tender_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Tender Requester can only see and create their own tenders -->
        <record id="tender_rule_requester" model="ir.rule">
            <field name="name">Tender: Requester Access</field>
            <field name="model_id" ref="model_ak_tender"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('ak_tender.group_tender_requester'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Tender Line Rules -->
        <record id="tender_line_rule_manager" model="ir.rule">
            <field name="name">Tender Line: Manager Access</field>
            <field name="model_id" ref="model_ak_tender_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('ak_tender.group_tender_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="tender_line_rule_user" model="ir.rule">
            <field name="name">Tender Line: User Access</field>
            <field name="model_id" ref="model_ak_tender_line"/>
            <field name="domain_force">['|', ('create_uid', '=', user.id), ('tender_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('ak_tender.group_tender_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="tender_line_rule_requester" model="ir.rule">
            <field name="name">Tender Line: Requester Access</field>
            <field name="model_id" ref="model_ak_tender_line"/>
            <field name="domain_force">[('tender_id.create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('ak_tender.group_tender_requester'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>