<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Tender Manager can see and modify all tenders -->
        <record id="tender_rule_manager" model="ir.rule">
            <field name="name">Tender: Manager Access</field>
            <field name="model_id" ref="model_ak_tender"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('ak_tender.group_tender_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Tender User can see all tenders but only modify their own -->
        <record id="tender_rule_user" model="ir.rule">
            <field name="name">Tender: User Access</field>
            <field name="model_id" ref="model_ak_tender"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('ak_tender.group_tender_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Tender Requester can only see and create their own tenders -->
        <record id="tender_rule_requester" model="ir.rule">
            <field name="name">Tender: Requester Access</field>
            <field name="model_id" ref="model_ak_tender"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('ak_tender.group_tender_requester'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Tender Line Rules -->
        <record id="tender_line_rule_manager" model="ir.rule">
            <field name="name">Tender Line: Manager Access</field>
            <field name="model_id" ref="model_ak_tender_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('ak_tender.group_tender_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="tender_line_rule_user" model="ir.rule">
            <field name="name">Tender Line: User Access</field>
            <field name="model_id" ref="model_ak_tender_line"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('ak_tender.group_tender_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="tender_line_rule_requester" model="ir.rule">
            <field name="name">Tender Line: Requester Access</field>
            <field name="model_id" ref="model_ak_tender_line"/>
            <field name="domain_force">[('tender_id.create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('ak_tender.group_tender_requester'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Purchase Requisition Rules -->
        <record id="purchase_requisition_rule_manager" model="ir.rule">
            <field name="name">Purchase Requisition: Manager Access</field>
            <field name="model_id" ref="purchase_requisition.model_purchase_requisition"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('ak_tender.group_tender_manager')), (4, ref('ak_tender.group_tender_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="purchase_requisition_rule_requester" model="ir.rule">
            <field name="name">Purchase Requisition: Requester Access</field>
            <field name="model_id" ref="purchase_requisition.model_purchase_requisition"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('ak_tender.group_tender_requester'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="purchase_requisition_line_rule_manager" model="ir.rule">
            <field name="name">Purchase Requisition Line: Manager Access</field>
            <field name="model_id" ref="purchase_requisition.model_purchase_requisition_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('ak_tender.group_tender_manager')), (4, ref('ak_tender.group_tender_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="purchase_requisition_line_rule_requester" model="ir.rule">
            <field name="name">Purchase Requisition Line: Requester Access</field>
            <field name="model_id" ref="purchase_requisition.model_purchase_requisition_line"/>
            <field name="domain_force">[('requisition_id.create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('ak_tender.group_tender_requester'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Supplier Application Rules -->
        <!-- Public users can create and edit their own draft applications via token -->
        <record id="supplier_application_rule_public" model="ir.rule">
            <field name="name">Supplier Application: Public Token Access</field>
            <field name="model_id" ref="model_supplier_application"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_public'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Managers can see and modify all applications -->
        <record id="supplier_application_rule_manager" model="ir.rule">
            <field name="name">Supplier Application: Manager Access</field>
            <field name="model_id" ref="model_supplier_application"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('ak_tender.group_tender_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Users can only read applications -->
        <record id="supplier_application_rule_user" model="ir.rule">
            <field name="name">Supplier Application: User Read Access</field>
            <field name="model_id" ref="model_supplier_application"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('ak_tender.group_tender_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>