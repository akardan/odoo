<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Report template for vendor comparison -->
        <template id="report_vendor_comparison">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <div class="page">
                            <h4 class="mt-3 mb-3">İhale No: <span t-field="o.code"/> | <span t-field="o.name"/></h4>

                            <style>
                                .label-col {
                                    text-align: left;
                                    padding-right: 5px !important;
                                    white-space: nowrap;
                                    width: 120px;
                                }
                                .order-button {
                                    width: 220px;
                                    display: inline-block;
                                }
                                .colon-col {
                                    width: 10px;
                                    padding-left: 0 !important;
                                    padding-right: 5px !important;
                                }
                                .value-col {
                                    padding-left: 0 !important;
                                }
                                .header-table td {
                                    padding: 2px !important;
                                }
                            </style>
                            <table class="table table-borderless mt-4 header-table" style="margin-bottom: 10px;">
                                <tr>
                                    <td class="label-col"><strong>İhale Tipi</strong></td>
                                    <td class="colon-col">:</td>
                                    <td class="value-col"><span t-field="o.tender_type"/></td>
                                    
                                    <td class="label-col"><strong>Başlangıç Tarihi</strong></td>
                                    <td class="colon-col">:</td>
                                    <td class="value-col"><span t-field="o.start_date" t-options='{"format": "dd/MM/yyyy HH:mm"}'/></td>
                                    
                                    <td class="label-col"><strong>Durum</strong></td>
                                    <td class="colon-col">:</td>
                                    <td class="value-col"><span t-field="o.workflow_current_state_id"/></td>
                                    
                                    <td style="text-align: right;">
                                        <button type="button" class="btn btn-sm btn-primary order-button" onclick="createOrderFromSelection(this)" t-att-disabled="o.workflow_current_state_id.code != 'order'">
                                            Seçimlerden Sipariş oluştur
                                        </button>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="label-col"><strong>Teklif Turu</strong></td>
                                    <td class="colon-col">:</td>
                                    <td class="value-col"><span t-field="o.tender_round"/></td>
                                    
                                    <td class="label-col"><strong>Bitiş Tarihi</strong></td>
                                    <td class="colon-col">:</td>
                                    <td class="value-col"><span t-field="o.end_date" t-options='{"format": "dd/MM/yyyy HH:mm"}'/></td>
                                    
                                    <td class="label-col"><strong>Hedef Fiyat</strong></td>
                                    <td class="colon-col">:</td>
                                    <td class="value-col"><span t-field="o.target_price"/></td>
                                    
                                    <td style="text-align: right;">

                                        <button type="button" class="btn btn-sm btn-secondary order-button" onclick="createOrderFromTotalSelection(this)" t-att-disabled="o.workflow_current_state_id.code != 'order'">
                                            Toplamdan Sipariş oluştur
                                        </button>
                                    </td>
                                </tr>
                            </table>
                            
                            <!-- <h3 class="mt-4">Tedarikçi Karşılaştırma</h3> -->
                            
                            <!-- Comparison Table -->
                            <style>
                                .comparison-table th, .comparison-table td {
                                    padding: 3px;
                                    font-size: 12px;
                                    vertical-align: middle;
                                    line-height: 1.1;
                                    height: auto !important;
                                    max-height: none !important;
                                }
                                .comparison-table th {
                                    background-color: #f5f5f5;
                                    font-weight: bold;
                                    text-align: center;
                                }
                                .comparison-table .product-col {
                                    width: 30%;
                                    min-width: 300px;
                                }
                                .comparison-table .field-col {
                                    width: 12%;
                                    min-width: 100px;
                                    white-space: nowrap;
                                }
                                .comparison-table .vendor-col {
                                    width: 15%;
                                    min-width: 150px;
                                    text-align: center;
                                }
                                .comparison-table .text-center {
                                    text-align: center;
                                }
                                .comparison-table .product-row td {
                                    background-color: #f9f9f9;
                                }
                            </style>
                            <table class="table table-bordered comparison-table mt-3" t-att-data-tender-id="o.id">
                                <thead>
                                    <tr>
                                        <!-- Product Information Column -->
                                        <th class="product-col">Ürün</th>
                                        
                                        <!-- Field Column -->
                                        <th class="field-col"></th>
                                        
                                        <!-- Define vendors_to_show at the beginning -->
                                        <t t-set="latest_round_pos" t-value="o.purchase_order_ids.filtered(lambda po: po.tender_round == o.tender_round)"/>
                                        <t t-set="vendors_to_show" t-value="latest_round_pos if latest_round_pos else o.purchase_order_ids"/>
                                        
                                        <!-- Vendor Columns - Only show latest round -->
                                        <t t-foreach="vendors_to_show" t-as="vendor">
                                            <th class="vendor-col" t-esc="vendor.partner_id.name"/>
                                        </t>
                                    </tr>
                                </thead>
                                <script type="text/javascript">
                                    function createOrderFromSelection(button) {
                                        // Get the selected checkboxes for product selections
                                        var selectedProducts = document.querySelectorAll('input[name="vendor_product_selection"]:checked');
                                        var selections = [];
                                        
                                        selectedProducts.forEach(function(checkbox) {
                                            selections.push(checkbox.value);
                                        });
                                        
                                        if (selections.length > 0) {
                                            // Call the server action to create orders
                                            odoo.jsonRpc("/web/dataset/call_kw/ak.tender/create_orders_from_selections", 'call', {
                                                model: 'ak.tender',
                                                method: 'create_orders_from_selections',
                                                args: [parseInt(button.closest('table').dataset.tenderId), selections],
                                                kwargs: {},
                                            }).then(function(result) {
                                                alert("Siparişler oluşturuldu!");
                                                location.reload();
                                            });
                                        } else {
                                            alert("Lütfen en az bir ürün seçin!");
                                        }
                                    }
                                    
                                    function createOrderFromTotalSelection(button) {
                                        // Get the selected checkboxes for total selections
                                        var selectedVendors = document.querySelectorAll('input[name="vendor_total_selection"]:checked');
                                        var vendorIds = [];
                                        
                                        selectedVendors.forEach(function(checkbox) {
                                            vendorIds.push(parseInt(checkbox.value));
                                        });
                                        
                                        if (vendorIds.length > 0) {
                                            // Call the server action to create orders
                                            odoo.jsonRpc("/web/dataset/call_kw/ak.tender/create_orders_from_total_selection", 'call', {
                                                model: 'ak.tender',
                                                method: 'create_orders_from_total_selection',
                                                args: [parseInt(button.closest('table').dataset.tenderId), vendorIds],
                                                kwargs: {},
                                            }).then(function(result) {
                                                alert("Toplam siparişler oluşturuldu!");
                                                location.reload();
                                            });
                                        } else {
                                            alert("Lütfen en az bir tedarikçi seçin!");
                                        }
                                    }
                                </script>
                                <tbody>
                                    <!-- For each product in the tender -->
                                    <t t-foreach="o.tender_lines" t-as="tender_line">
                                        <t t-if="tender_line.display_type == 'line_section'">
                                            <!-- Section header -->
                                            <tr>
                                                <td t-att-colspan="2 + len(vendors_to_show)" class="table-active">
                                                    <strong t-field="tender_line.name"/>
                                                </td>
                                            </tr>
                                        </t>
                                        <t t-elif="tender_line.display_type == 'line_note'">
                                            <!-- Note -->
                                            <tr>
                                                <td t-att-colspan="2 + len(vendors_to_show)" class="fst-italic">
                                                    <span t-field="tender_line.name"/>
                                                </td>
                                            </tr>
                                        </t>
                                        <t t-else="">
                                            <!-- Product row -->
                                            <tr class="product-row">
                                                <td class="product-col" t-att-rowspan="11">
                                                    <div><strong t-field="tender_line.product_id.display_name"/></div>
                                                    <t t-if="tender_line.product_id.description_purchase">
                                                        <div class="mt-2" style="padding-left: 15px; font-size: 12px;">
                                                            <strong>Satınalma Açıklaması:</strong>
                                                        </div>
                                                        <div class="mt-1" style="padding-left: 15px; font-size: 12px; max-height: 220px; overflow: hidden;">
                                                            <t t-if="tender_line.product_id.description_purchase">
                                                                <div style="display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis;">
                                                                    <t t-foreach="tender_line.product_id.description_purchase.split('\n')" t-as="line">
                                                                        <t t-if="line.strip()">
                                                                            <div t-esc="line" style="overflow: hidden; text-overflow: ellipsis;"/>
                                                                        </t>
                                                                    </t>
                                                                </div>
                                                            </t>
                                                        </div>
                                                    </t>
                                                </td>
                                                <td class="field-col">Gerekli Tarih:</td>
                                                
                                                <!-- For each vendor in the latest round, add their data for this product -->
                                                
                                                <t t-foreach="vendors_to_show" t-as="vendor">
                                                    <t t-set="vendor_line" t-value="False"/>
                                                    <t t-foreach="vendor.order_line" t-as="line">
                                                        <t t-if="line.tender_line_id and line.tender_line_id.id == tender_line.id">
                                                            <t t-set="vendor_line" t-value="line"/>
                                                        </t>
                                                    </t>
                                                    
                                                    <td class="vendor-col">
                                                        <span t-if="tender_line.required_delivery_date" t-field="tender_line.required_delivery_date"/>
                                                        <span t-else="">-</span>
                                                    </td>
                                                </t>
                                            </tr>
                                            
                                            <!-- Miktar ve Birim row -->
                                            <tr>
                                                <td class="field-col">Miktar:</td>
                                                <t t-foreach="vendors_to_show" t-as="vendor">
                                                    <t t-set="vendor_line" t-value="False"/>
                                                    <t t-foreach="vendor.order_line" t-as="line">
                                                        <t t-if="line.tender_line_id and line.tender_line_id.id == tender_line.id">
                                                            <t t-set="vendor_line" t-value="line"/>
                                                        </t>
                                                    </t>
                                                    <td class="vendor-col">
                                                        <t t-if="vendor_line">
                                                            <span t-field="vendor_line.product_qty"/>
                                                            <span t-if="vendor_line.product_uom"> <span t-field="vendor_line.product_uom.name"/></span>
                                                        </t>
                                                        <span t-else="">-</span>
                                                    </td>
                                                </t>
                                            </tr>
                                            
                                            <!-- Alternatif Malzeme row -->
                                            <tr>
                                                <td class="field-col">Alternatif Malzeme:</td>
                                                <t t-foreach="vendors_to_show" t-as="vendor">
                                                    <t t-set="vendor_line" t-value="False"/>
                                                    <t t-foreach="vendor.order_line" t-as="line">
                                                        <t t-if="line.tender_line_id and line.tender_line_id.id == tender_line.id">
                                                            <t t-set="vendor_line" t-value="line"/>
                                                        </t>
                                                    </t>
                                                    
                                                    <td class="vendor-col">
                                                        <span t-if="vendor_line and vendor_line.alt_materials" t-field="vendor_line.alt_materials"/>
                                                        <span t-else="">-</span>
                                                    </td>
                                                </t>
                                            </tr>

                                            <!-- Birim Fiyat row -->
                                            <tr>
                                                <td class="field-col">Birim Fiyat:</td>
                                                <t t-foreach="vendors_to_show" t-as="vendor">
                                                    <t t-set="vendor_line" t-value="False"/>
                                                    <t t-foreach="vendor.order_line" t-as="line">
                                                        <t t-if="line.tender_line_id and line.tender_line_id.id == tender_line.id">
                                                            <t t-set="vendor_line" t-value="line"/>
                                                        </t>
                                                    </t>

                                                    <td class="vendor-col">
                                                        <span t-if="vendor_line" t-field="vendor_line.price_unit" t-options='{"widget": "monetary", "display_currency": vendor_line.currency_id}'/>
                                                        <span t-else="">-</span>
                                                    </td>
                                                </t>
                                            </tr>

                                            <!-- İndirim % row -->
                                            <tr>
                                                <td class="field-col">İndirim %:</td>
                                                <t t-foreach="vendors_to_show" t-as="vendor">
                                                    <t t-set="vendor_line" t-value="False"/>
                                                    <t t-foreach="vendor.order_line" t-as="line">
                                                        <t t-if="line.tender_line_id and line.tender_line_id.id == tender_line.id">
                                                            <t t-set="vendor_line" t-value="line"/>
                                                        </t>
                                                    </t>
                                                    
                                                    <td class="vendor-col">
                                                        <span t-if="vendor_line" t-field="vendor_line.discount"/>
                                                        <span t-else="">-</span>
                                                    </td>
                                                </t>
                                            </tr>
                                            
                                            <!-- Ödeme Vadesi row -->
                                            <tr>
                                                <td class="field-col">Ödeme Vadesi:</td>
                                                <t t-foreach="vendors_to_show" t-as="vendor">
                                                    <t t-set="vendor_line" t-value="False"/>
                                                    <t t-foreach="vendor.order_line" t-as="line">
                                                        <t t-if="line.tender_line_id and line.tender_line_id.id == tender_line.id">
                                                            <t t-set="vendor_line" t-value="line"/>
                                                        </t>
                                                    </t>
                                                    
                                                    <td class="vendor-col">
                                                        <span t-if="vendor.payment_term_id" t-field="vendor.payment_term_id.name"/>
                                                        <span t-else="">-</span>
                                                    </td>
                                                </t>
                                            </tr>
                                            
                                            
                                            <!-- Tutar row -->
                                            <tr>
                                                <td class="field-col">Tutar:</td>
                                                <!-- First collect all non-zero amounts -->
                                                <t t-set="amounts" t-value="[]"/>
                                                <t t-foreach="vendors_to_show" t-as="vendor_collect">
                                                    <t t-set="vendor_line_collect" t-value="False"/>
                                                    <t t-foreach="vendor_collect.order_line" t-as="line_collect">
                                                        <t t-if="line_collect.tender_line_id and line_collect.tender_line_id.id == tender_line.id">
                                                            <t t-set="vendor_line_collect" t-value="line_collect"/>
                                                        </t>
                                                    </t>
                                                    <t t-if="vendor_line_collect and vendor_line_collect.price_subtotal > 0">
                                                        <t t-set="amounts" t-value="amounts + [vendor_line_collect.price_subtotal]"/>
                                                    </t>
                                                </t>
                                                <!-- Find minimum non-zero amount -->
                                                <t t-set="min_amount" t-value="min(amounts) if amounts else 0"/>
                                                
                                                <t t-foreach="vendors_to_show" t-as="vendor">
                                                    <t t-set="vendor_line" t-value="False"/>
                                                    <t t-foreach="vendor.order_line" t-as="line">
                                                        <t t-if="line.tender_line_id and line.tender_line_id.id == tender_line.id">
                                                            <t t-set="vendor_line" t-value="line"/>
                                                        </t>
                                                    </t>
                                                    
                                                    <td class="vendor-col">
                                                        <t t-if="vendor_line">
                                                            <!-- Bold if this is the lowest non-zero amount -->
                                                            <strong t-if="vendor_line.price_subtotal > 0 and vendor_line.price_subtotal == min_amount">
                                                                <span t-field="vendor_line.price_subtotal"/>
                                                            </strong>
                                                            <span t-else="" t-field="vendor_line.price_subtotal"/>
                                                        </t>
                                                        <span t-else="">-</span>
                                                    </td>
                                                </t>
                                            </tr>
                                            
                                            <!-- Para Birimi row
                                            <tr>
                                                <td class="field-col">Para Birimi:</td>
                                                <t t-foreach="o.purchase_order_ids" t-as="vendor">
                                                    <t t-set="vendor_line" t-value="False"/>
                                                    <t t-foreach="vendor.order_line" t-as="line">
                                                        <t t-if="line.tender_line_id and line.tender_line_id.id == tender_line.id">
                                                            <t t-set="vendor_line" t-value="line"/>
                                                        </t>
                                                    </t>
                                                    
                                                    <td class="vendor-col">
                                                        <span t-if="vendor_line and vendor_line.currency_id" t-field="vendor_line.currency_id.name"/>
                                                        <span t-else="">-</span>
                                                    </td>
                                                </t>
                                            </tr> -->
                                            
                                            <!-- NPV row -->
                                            <tr>
                                                <td class="field-col">NPV:</td>
                                                
                                                <t t-foreach="vendors_to_show" t-as="vendor">
                                                    <t t-set="vendor_line" t-value="False"/>
                                                    <t t-foreach="vendor.order_line" t-as="line">
                                                        <t t-if="line.tender_line_id and line.tender_line_id.id == tender_line.id">
                                                            <t t-set="vendor_line" t-value="line"/>
                                                        </t>
                                                    </t>
                                                    
                                                    <td class="vendor-col">
                                                        <t t-if="vendor_line">
                                                            <t t-set="has_npv" t-value="False"/>
                                                            <t t-foreach="vendor_line._fields" t-as="field">
                                                                <t t-if="field == 'npv_value'">
                                                                    <t t-set="has_npv" t-value="True"/>
                                                                </t>
                                                            </t>
                                                            <!-- Simply show NPV value -->
                                                            <span t-if="has_npv" t-field="vendor_line.npv_value" t-options='{"widget": "monetary", "display_currency": vendor_line.currency_id}'/>
                                                            <span t-else="">-</span>
                                                        </t>
                                                        <span t-else="">-</span>
                                                    </td>
                                                </t>
                                            </tr>
                                            
                                            <!-- Teslimat Tarihi row -->
                                            <tr>
                                                <td class="field-col">Teslimat Tarihi:</td>
                                                <t t-foreach="vendors_to_show" t-as="vendor">
                                                    <t t-set="vendor_line" t-value="False"/>
                                                    <t t-foreach="vendor.order_line" t-as="line">
                                                        <t t-if="line.tender_line_id and line.tender_line_id.id == tender_line.id">
                                                            <t t-set="vendor_line" t-value="line"/>
                                                        </t>
                                                    </t>
                                                    
                                                    <td class="vendor-col">
                                                        <span t-if="vendor_line and vendor_line.date_planned" t-field="vendor_line.date_planned" t-options='{"format": "dd/MM/yyyy"}'/>
                                                        <span t-else="">-</span>
                                                    </td>
                                                </t>
                                            </tr>
                                            
                                            <!-- Garanti Süresi row -->
                                            <tr>
                                                <td class="field-col">Garanti Süresi:</td>
                                                <t t-foreach="vendors_to_show" t-as="vendor">
                                                    <t t-set="vendor_line" t-value="False"/>
                                                    <t t-foreach="vendor.order_line" t-as="line">
                                                        <t t-if="line.tender_line_id and line.tender_line_id.id == tender_line.id">
                                                            <t t-set="vendor_line" t-value="line"/>
                                                        </t>
                                                    </t>
                                                    
                                                    <td class="vendor-col">
                                                        <t t-if="vendor_line">
                                                            <t t-set="has_warranty" t-value="False"/>
                                                            <t t-foreach="vendor_line._fields" t-as="field">
                                                                <t t-if="field == 'warranty_period'">
                                                                    <t t-set="has_warranty" t-value="True"/>
                                                                </t>
                                                            </t>
                                                            <t t-if="has_warranty and vendor_line.warranty_period">
                                                                <span t-esc="vendor_line.warranty_period"/> Ay
                                                            </t>
                                                            <span t-else="">-</span>
                                                        </t>
                                                        <span t-else="">-</span>
                                                    </td>
                                                </t>
                                            </tr>
                                            
                                            <!-- Ürün Seçim row -->
                                            <tr>
                                                <td class="field-col">Seçim:</td>
                                                
                                                <!-- First collect all non-zero prices for this product -->
                                                <t t-set="product_amounts" t-value="[]"/>
                                                <t t-foreach="vendors_to_show" t-as="vendor_collect">
                                                    <t t-set="vendor_line_collect" t-value="False"/>
                                                    <t t-foreach="vendor_collect.order_line" t-as="line_collect">
                                                        <t t-if="line_collect.tender_line_id and line_collect.tender_line_id.id == tender_line.id">
                                                            <t t-set="vendor_line_collect" t-value="line_collect"/>
                                                        </t>
                                                    </t>
                                                    <t t-if="vendor_line_collect and vendor_line_collect.price_subtotal > 0">
                                                        <t t-set="product_amounts" t-value="product_amounts + [vendor_line_collect.price_subtotal]"/>
                                                    </t>
                                                </t>
                                                <!-- Find minimum non-zero amount for this product -->
                                                <t t-set="min_product_amount" t-value="min(product_amounts) if product_amounts else 0"/>
                                                
                                                <t t-foreach="vendors_to_show" t-as="vendor">
                                                    <t t-set="vendor_line" t-value="False"/>
                                                    <t t-foreach="vendor.order_line" t-as="line">
                                                        <t t-if="line.tender_line_id and line.tender_line_id.id == tender_line.id">
                                                            <t t-set="vendor_line" t-value="line"/>
                                                        </t>
                                                    </t>
                                                    
                                                    <td class="vendor-col text-center">
                                                        <t t-if="vendor_line">
                                                            <!-- Auto-check if this vendor has the lowest non-zero price for this product -->
                                                            <t t-if="vendor_line.price_subtotal > 0 and vendor_line.price_subtotal == min_product_amount">
                                                                <input type="checkbox" name="vendor_product_selection" t-att-value="str(vendor.id) + '_' + str(tender_line.id)" class="form-check-input" checked="checked"/>
                                                            </t>
                                                            <t t-else="">
                                                                <input type="checkbox" name="vendor_product_selection" t-att-value="str(vendor.id) + '_' + str(tender_line.id)" class="form-check-input"/>
                                                            </t>
                                                        </t>
                                                        <span t-else="">-</span>
                                                    </td>
                                                </t>
                                                
                                            </tr>
                                            
                                        </t>
                                    </t>
                                    
                                    <!-- Total rows -->
                                    <tr class="table-active">
                                        <td rowspan="3" class="product-col"><strong>TOPLAM</strong></td>
                                        <td class="field-col">Tutar:</td>
                                        
                                        <!-- First collect all non-zero total amounts -->
                                        <t t-set="total_amounts" t-value="[]"/>
                                        <t t-set="vendors_to_collect" t-value="vendors_to_show"/>
                                        
                                        <t t-foreach="vendors_to_collect" t-as="vendor_collect">
                                            <t t-set="vendor_total" t-value="0"/>
                                            <t t-foreach="vendor_collect.order_line" t-as="line">
                                                <t t-if="line.tender_line_id and not line.display_type">
                                                    <t t-set="vendor_total" t-value="vendor_total + line.price_subtotal"/>
                                                </t>
                                            </t>
                                            <t t-if="vendor_total > 0">
                                                <t t-set="total_amounts" t-value="total_amounts + [vendor_total]"/>
                                            </t>
                                        </t>
                                        <!-- Find minimum non-zero total amount -->
                                        <t t-set="min_total_amount" t-value="min(total_amounts) if total_amounts else 0"/>
                                        
                                        <t t-foreach="vendors_to_show" t-as="vendor">
                                            <!-- Calculate total amount (Tutar) -->
                                            <t t-set="total_amount" t-value="0"/>
                                            <t t-foreach="vendor.order_line" t-as="line">
                                                <t t-if="line.tender_line_id and not line.display_type">
                                                    <t t-set="total_amount" t-value="total_amount + line.price_subtotal"/>
                                                </t>
                                            </t>
                                            
                                            <td class="vendor-col">
                                                <!-- Bold if this is the lowest non-zero total amount -->
                                                <strong t-if="total_amount > 0 and total_amount == min_total_amount">
                                                    <span t-esc="total_amount" t-options='{"widget": "monetary", "display_currency": vendor.currency_id}'/>
                                                </strong>
                                                <span t-else="" t-esc="total_amount" t-options='{"widget": "monetary", "display_currency": vendor.currency_id}'/>
                                            </td>
                                        </t>
                                    </tr>
                                    
                                    <tr class="table-active">
                                        <td class="field-col">NPV:</td>
                                        
                                        <!-- First collect all non-zero total NPV values -->
                                        <t t-set="total_npvs" t-value="[]"/>
                                        <t t-set="vendors_to_collect" t-value="vendors_to_show"/>
                                        
                                        <t t-foreach="vendors_to_collect" t-as="vendor_collect">
                                            <t t-set="has_npv" t-value="False"/>
                                            <t t-set="vendor_total_npv" t-value="0"/>
                                            <t t-foreach="vendor_collect.order_line" t-as="line">
                                                <t t-if="line.tender_line_id and not line.display_type">
                                                    <t t-foreach="line._fields" t-as="field">
                                                        <t t-if="field == 'npv_value'">
                                                            <t t-set="has_npv" t-value="True"/>
                                                            <t t-set="vendor_total_npv" t-value="vendor_total_npv + line.npv_value if line.npv_value else vendor_total_npv"/>
                                                        </t>
                                                    </t>
                                                </t>
                                            </t>
                                            <t t-if="has_npv and vendor_total_npv > 0">
                                                <t t-set="total_npvs" t-value="total_npvs + [vendor_total_npv]"/>
                                            </t>
                                        </t>
                                        <!-- Find minimum non-zero total NPV -->
                                        <t t-set="min_total_npv" t-value="min(total_npvs) if total_npvs else 0"/>
                                        
                                        
                                        <t t-foreach="vendors_to_show" t-as="vendor">
                                            <!-- Calculate total NPV -->
                                            <t t-set="has_npv" t-value="False"/>
                                            <t t-set="total_npv" t-value="0"/>
                                            <t t-foreach="vendor.order_line" t-as="line">
                                                <t t-if="line.tender_line_id and not line.display_type">
                                                    <t t-foreach="line._fields" t-as="field">
                                                        <t t-if="field == 'npv_value'">
                                                            <t t-set="has_npv" t-value="True"/>
                                                            <t t-set="total_npv" t-value="total_npv + line.npv_value if line.npv_value else total_npv"/>
                                                        </t>
                                                    </t>
                                                </t>
                                            </t>
                                            
                                            <td class="vendor-col">
                                                <t t-if="has_npv">
                                                    <!-- Bold if this is the lowest non-zero total NPV -->
                                                    <strong t-if="total_npv > 0 and total_npv == min_total_npv">
                                                        <span t-esc="total_npv" t-options='{"widget": "monetary", "display_currency": vendor.currency_id}'/>
                                                    </strong>
                                                    <span t-else="" t-esc="total_npv" t-options='{"widget": "monetary", "display_currency": vendor.currency_id}'/>
                                                </t>
                                                <span t-else="">-</span>
                                            </td>
                                        </t>
                                    </tr>
                                    
                                    <!-- Total Selection row -->
                                    <tr class="table-active">
                                        <td class="field-col">Seçim:</td>
                                        
                                        
                                        <t t-foreach="vendors_to_show" t-as="vendor">
                                            <!-- Calculate total amount for this vendor -->
                                            <t t-set="total_amount" t-value="0"/>
                                            <t t-foreach="vendor.order_line" t-as="line">
                                                <t t-if="line.tender_line_id and not line.display_type">
                                                    <t t-set="total_amount" t-value="total_amount + line.price_subtotal"/>
                                                </t>
                                            </t>
                                            
                                            <td class="vendor-col text-center">
                                                <!-- Auto-check if this vendor has the lowest non-zero total amount -->
                                                <t t-if="total_amount > 0 and total_amount == min_total_amount">
                                                    <input type="checkbox" name="vendor_total_selection" t-att-value="vendor.id" class="form-check-input" checked="checked"/>
                                                </t>
                                                <t t-else="">
                                                    <input type="checkbox" name="vendor_total_selection" t-att-value="vendor.id" class="form-check-input"/>
                                                </t>
                                            </td>
                                        </t>
                                        
                                    </tr>
                                </tbody>
                            </table>
                    </div>
                </t>
            </t>
        </template>
        
        <!-- Report action -->
        <record id="action_report_vendor_comparison" model="ir.actions.report">
            <field name="name">Tedarikçi Karşılaştırma</field>
            <field name="model">ak.tender</field>
            <field name="report_type">qweb-html</field>
            <field name="report_name">ak_tender.report_vendor_comparison</field>
            <field name="report_file">ak_tender.report_vendor_comparison</field>
            <field name="binding_model_id" ref="model_ak_tender"/>
            <field name="binding_type">report</field>
        </record>
    </data>
</odoo>