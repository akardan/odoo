<odoo>
    <data>
        <record id="ak_tender_view_form" model="ir.ui.view">
            <field name="name">ak.tender.form</field>
            <field name="model">ak.tender</field>
            <field name="arch" type="xml">
                <form string="İhale">
                    <header>
                        <widget name="workflow_button_group"/>
                        <field name="workflow_current_state_id" widget="statusbar" options="{'clickable': '0'}"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_purchase_orders"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-shopping-cart"
                                string="SAS'lar"
                                help="Bu ihaleden oluşturulan Satın Alma Siparişleri"
                                invisible="purchase_order_count == 0"
                            />
                            <button name="action_view_offers"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-balance-scale"
                                string="Teklifler"
                                help="Tedarikçilerden gelen teklifler (SAT)"
                            />
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="İhale Adı" />
                            </h1>
                            <field name="code" readonly="1" class="oe_inline"/>
                        </div>
                        <group>
                            <group>
                                <field name="tender_type" />
                                <field name="start_date" />
                                <field name="end_date" />
                            </group>
                            <group>
                                <field name="erp_pr_id" placeholder="ERP SAT No" />
                                <field name="erp_company_code" placeholder="ERP Şirket Kodu"/>
                                <field name="erp_plant_code" placeholder="ERP Tesis Kodu"/>
                                <field name="workflow_definition_id" options="{'no_create': True}" domain="[('model_name', '=', 'ak.tender')]"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="İhale Kalemleri" name="tender_lines">
                                <field name="tender_lines" nolabel="1">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="product_id" />
                                        <field name="name" />
                                        <field name="quantity" />
                                        <field name="uom_id" />
                                        <field name="required_delivery_date" />
                                    </list>
                                    <form>
                                        <group>
                                            <field name="product_id"/>
                                            <field name="quantity"/>
                                            <field name="uom_id"/>
                                            <field name="required_delivery_date"/>
                                        </group>
                                    </form>
                                </field>
                                <p class="oe_grey">
                                    **Önemli:** İhale başlatılmadan önce en az bir ihale kalemi tanımlanmalıdır.
                                </p>
                            </page>
                            <page string="Açıklama ve Ekler" name="description_attachments">
                                <field name="description" widget="html" nolabel="1"/>
                            </page>
                            <page string="Davetli Tedarikçiler" name="invited_partners">
                                <field name="invited_partners" widget="many2many_tags" nolabel="1"/>
                                <p class="oe_grey">
                                    **Önemli:** İhale başlatılmadan önce en az bir tedarikçi davet edilmelidir.
                                </p>
                            </page>
                            <page string="Teklif Sonuçları &amp; Değerlendirme" name="tender_results_evaluation">
                                <field name="purchase_order_ids" nolabel="1" context="{'default_tender_id': id, 'default_state': 'draft'}">
                                    <list>
                                        <field name="partner_id" domain="[('id', 'in', parent.invited_partners)]"/>
                                        <field name="date_order"/>
                                        <field name="tender_round"/>
                                        <field name="tender_offer_status"/>
                                        <field name="amount_total" sum="Toplam Teklifler"/>
                                        <field name="state"/>
                                    </list>
                                </field>
                                <group class="oe_subtotal_footer oe_right">
                                    <field name="target_price" widget="monetary" options="{'currency_field': 'currency_id'}"
                                           readonly="[('workflow_current_state_id.code', 'not in', ['first_tender_round', 'target_price_set'])]"/>
                                    <field name="winning_order_id" readonly="1" />
                                </group>
                                <p class="oe_grey">
                                    Bu sayfa, tedarikçilerden gelen tekliflerin otomatik olarak işleneceği ve karşılaştırılacağı alan olacaktır. (Bu prototipte manuel giriş için açılmıştır, gerçek sistemde portal entegrasyonu ile dolacaktır.) Teklif turu bilgisi, hangi teklifin hangi aşamada geldiğini belirtir.
                                </p>
                            </page>
                            <page string="Transition History">
                                <field name="transition_history_ids" readonly="1">
                                    <list>
                                        <field name="transition_id"/>
                                        <field name="from_state_id"/>
                                        <field name="to_state_id"/>
                                        <field name="user_id"/>
                                        <field name="create_date" string="Date"/>
                                        <field name="comment"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="ak_tender_view_list" model="ir.ui.view">
            <field name="name">ak.tender.list</field>
            <field name="model">ak.tender</field>
            <field name="arch" type="xml">
                <list string="İLKOis İhaleleri" decoration-success="workflow_current_state_id.code in ('approved', 'done')" decoration-info="workflow_current_state_id.code in ('first_tender_round', 'second_tender_round', 'evaluation')" decoration-danger="workflow_current_state_id.code == 'cancel'">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="erp_pr_id"/>
                    <field name="tender_type"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="workflow_current_state_id" widget="badge"/>
                </list>
            </field>
        </record>

        <record id="ak_tender_view_search" model="ir.ui.view">
            <field name="name">ak.tender.search</field>
            <field name="model">ak.tender</field>
            <field name="arch" type="xml">
                <search string="İhale Ara">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="erp_pr_id"/>
                    <field name="tender_type"/>
                    <field name="workflow_current_state_id"/>
                    <filter name="filter_draft" string="Taslak İhaleler" domain="[('workflow_current_state_id.code', '=', 'draft')]"/>
                    <filter name="filter_first_round" string="1. Tur Teklif Toplama" domain="[('workflow_current_state_id.code', '=', 'first_tender_round')]"/>
                    <filter name="filter_target_price_set" string="Hedef Fiyat Belirlendi" domain="[('workflow_current_state_id.code', '=', 'target_price_set')]"/>
                    <filter name="filter_second_round" string="2. Tur Teklif Toplama" domain="[('workflow_current_state_id.code', '=', 'second_tender_round')]"/>
                    <filter name="filter_evaluation" string="Değerlendirmede" domain="[('workflow_current_state_id.code', '=', 'evaluation')]"/>
                    <filter name="filter_approved" string="Onaylanmış İhaleler" domain="[('workflow_current_state_id.code', '=', 'approved')]"/>
                    <filter name="filter_done" string="Tamamlanmış İhaleler" domain="[('workflow_current_state_id.code', '=', 'done')]"/>
                    <separator/>
                    <group expand="0" string="Grup Bazında">
                        <filter name="groupby_state" string="Durum" context="{'group_by':'workflow_current_state_id'}"/>
                        <filter name="groupby_tender_type" string="İhale Tipi" context="{'group_by':'tender_type'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="ak_tender_view_kanban" model="ir.ui.view">
            <field name="name">ak.tender.kanban</field>
            <field name="model">ak.tender</field>
            <field name="arch" type="xml">
                <kanban default_group_by="workflow_current_state_id" class="o_kanban_dashboard o_tender_kanban" edit="false" sample="1">
                    <field name="workflow_current_state_id"/>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="tender_type"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="erp_pr_id"/>
                    <field name="invited_partners"/>
                    <field name="currency_id"/>
                    <field name="target_price"/>
                    <field name="winning_order_id"/>
                    <field name="purchase_order_count"/>
                    <field name="offer_count"/>
                    <field name="create_date"/>
                    <field name="activity_ids"/>
                    <field name="activity_state"/>
                    
                    <progressbar field="activity_state" colors='{"overdue": "danger", "today": "warning", "planned": "success"}'/>
                    
                    <templates>
                        <t t-name="menu">
                            <div class="o_kanban_tender_card_manage_pane">
                                <a role="menuitem" type="edit" class="dropdown-item">
                                    <i class="fa fa-fw fa-edit"/> Düzenle
                                </a>
                                <a role="menuitem" name="action_view_offers" type="object" class="dropdown-item">
                                    <i class="fa fa-fw fa-eye"/> Teklifleri Görüntüle
                                </a>
                                <t t-if="record.purchase_order_count.raw_value > 0">
                                    <a role="menuitem" name="action_view_purchase_orders" type="object" class="dropdown-item">
                                        <i class="fa fa-fw fa-shopping-cart"/> Satın Alma Siparişleri
                                    </a>
                                </t>
                                <div class="dropdown-divider"/>
                                <a role="menuitem" type="delete" class="dropdown-item">
                                    <i class="fa fa-fw fa-trash"/> Sil
                                </a>
                            </div>
                        </t>
                        
                        <t t-name="card">
                            <!-- Ribbon for urgent tenders -->
                            <widget name="web_ribbon" title="Acil" bg_color="text-bg-danger"
                                    t-if="record.end_date.raw_value and (new Date(record.end_date.raw_value) - new Date()) / (1000 * 60 * 60 * 24) &lt; 3 and record.workflow_current_state_id.raw_value and !['done', 'cancel', 'approved'].includes(record.workflow_current_state_id.code)"/>
                            
                            <!-- Ribbon for completed tenders -->
                            <widget name="web_ribbon" title="Tamamlandı" bg_color="text-bg-success"
                                    t-if="record.workflow_current_state_id.raw_value and record.workflow_current_state_id.code == 'done'"/>
                            
                            <!-- Ribbon for approved tenders -->
                            <widget name="web_ribbon" title="Onaylandı" bg_color="text-bg-info"
                                    t-if="record.workflow_current_state_id.raw_value and record.workflow_current_state_id.code == 'approved'"/>

                            <!-- Tender Title and Code -->
                            <field name="name" class="fw-bold fs-4 me-auto ms-1"/>
                            <div class="mb-3"></div>
                            <div class="mb-2 ms-1">
                                <span class="badge bg-light text-dark border me-2">
                                    <i class="fa fa-barcode"/> <field name="code"/>
                                </span>
                                <span t-attf-class="badge #{record.tender_type.raw_value == 'standard' and 'bg-light text-muted border' or record.tender_type.raw_value == 'open_auction' and 'bg-warning bg-opacity-25 text-dark border' or 'bg-info bg-opacity-25 text-dark border'}">
                                    <field name="tender_type"/>
                                </span>
                            </div>

                            <!-- Main Content Area -->
                            <div class="row g-0 mb16 mt-1 ms-2 me-2">
                                <div class="col-12">
                                    <!-- Action buttons removed as they are now handled by the workflow engine in the form view -->
                                    
                                    <!-- Info List - Full Width -->
                                    <!-- SAT Info -->
                                    <div class="d-flex mb-1" t-if="record.erp_pr_id.raw_value">
                                        <span class="me-auto o_form_label">
                                            <i class="fa fa-file-text-o"/> SAT No
                                        </span>
                                        <span class="fw-bold">
                                            <field name="erp_pr_id"/>
                                        </span>
                                    </div>
                                    
                                    <!-- Target Price -->
                                    <div class="d-flex mb-1" t-if="record.target_price.raw_value">
                                        <span class="me-auto o_form_label">
                                            <i class="fa fa-target"/> Hedef Fiyat
                                        </span>
                                        <span class="text-warning fw-bold">
                                            <field name="target_price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                        </span>
                                    </div>
                                    
                                    <!-- End Date -->
                                    <div class="d-flex mb-1" t-if="record.end_date.raw_value">
                                        <span class="me-auto o_form_label">
                                            <i class="fa fa-calendar"/> Bitiş
                                        </span>
                                        <span>
                                            <field name="end_date" widget="datetime" options="{'format': 'dd-MM-yyyy HH:mm'}"/>
                                        </span>
                                    </div>
                                    
                                    <!-- Winning Result -->
                                    <div class="d-flex mb-1" t-if="record.winning_order_id.raw_value">
                                        <span class="me-auto text-success o_form_label">
                                            <i class="fa fa-trophy"/> Kazanan
                                        </span>
                                        <span class="text-success fw-bold">
                                            <field name="winning_order_id" options="{'no_open': True}"/>
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <!-- Progress Bar -->
                            <div class="mb-3 ms-2 me-2">
                                <div class="progress" style="height: 8px;">
                                    <div class="progress-bar"
                                        t-attf-class="progress-bar #{!record.workflow_current_state_id.raw_value ? 'bg-danger bg-opacity-50' :
                                            record.workflow_current_state_id.raw_value[1] == 'Taslak' ? 'bg-secondary bg-opacity-50' :
                                            record.workflow_current_state_id.raw_value[1] == '1. Teklif Toplama' ? 'bg-info bg-opacity-50' :
                                            record.workflow_current_state_id.raw_value[1] == 'Hedef Fiyat Belirlendi' ? 'bg-warning bg-opacity-50' :
                                            record.workflow_current_state_id.raw_value[1] == '2. Teklif Toplama' ? 'bg-primary bg-opacity-50' :
                                            record.workflow_current_state_id.raw_value[1] == 'Değerlendirme' ? 'bg-warning bg-opacity-50' :
                                            record.workflow_current_state_id.raw_value[1] == 'Onaylandı' ? 'bg-success bg-opacity-50' :
                                            record.workflow_current_state_id.raw_value[1] == 'Tamamlandı' ? 'bg-success bg-opacity-50' :
                                            'bg-danger bg-opacity-50'}"
                                        t-attf-style="width: #{!record.workflow_current_state_id.raw_value ? '0' :
                                            record.workflow_current_state_id.raw_value[1] == 'Taslak' ? '12' :
                                            record.workflow_current_state_id.raw_value[1] == '1. Teklif Toplama' ? '25' :
                                            record.workflow_current_state_id.raw_value[1] == 'Hedef Fiyat Belirlendi' ? '37' :
                                            record.workflow_current_state_id.raw_value[1] == '2. Teklif Toplama' ? '50' :
                                            record.workflow_current_state_id.raw_value[1] == 'Değerlendirme' ? '62' :
                                            record.workflow_current_state_id.raw_value[1] == 'Onaylandı' ? '87' :
                                            record.workflow_current_state_id.raw_value[1] == 'Tamamlandı' ? '100' : '0'}%">
                                    </div>
                                </div>
                            </div>

                            <!-- Footer Stats -->
                            <div name="card_content" class="row mt-auto">
                                <a name="action_view_offers" type="object"
                                   class="d-flex flex-column align-items-center col-4 border-end">
                                    <span class="fw-bold text-primary">
                                        <t t-esc="record.invited_partners.raw_value.length"/>
                                    </span>
                                    <span class="text-muted text-truncate mw-100" title="Davet Edilen">Davet Edilen</span>
                                </a>

                                <div class="d-flex flex-column align-items-center col-4 border-end">
                                    <span class="fw-bold text-success">
                                        <field name="offer_count"/>
                                    </span>
                                    <span class="text-muted text-truncate mw-100" title="Teklif Sayısı">Teklif Sayısı</span>
                                </div>
                                
                                <div class="d-flex flex-column align-items-center col-4">
                                    <span class="fw-bold text-warning">
                                        <t t-if="record.target_price.raw_value">
                                            <i class="fa fa-check"/>
                                        </t>
                                        <t t-else="">
                                            <i class="fa fa-minus"/>
                                        </t>
                                    </span>
                                    <span class="text-muted text-truncate mw-100" title="Hedef Fiyat">Hedef Fiyat</span>
                                </div>
                            </div>

                            <!-- Activity indicator at bottom -->
                           <div class="position-absolute bottom-0 end-0 me-2 mb-2">
                               <field name="activity_ids" widget="kanban_activity"/>
                           </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>


        <record id="ak_tender_action" model="ir.actions.act_window">
            <field name="name">İhaleler</field>
            <field name="res_model">ak.tender</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="view_id" ref="ak_tender_view_list"/>
            <field name="views">
                [(ref('ak_tender_view_list'), 'list'),
                 (ref('ak_tender_view_form'), 'form'),
                 (ref('ak_tender_view_kanban'), 'kanban')]
            </field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Yeni bir ihale oluşturun ve satın alma süreçlerinizi dijitalleştirin!
                </p>
            </field>
        </record>

        <menuitem id="ak_tender_menu_root"
                  name="İhaleler"
                  sequence="10"
                  web_icon="ak_tender,static/description/icon.png"/>

        <menuitem id="ak_tender_menu_tender_list"
                  name="Tüm İhaleler"
                  parent="ak_tender_menu_root"
                  action="ak_tender_action"
                  sequence="10"/>

    </data>

</odoo>
