<odoo>
    <data>
        <record id="ak_tender_view_form" model="ir.ui.view">
            <field name="name">ak.tender.form</field>
            <field name="model">ak.tender</field>
            <field name="arch" type="xml">
                <form string="İhale">
                    <header>
                        <widget name="workflow_button_group"/>
                        <field name="workflow_current_state_id" widget="statusbar" options="{'clickable': '0'}"/>
                    </header>
                    <sheet>
                        <!-- Colored header based on tender type -->
                        <div t-attf-class="o_tender_header {{tender_type == 'direct' ? 'o_tender_type_direct' :
                                                            tender_type == 'indirect' ? 'o_tender_type_indirect' :
                                                            tender_type == 'mice' ? 'o_tender_type_mice' :
                                                            tender_type == 'promotion' ? 'o_tender_type_promotion' : ''}}">
                            <field name="tender_type" invisible="1"/>
                        </div>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_add_supplier"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-user-plus"
                                string="Tedarikçi Ekle"
                                help="İhaleye yeni tedarikçiler ekle"
                                invisible="workflow_current_state_id.code in ('approved', 'done', 'cancel')"
                            />
                            <button name="create_purchase_orders_for_suppliers"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-file-text-o"
                                string="Tedarikçiler İçin SAT Oluştur"
                                help="Davetli tedarikçilerin hepsi için satın alma talebi oluştur"
                                invisible="workflow_current_state_id.code in ('approved', 'done', 'cancel')"
                            />
                            <button name="action_view_offers"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-balance-scale"
                                string="Teklif Karşılaştır"
                                help="Tedarikçilerden gelen teklifleri (SAT) karşılaştır"
                            />
                            <button name="action_view_purchase_orders"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-shopping-cart"
                                string="SAS'lar"
                                help="Bu ihaleden oluşturulan Satın Alma Siparişleri"
                                invisible="purchase_order_count == 0"
                            />
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="İhale Adı" />
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="code" readonly="1"/>
                                <field name="tender_type" />
                                <field name="start_date" />
                                <field name="end_date" />
                                <field name="required_delivery_date" />
                            </group>
                            <group>
                                <field name="tender_round" readonly="1"/>
                                <field name="erp_pr_id" placeholder="ERP SAT No" />
                                <field name="erp_company_code" placeholder="ERP Şirket Kodu"/>
                                <field name="erp_plant_code" placeholder="ERP Tesis Kodu"/>
                                <field name="workflow_definition_id" options="{'no_create': True}" domain="[('model_name', '=', 'ak.tender')]"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="İhale Kalemleri" name="tender_lines">
                                <field name="tender_lines" nolabel="1" widget="section_and_note_one2many">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="display_type" column_invisible="True"/>
                                        <field name="product_id"
                                               optional="show"
                                               domain="[('purchase_ok', '=', True)]"
                                               widget="many2one"
                                               placeholder="Type to find a product..."/>
                                        <field name="hotel_partner_id"
                                               optional="show"
                                               widget="many2one"
                                               options="{'no_create': True, 'no_open': True}"
                                               column_invisible="parent.tender_type != 'mice'"
                                               invisible="is_hotel_accommodation != True"/>
                                        <field name="name"/>
                                        <field name="days" column_invisible="parent.tender_type != 'mice'" />
                                        <field name="quantity"/>
                                        <field name="uom_id"/>
                                        <field name="required_delivery_date" />
                                        <field name="target_price" widget="monetary" options="{'currency_field': 'currency_id'}" />
                                        <button name="action_view_purchase_history"
                                                type="object"
                                                icon="fa-history"
                                                class="btn-link"/>
                                        <control>
                                            <create string="Ürün Ekle" context="{'default_display_type': 'product'}"/>
                                            <create string="Bölüm Ekle" context="{'default_display_type': 'line_section'}"/>
                                            <create string="Not Ekle" context="{'default_display_type': 'line_note'}"/>
                                        </control>
                                    </list>
                                    <form>
                                        <field name="sequence" invisible="1"/>
                                        <field name="display_type" invisible="1"/>
                                        <group invisible="display_type">
                                            <group>
                                                <field name="product_id" required="not display_type"/>
                                                <field name="days" invisible="parent.tender_type != 'mice'"/>
                                                <field name="quantity"/>
                                                <field name="uom_id"/>
                                                <field name="required_delivery_date"/>
                                                <field name="target_price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                                <button name="action_view_purchase_history"
                                                        type="object"
                                                        icon="fa-history"
                                                        class="btn-link"/>
                                            </group>
                                        </group>
                                        
                                        <!-- İhale Bilgileri grubu -->
                                        <group string="İhale Bilgileri" name="tender_info">
                                            <field name="is_hotel_accommodation"/>
                                        </group>
                                        
                                        <!-- Otel seçimi için grup -->
                                        <group invisible="is_hotel_accommodation != True">
                                            <field name="hotel_partner_id"
                                                   options="{'no_create': True, 'no_open': True}"
                                                   required="is_hotel_accommodation == True"/>
                                        </group>
                                        <notebook colspan="4" name="description">
                                            <page string="Description" name="order_description" invisible="display_type">
                                                <field name="name" />
                                            </page>
                                            <page string="Section" name="order_section" invisible="display_type != 'line_section'">
                                                <field name="name" />
                                            </page>
                                            <page string="Note" name="order_note" invisible="display_type != 'line_note'">
                                                <field name="name" />
                                            </page>
                                        </notebook>
                                    </form>
                                </field>
                                <div class="oe_right mb-2">
                                    <button name="action_add_from_template" string="Şablondan Ekle" type="object" class="btn btn-secondary"
                                        invisible="not workflow_current_state_id.is_initial"/>
                                </div>
                                <p class="oe_grey">
                                    **Önemli:** İhale başlatılmadan önce en az bir ihale kalemi tanımlanmalıdır.
                                </p>
                            </page>
                            <page string="Açıklama ve Ekler" name="description_attachments">
                                <field name="description" widget="html" nolabel="1"/>
                            </page>
                            <page string="Davetli Tedarikçiler" name="invited_partners">
                                <field name="invited_partners" widget="many2many_tags" nolabel="1"/>
                                <p class="oe_grey">
                                    **Önemli:** İhale başlatılmadan önce en az bir tedarikçi davet edilmelidir.
                                </p>
                            </page>
                            <page string="Teklif Sonuçları &amp; Değerlendirme" name="tender_results_evaluation">
                                <field name="purchase_order_ids" nolabel="1" context="{'default_tender_id': id, 'default_state': 'draft'}">
                                    <list>
                                        <field name="partner_id" domain="[('id', 'in', parent.invited_partners)]"/>
                                        <field name="date_order"/>
                                        <field name="tender_round"/>
                                        <field name="amount_total"/>
                                        <field name="total_npv"/>
                                        <field name="state"/>
                                    </list>
                                </field>
                                <group class="oe_subtotal_footer oe_right">
                                    <field name="target_price" widget="monetary" options="{'currency_field': 'currency_id'}"
                                           readonly="[('workflow_current_state_id.code', 'not in', ['first_tender_round', 'target_price_set'])]"/>
                                    <field name="winning_order_id" readonly="1" />
                                </group>
                                
                                <!-- Direkt İhale Özellikleri -->
                                <div invisible="tender_type != 'direct'">
                                    <h3 class="mt-3 mb-2">Direkt İhale Özellikleri</h3>
                                    <div class="alert alert-info">
                                        <strong>Direkt İhale Kuralları:</strong>
                                        <ul>
                                            <li>Tüm ürünlerin ERP kodu olmalıdır</li>
                                            <li>Tedarik süresi maksimum izin verilen değeri aşamaz</li>
                                            <li>Muadil ürün kabul edilmez</li>
                                        </ul>
                                    </div>
                                </div>
                                
                                <!-- Endirekt İhale Özellikleri -->
                                <div invisible="tender_type != 'indirect'">
                                    <h3 class="mt-3 mb-2">Endirekt İhale Özellikleri</h3>
                                    <div class="alert alert-success">
                                        <strong>Endirekt İhale Özellikleri:</strong>
                                        <ul>
                                            <li>Toplu satın alma optimizasyonu</li>
                                            <li>Muadil ürün teklifleri (ayarlara bağlı olarak)</li>
                                            <li>Acil talep desteği</li>
                                        </ul>
                                    </div>
                                    
                                    <!-- Toplu Satın Alma Bilgileri -->
                                    <div invisible="is_bulk_purchase == False">
                                        <h4 class="mt-3 mb-2">Toplu Satın Alma Bilgileri</h4>
                                        <group>
                                            <field name="is_bulk_purchase" invisible="1"/>
                                            <field name="bulk_purchase_count" string="Birleştirilen SAT Sayısı"/>
                                            <field name="related_pr_ids" string="İlişkili SAT Numaraları"/>
                                        </group>
                                    </div>
                                    
                                    <!-- Acil Talep Bilgileri -->
                                    <div>
                                        <h4 class="mt-3 mb-2">Acil Talep</h4>
                                        <group>
                                            <field name="is_urgent"/>
                                            <field name="urgent_deadline" invisible="is_urgent == False" required="is_urgent == True"/>
                                            <field name="urgent_reason" invisible="is_urgent == False" required="is_urgent == True" placeholder="Aciliyet nedenini açıklayın..."/>
                                        </group>
                                    </div>
                                </div>
                                
                                <!-- MICE İhale Özellikleri -->
                                <div invisible="tender_type != 'mice'">
                                    <h3 class="mt-3 mb-2">MICE İhale Özellikleri</h3>
                                    <div class="alert alert-primary">
                                        <strong>MICE İhale Özellikleri:</strong>
                                        <ul>
                                            <li>Hizmet kategorisi şablonları</li>
                                            <li>Şablon değişiklik kısıtlamaları</li>
                                            <li>Coğrafi tedarikçi filtreleme</li>
                                        </ul>
                                    </div>
                                    
                                    <!-- Şablon Bilgileri -->
                                    <div>
                                        <h4 class="mt-3 mb-2">Şablon Bilgileri</h4>
                                        <group>
                                            <field name="tender_template_id" domain="[('tender_type', '=', tender_type)]"/>
                                        </group>
                                    </div>
                                    
                                    <!-- Coğrafi Bilgiler -->
                                    <div>
                                        <h4 class="mt-3 mb-2">Coğrafi Bilgiler</h4>
                                        <group>
                                            <field name="country_id" options="{'no_create': True}"/>
                                            <field name="state_id" options="{'no_create': True}" domain="[('country_id', '=', country_id)]"/>
                                            <field name="city"/>
                                        </group>
                                    </div>
                                </div>
                                
                                <!-- Promosyon İhale Özellikleri -->
                                <div invisible="tender_type != 'promotion'">
                                    <h3 class="mt-3 mb-2">Promosyon İhale Özellikleri</h3>
                                    <div class="alert alert-warning">
                                        <strong>Promosyon İhale Özellikleri:</strong>
                                        <ul>
                                            <li>Toplu satın alma optimizasyonu</li>
                                            <li>Acil talep desteği</li>
                                            <li>Ekonomik veri entegrasyonu</li>
                                        </ul>
                                    </div>
                                    
                                    <!-- Toplu Satın Alma Bilgileri -->
                                    <div invisible="is_bulk_purchase == False">
                                        <h4 class="mt-3 mb-2">Toplu Satın Alma Bilgileri</h4>
                                        <group>
                                            <field name="is_bulk_purchase" invisible="1"/>
                                            <field name="bulk_purchase_count" string="Birleştirilen SAT Sayısı"/>
                                            <field name="related_pr_ids" string="İlişkili SAT Numaraları"/>
                                        </group>
                                    </div>
                                    
                                    <!-- Acil Talep Bilgileri -->
                                    <div>
                                        <h4 class="mt-3 mb-2">Acil Talep</h4>
                                        <group>
                                            <field name="is_urgent"/>
                                            <field name="urgent_deadline" invisible="is_urgent == False" required="is_urgent == True"/>
                                            <field name="urgent_reason" invisible="is_urgent == False" required="is_urgent == True" placeholder="Aciliyet nedenini açıklayın..."/>
                                        </group>
                                    </div>
                                    
                                    <!-- Ekonomik Veri Entegrasyonu -->
                                    <div>
                                        <h4 class="mt-3 mb-2">Ekonomik Veri Entegrasyonu</h4>
                                        <group>
                                            <field name="use_economic_data"/>
                                            <field name="economic_data_source" invisible="use_economic_data == False" required="use_economic_data == True"/>
                                            <field name="exchange_rate_date" invisible="use_economic_data == False" required="use_economic_data == True"/>
                                            <field name="inflation_rate" invisible="use_economic_data == False" required="use_economic_data == True"/>
                                            <field name="economic_notes" invisible="use_economic_data == False" placeholder="Ekonomik değerlendirme notları..."/>
                                        </group>
                                        <div invisible="use_economic_data == False">
                                            <button name="action_fetch_economic_data" string="Ekonomik Verileri Güncelle" type="object" class="btn btn-primary"
                                                    invisible="use_economic_data == False or economic_data_source == 'manual'"/>
                                        </div>
                                        <div class="alert alert-info" invisible="use_economic_data == False">
                                            <p><strong>Bilgi:</strong> Ekonomik veri entegrasyonu, ihale değerlendirmesinde döviz kurları ve enflasyon gibi ekonomik faktörleri dikkate almanızı sağlar.</p>
                                            <p>Bu özellik, özellikle uzun vadeli promosyon ihalelerinde fiyat değişimlerini değerlendirmek için kullanışlıdır.</p>
                                        </div>
                                    </div>
                                </div>
                                
                                <p class="oe_grey">
                                    Bu sayfa, tedarikçilerden gelen tekliflerin otomatik olarak işleneceği ve karşılaştırılacağı alan olacaktır. (Bu prototipte manuel giriş için açılmıştır, gerçek sistemde portal entegrasyonu ile dolacaktır.) Teklif turu bilgisi, hangi teklifin hangi aşamada geldiğini belirtir.
                                </p>
                            </page>
                            <page string="Transition History">
                                <field name="transition_history_ids" readonly="1">
                                    <list>
                                        <field name="transition_id"/>
                                        <field name="from_state_id"/>
                                        <field name="to_state_id"/>
                                        <field name="user_id"/>
                                        <field name="create_date" string="Date"/>
                                        <field name="comment"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="ak_tender_view_list" model="ir.ui.view">
            <field name="name">ak.tender.list</field>
            <field name="model">ak.tender</field>
            <field name="arch" type="xml">
                <list string="İhaleler"
                      decoration-success="workflow_current_state_id.code in ('approved', 'done')"
                      decoration-info="workflow_current_state_id.code in ('first_tender_round', 'second_tender_round', 'evaluation') or tender_type == 'mice'"
                      decoration-danger="workflow_current_state_id.code == 'cancel'"
                      decoration-primary="tender_type == 'direct'"
                      decoration-warning="tender_type == 'promotion'">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="erp_pr_id"/>
                    <field name="tender_type" widget="badge"
                           decoration-primary="tender_type == 'direct'"
                           decoration-success="tender_type == 'indirect'"
                           decoration-warning="tender_type == 'promotion'"
                           decoration-info="tender_type == 'mice'"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="workflow_current_state_id" widget="badge"/>
                    <field name="is_urgent" widget="boolean_toggle"/>
                    <field name="use_economic_data" widget="boolean_toggle" optional="hide"/>
                    <field name="economic_data_source" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="ak_tender_view_search" model="ir.ui.view">
            <field name="name">ak.tender.search</field>
            <field name="model">ak.tender</field>
            <field name="arch" type="xml">
                <search string="İhale Ara">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="erp_pr_id"/>
                    <field name="tender_type"/>
                    <field name="workflow_current_state_id"/>
                    <filter name="filter_draft" string="Taslak İhaleler" domain="[('workflow_current_state_id.code', '=', 'draft')]"/>
                    <filter name="filter_first_round" string="1. Tur Teklif Toplama" domain="[('workflow_current_state_id.code', '=', 'first_tender_round')]"/>
                    <filter name="filter_target_price_set" string="Hedef Fiyat Belirlendi" domain="[('workflow_current_state_id.code', '=', 'target_price_set')]"/>
                    <filter name="filter_second_round" string="2. Tur Teklif Toplama" domain="[('workflow_current_state_id.code', '=', 'second_tender_round')]"/>
                    <filter name="filter_evaluation" string="Değerlendirmede" domain="[('workflow_current_state_id.code', '=', 'evaluation')]"/>
                    <filter name="filter_approved" string="Onaylanmış İhaleler" domain="[('workflow_current_state_id.code', '=', 'approved')]"/>
                    <filter name="filter_done" string="Tamamlanmış İhaleler" domain="[('workflow_current_state_id.code', '=', 'done')]"/>
                    <separator/>
                    <filter name="filter_urgent" string="Acil Talepler" domain="[('is_urgent', '=', True)]"/>
                    <filter name="filter_economic_data" string="Ekonomik Veri Kullanan" domain="[('use_economic_data', '=', True)]"/>
                    <separator/>
                    <group expand="0" string="Grup Bazında">
                        <filter name="groupby_state" string="Durum" context="{'group_by':'workflow_current_state_id'}"/>
                        <filter name="groupby_tender_type" string="İhale Tipi" context="{'group_by':'tender_type'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="ak_tender_view_kanban" model="ir.ui.view">
            <field name="name">ak.tender.kanban</field>
            <field name="model">ak.tender</field>
            <field name="arch" type="xml">
                <kanban default_group_by="workflow_current_state_id" class="o_kanban_dashboard o_tender_kanban" edit="false" sample="1">
                    <field name="id"/>
                    <field name="workflow_current_state_id"/>
                    <field name="workflow_state"/>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="tender_type"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="erp_pr_id"/>
                    <field name="invited_partners"/>
                    <field name="currency_id"/>
                    <field name="target_price"/>
                    <field name="winning_order_id"/>
                    <field name="purchase_order_count"/>
                    <field name="offer_count"/>
                    <field name="create_date"/>
                    <field name="activity_ids"/>
                    <field name="activity_state"/>
                    <field name="is_urgent"/>
                    <field name="urgent_deadline"/>
                    
                    <progressbar field="activity_state" colors='{"overdue": "danger", "today": "warning", "planned": "success"}'/>
                    
                    <templates>
                        <t t-name="menu">
                            <div class="o_kanban_tender_card_manage_pane">
                                <a role="menuitem" type="edit" class="dropdown-item">
                                    <i class="fa fa-fw fa-edit"/> Düzenle
                                </a>
                                <a role="menuitem" name="action_view_offers" type="object" class="dropdown-item">
                                    <i class="fa fa-fw fa-eye"/> Teklifleri Görüntüle
                                </a>
                                <t t-if="record.purchase_order_count.raw_value > 0">
                                    <a role="menuitem" name="action_view_purchase_orders" type="object" class="dropdown-item">
                                        <i class="fa fa-fw fa-shopping-cart"/> Satın Alma Siparişleri
                                    </a>
                                </t>
                                <div class="dropdown-divider"/>
                                <a role="menuitem" type="delete" class="dropdown-item">
                                    <i class="fa fa-fw fa-trash"/> Sil
                                </a>
                            </div>
                        </t>
                        
                        <t t-name="card">
                            <!-- Add CSS class based on tender type -->
                            <t t-set="tender_type_class" t-value="'o_tender_type_' + record.tender_type.raw_value"/>
                            <!-- Ribbon for urgent tenders -->
                            <widget name="web_ribbon" title="Acil" bg_color="text-bg-danger"
                                    t-if="record.is_urgent.raw_value"/>
                            
                            <!-- Ribbon for completed tenders -->
                            <widget name="web_ribbon" title="Tamamlandı" bg_color="text-bg-success"
                                    t-if="record.workflow_current_state_id.raw_value and record.workflow_state.raw_value == 'done'"/>
                            
                            <!-- Ribbon for approved tenders -->
                            <widget name="web_ribbon" title="Onaylandı" bg_color="text-bg-info"
                                    t-if="record.workflow_current_state_id.raw_value and record.workflow_state.raw_value == 'approved'"/>

                            <!-- Tender Title and Code -->
                            <field name="name" class="fw-bold fs-4 me-auto ms-1"/>
                            <div class="mb-3"></div>
                            <div class="mb-2 ms-1">
                                <span class="badge bg-light text-dark border me-2">
                                    <i class="fa fa-barcode"/> <field name="code"/>
                                </span>
                                <span t-attf-class="badge #{
                                    record.tender_type.raw_value == 'direct' and 'bg-primary bg-opacity-25 text-primary border border-primary' or
                                    record.tender_type.raw_value == 'indirect' and 'bg-success bg-opacity-25 text-success border border-success' or
                                    record.tender_type.raw_value == 'mice' and 'bg-purple bg-opacity-25 text-purple border border-purple' or
                                    record.tender_type.raw_value == 'promotion' and 'bg-warning bg-opacity-25 text-warning border border-warning' or
                                    'bg-info bg-opacity-25 text-dark border'}">
                                    <i t-attf-class="fa #{
                                        record.tender_type.raw_value == 'direct' and 'fa-shopping-cart' or
                                        record.tender_type.raw_value == 'indirect' and 'fa-cubes' or
                                        record.tender_type.raw_value == 'mice' and 'fa-users' or
                                        record.tender_type.raw_value == 'promotion' and 'fa-gift' or
                                        'fa-gavel'} me-1"></i>
                                    <field name="tender_type"/>
                                </span>
                            </div>

                            <!-- Main Content Area -->
                            <div t-attf-class="row g-0 mb16 mt-1 ms-2 me-2 {{tender_type_class}}">
                                <div class="col-12">
                                    <!-- Action buttons removed as they are now handled by the workflow engine in the form view -->
                                    
                                    <!-- Info List - Full Width -->
                                    <!-- SAT Info -->
                                    <div class="d-flex mb-1" t-if="record.erp_pr_id.raw_value">
                                        <span class="me-auto o_form_label">
                                            <i class="fa fa-file-text-o"/> SAT No
                                        </span>
                                        <span class="fw-bold">
                                            <field name="erp_pr_id"/>
                                        </span>
                                    </div>
                                    
                                    <!-- Target Price -->
                                    <div class="d-flex mb-1" t-if="record.target_price.raw_value">
                                        <span class="me-auto o_form_label">
                                            <i class="fa fa-target"/> Hedef Fiyat
                                        </span>
                                        <span class="text-warning fw-bold">
                                            <field name="target_price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                        </span>
                                    </div>
                                    
                                    <!-- End Date -->
                                    <div class="d-flex mb-1" t-if="record.end_date.raw_value">
                                        <span class="me-auto o_form_label">
                                            <i class="fa fa-calendar"/> Bitiş
                                        </span>
                                        <span>
                                            <field name="end_date" widget="datetime" options="{'format': 'dd-MM-yyyy HH:mm'}"/>
                                        </span>
                                    </div>
                                    
                                    <!-- Winning Result -->
                                    <div class="d-flex mb-1" t-if="record.winning_order_id.raw_value">
                                        <span class="me-auto text-success o_form_label">
                                            <i class="fa fa-trophy"/> Kazanan
                                        </span>
                                        <span class="text-success fw-bold">
                                            <field name="winning_order_id" options="{'no_open': True}"/>
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <!-- Progress Bar -->
                            <div class="mb-3 ms-2 me-2">
                                <div class="progress" style="height: 8px;">
                                    <div class="progress-bar"
                                        t-attf-class="progress-bar #{!record.workflow_current_state_id.raw_value ? 'bg-danger bg-opacity-50' :
                                            record.workflow_state.raw_value == 'draft' ? 'bg-secondary bg-opacity-50' :
                                            record.workflow_state.raw_value == 'first_tender_round' ? 'bg-info bg-opacity-50' :
                                            record.workflow_state.raw_value == 'target_price_set' ? 'bg-warning bg-opacity-50' :
                                            record.workflow_state.raw_value == 'second_tender_round' ? 'bg-primary bg-opacity-50' :
                                            record.workflow_state.raw_value == 'evaluation' ? 'bg-warning bg-opacity-50' :
                                            record.workflow_state.raw_value == 'approved' ? 'bg-success bg-opacity-50' :
                                            record.workflow_state.raw_value == 'done' ? 'bg-success bg-opacity-50' :
                                            'bg-danger bg-opacity-50'}"
                                        t-attf-style="width: #{!record.workflow_current_state_id.raw_value ? '0' :
                                            record.workflow_state.raw_value == 'draft' ? '12' :
                                            record.workflow_state.raw_value == 'first_tender_round' ? '25' :
                                            record.workflow_state.raw_value == 'target_price_set' ? '37' :
                                            record.workflow_state.raw_value == 'second_tender_round' ? '50' :
                                            record.workflow_state.raw_value == 'evaluation' ? '62' :
                                            record.workflow_state.raw_value == 'approved' ? '87' :
                                            record.workflow_state.raw_value == 'done' ? '100' : '0'}%">
                                    </div>
                                </div>
                            </div>

                            <!-- Footer Stats -->
                            <div name="card_content" class="row mt-auto">
                                <a name="action_view_offers" type="object"
                                   class="d-flex flex-column align-items-center col-4 border-end">
                                    <span class="fw-bold text-primary">
                                        <t t-esc="record.invited_partners.raw_value.length"/>
                                    </span>
                                    <span class="text-muted text-truncate mw-100" title="Davet Edilen">Davet Edilen</span>
                                </a>

                                <div class="d-flex flex-column align-items-center col-4 border-end">
                                    <span class="fw-bold text-success">
                                        <field name="offer_count"/>
                                    </span>
                                    <span class="text-muted text-truncate mw-100" title="Teklif Sayısı">Teklif Sayısı</span>
                                </div>
                                
                                <div class="d-flex flex-column align-items-center col-4">
                                    <span class="fw-bold text-warning">
                                        <t t-if="record.target_price.raw_value">
                                            <i class="fa fa-check"/>
                                        </t>
                                        <t t-else="">
                                            <i class="fa fa-minus"/>
                                        </t>
                                    </span>
                                    <span class="text-muted text-truncate mw-100" title="Hedef Fiyat">Hedef Fiyat</span>
                                </div>
                            </div>

                            <!-- Activity indicator at bottom -->
                           <div class="position-absolute bottom-0 end-0 me-2 mb-2">
                               <field name="activity_ids" widget="kanban_activity"/>
                           </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>


        <record id="ak_tender_action" model="ir.actions.act_window">
            <field name="name">İhaleler</field>
            <field name="res_model">ak.tender</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="view_id" ref="ak_tender_view_list"/>
            <field name="views">
                [(ref('ak_tender_view_list'), 'list'),
                 (ref('ak_tender_view_form'), 'form'),
                 (ref('ak_tender_view_kanban'), 'kanban')]
            </field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Yeni bir ihale oluşturun ve satın alma süreçlerinizi dijitalleştirin!
                </p>
            </field>
        </record>

        <menuitem id="ak_tender_menu_root"
                  name="İhaleler"
                  sequence="10"
                  web_icon="ak_tender,static/description/icon.png"/>

        <menuitem id="ak_tender_menu_tender_list"
                  name="Tüm İhaleler"
                  parent="ak_tender_menu_root"
                  action="ak_tender_action"
                  sequence="10"/>

    </data>

</odoo>
