<odoo>
    <data>
        <record id="ak_tender_view_form" model="ir.ui.view">
            <field name="name">ak.tender.form</field>
            <field name="model">ak.tender</field>
            <field name="arch" type="xml">
                <form string="İhale">
                    <header>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,first_tender_round,target_price_set,second_tender_round,evaluation,approved,done"/>
                        
                        <button name="action_start_first_round" type="object" string="1. Teklif Toplamayı Başlat"
                                invisible="state != 'draft'" class="oe_highlight"/>
                        
                        <button name="action_set_target_price" type="object" string="Hedef Fiyatı Belirle"
                                invisible="state != 'first_tender_round'" class="oe_highlight"
                                confirm="Hedef fiyat belirledikten sonra 1. tur teklif alımı sona erecektir. Emin misiniz?"/>
                                
                        <button name="action_start_second_round" type="object" string="2. Teklif Toplamayı Başlat"
                                invisible="state != 'target_price_set'" class="oe_highlight"/>
                                
                        <button name="action_to_evaluation" type="object" string="Değerlendirmeye Geç"
                                invisible="state not in ('first_tender_round', 'second_tender_round', 'target_price_set')" class="oe_highlight"
                                confirm="Bu işlem mevcut teklif toplama turunu sonlandıracaktır. Emin misiniz?"/>
                                
                        <button name="action_request_approval" type="object" string="Onay Talep Et"
                                invisible="state != 'evaluation'" class="oe_highlight"/>
                                
                        <button name="action_approve_tender" type="object" string="İhaleyi Onayla"
                                invisible="state != 'approval_pending'" class="oe_highlight"/>
                                
                        <button name="action_complete_tender" type="object" string="İhaleyi Tamamla"
                                invisible="state != 'approved'" class="oe_highlight"/>
                                
                        <button name="action_cancel_tender" type="object" string="İptal Et"
                                invisible="state in ('cancel', 'done')"/>
                                
                        <button name="action_set_draft" type="object" string="Taslağa Çevir"
                                invisible="state not in ('cancel')"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_purchase_orders"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-shopping-cart"
                                string="SAS'lar"
                                help="Bu ihaleden oluşturulan Satın Alma Siparişleri"
                                invisible="purchase_order_count == 0"
                            />
                            <!-- Onay bilgileri için yeni buton -->
                            <button
                                class="oe_stat_button"
                                icon="fa-check-square-o"
                                string="Onay Bilgileri"
                                help="Bu ihale ile ilgili onay bilgileri"
                                disabled="1"
                            />
                            <button name="action_view_tender_results"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-balance-scale"
                                string="Teklif Sonuçları"
                                help="Tedarikçilerden gelen teklifler"
                            />
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="İhale Adı" />
                            </h1>
                            <field name="code" readonly="1" class="oe_inline"/>
                        </div>
                        <group>
                            <group>
                                <field name="tender_type" />
                                <field name="start_date" />
                                <field name="end_date" />
                            </group>
                            <group>
                                <field name="erp_pr_id" placeholder="ERP SAT No" />
                                <field name="erp_company_code" placeholder="ERP Şirket Kodu"/>
                                <field name="erp_plant_code" placeholder="ERP Tesis Kodu"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="İhale Kalemleri" name="tender_lines">
                                <field name="tender_lines" nolabel="1">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="product_id" />
                                        <field name="name" />
                                        <field name="quantity" />
                                        <field name="uom_id" />
                                        <field name="required_delivery_date" />
                                    </list>
                                    <form>
                                        <group>
                                            <field name="product_id"/>
                                            <field name="quantity"/>
                                            <field name="uom_id"/>
                                            <field name="required_delivery_date"/>
                                        </group>
                                    </form>
                                </field>
                                <p class="oe_grey">
                                    **Önemli:** İhale başlatılmadan önce en az bir ihale kalemi tanımlanmalıdır.
                                </p>
                            </page>
                            <page string="Davetli Tedarikçiler" name="invited_partners">
                                <field name="invited_partners" widget="many2many_tags" nolabel="1"/>
                                <p class="oe_grey">
                                    **Önemli:** İhale başlatılmadan önce en az bir tedarikçi davet edilmelidir.
                                </p>
                            </page>
                            <page string="Açıklama ve Ekler" name="description_attachments">
                                <field name="description" widget="html" nolabel="1"/>
                            </page>
                            <page string="Teklif Sonuçları &amp; Değerlendirme" name="tender_results_evaluation">
                                <field name="tender_results" nolabel="1" context="{'default_tender_id': id}">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="partner_id"/>
                                        <field name="tender_round"/>
                                        <field name="offer_date"/>
                                        <field name="currency_id"/>
                                        <field name="delivery_date"/>
                                        <field name="status"/>
                                        <field name="total_price" min="Min. Teklif"/>
                                        <field name="purchase_order_id" optional="hide"/>
                                        <button name="action_view_offer_items" type="object" icon="fa-list" string="Teklif Kalemleri" class="oe_highlight"/>
                                    </list>
                                </field>
                                <group class="oe_subtotal_footer oe_right">
                                    <field name="target_price" widget="monetary" options="{'currency_field': 'currency_id'}"
                                           readonly="state not in ('first_tender_round', 'target_price_set')"/>
                                    <field name="winning_result_id" readonly="1" />
                                </group>
                                <!-- Onay bilgileri -->
                                <group string="Onay Bilgileri" invisible="approval_user_id == False">
                                    <field name="approval_user_id" readonly="1"/>
                                    <field name="approval_date" readonly="1"/>
                                </group>
                                <p class="oe_grey">
                                    Bu sayfa, tedarikçilerden gelen tekliflerin otomatik olarak işleneceği ve karşılaştırılacağı alan olacaktır. (Bu prototipte manuel giriş için açılmıştır, gerçek sistemde portal entegrasyonu ile dolacaktır.) Teklif turu bilgisi, hangi teklifin hangi aşamada geldiğini belirtir.
                                </p>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="ak_tender_view_list" model="ir.ui.view">
            <field name="name">ak.tender.list</field>
            <field name="model">ak.tender</field>
            <field name="arch" type="xml">
                <list string="İLKOis İhaleleri" decoration-success="state in ('approved', 'done')" decoration-info="state in ('first_tender_round', 'second_tender_round', 'evaluation')" decoration-warning="state == 'approval_pending'" decoration-danger="state == 'cancel'">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="erp_pr_id"/>
                    <field name="tender_type"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="state" widget="badge"/>
                </list>
            </field>
        </record>

        <record id="ak_tender_view_search" model="ir.ui.view">
            <field name="name">ak.tender.search</field>
            <field name="model">ak.tender</field>
            <field name="arch" type="xml">
                <search string="İhale Ara">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="erp_pr_id"/>
                    <field name="tender_type"/>
                    <field name="state"/>
                    <filter name="filter_draft" string="Taslak İhaleler" domain="[('state', '=', 'draft')]"/>
                    <filter name="filter_first_round" string="1. Tur Teklif Toplama" domain="[('state', '=', 'first_tender_round')]"/>
                    <filter name="filter_target_price_set" string="Hedef Fiyat Belirlendi" domain="[('state', '=', 'target_price_set')]"/>
                    <filter name="filter_second_round" string="2. Tur Teklif Toplama" domain="[('state', '=', 'second_tender_round')]"/>
                    <filter name="filter_evaluation" string="Değerlendirmede" domain="[('state', '=', 'evaluation')]"/>
                    <filter name="filter_approval_pending" string="Onay Bekleyenler" domain="[('state', '=', 'approval_pending')]"/>
                    <filter name="filter_approved" string="Onaylanmış İhaleler" domain="[('state', '=', 'approved')]"/>
                    <filter name="filter_done" string="Tamamlanmış İhaleler" domain="[('state', '=', 'done')]"/>
                    <separator/>
                    <group expand="0" string="Grup Bazında">
                        <filter name="groupby_state" string="Durum" context="{'group_by':'state'}"/>
                        <filter name="groupby_tender_type" string="İhale Tipi" context="{'group_by':'tender_type'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="ak_tender_view_kanban" model="ir.ui.view">
            <field name="name">ak.tender.kanban</field>
            <field name="model">ak.tender</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state" class="o_kanban_dashboard o_tender_kanban" edit="false" sample="1">
                    <field name="state"/>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="tender_type"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="erp_pr_id"/>
                    <field name="invited_partners"/>
                    <field name="currency_id"/>
                    <field name="target_price"/>
                    <field name="winning_result_id"/>
                    <field name="purchase_order_count"/>
                    <field name="tender_result_count"/>
                    <field name="create_date"/>
                    <field name="activity_ids"/>
                    <field name="activity_state"/>
                    
                    <progressbar field="activity_state" colors='{"overdue": "danger", "today": "warning", "planned": "success"}'/>
                    
                    <templates>
                        <t t-name="menu">
                            <div class="o_kanban_tender_card_manage_pane">
                                <a role="menuitem" type="edit" class="dropdown-item">
                                    <i class="fa fa-fw fa-edit"/> Düzenle
                                </a>
                                <a role="menuitem" name="action_view_tender_results" type="object" class="dropdown-item">
                                    <i class="fa fa-fw fa-eye"/> Teklif Sonuçları
                                </a>
                                <t t-if="record.purchase_order_count.raw_value > 0">
                                    <a role="menuitem" name="action_view_purchase_orders" type="object" class="dropdown-item">
                                        <i class="fa fa-fw fa-shopping-cart"/> Satın Alma Siparişleri
                                    </a>
                                </t>
                                <div class="dropdown-divider"/>
                                <a role="menuitem" type="delete" class="dropdown-item">
                                    <i class="fa fa-fw fa-trash"/> Sil
                                </a>
                            </div>
                        </t>
                        
                        <t t-name="card">
                            <!-- Ribbon for urgent tenders -->
                            <widget name="web_ribbon" title="Acil" bg_color="text-bg-danger"
                                    t-if="record.end_date.raw_value and (new Date(record.end_date.raw_value) - new Date()) / (1000 * 60 * 60 * 24) &lt; 3 and record.state.raw_value and !['done', 'cancel', 'approved'].includes(record.state.raw_value)"/>
                            
                            <!-- Ribbon for completed tenders -->
                            <widget name="web_ribbon" title="Tamamlandı" bg_color="text-bg-success"
                                    t-if="record.state.raw_value and record.state.raw_value == 'done'"/>
                            
                            <!-- Ribbon for approved tenders -->
                            <widget name="web_ribbon" title="Onaylandı" bg_color="text-bg-info"
                                    t-if="record.state.raw_value and record.state.raw_value == 'approved'"/>

                            <!-- Tender Title and Code -->
                            <field name="name" class="fw-bold fs-4 me-auto ms-1"/>
                            <div class="mb-3"></div>
                            <div class="mb-2 ms-1">
                                <span class="badge bg-light text-dark border me-2">
                                    <i class="fa fa-barcode"/> <field name="code"/>
                                </span>
                                <span t-attf-class="badge #{record.tender_type.raw_value == 'standard' and 'bg-light text-muted border' or record.tender_type.raw_value == 'open_auction' and 'bg-warning bg-opacity-25 text-dark border' or 'bg-info bg-opacity-25 text-dark border'}">
                                    <field name="tender_type"/>
                                </span>
                            </div>

                            <!-- Main Content Area -->
                            <div class="row g-0 mb16 mt-1 ms-2 me-2">
                                <div class="col-12">
                                    <!-- Action Button based on state -->
                                    <div class="mb-2">
                                        <t t-if="record.state.raw_value and record.state.raw_value == 'draft'">
                                            <button class="btn btn-outline-success btn-sm" name="action_start_first_round" type="object">
                                                <i class="fa fa-play"/> İhaleyi Başlat
                                            </button>
                                        </t>
                                        <t t-elif="record.state.raw_value and record.state.raw_value == 'first_tender_round'">
                                            <button class="btn btn-outline-warning btn-sm" name="action_set_target_price" type="object">
                                                <i class="fa fa-target"/> Hedef Fiyat Belirle
                                            </button>
                                        </t>
                                        <t t-elif="record.state.raw_value and record.state.raw_value == 'target_price_set'">
                                            <button class="btn btn-outline-info btn-sm" name="action_start_second_round" type="object">
                                                <i class="fa fa-refresh"/> 2. Tur Başlat
                                            </button>
                                        </t>
                                        <t t-elif="record.state.raw_value and ['second_tender_round', 'evaluation'].includes(record.state.raw_value)">
                                            <button class="btn btn-outline-primary btn-sm" name="action_request_approval" type="object">
                                                <i class="fa fa-check"/> Onaya Gönder
                                            </button>
                                        </t>
                                    </div>
                                    
                                    <!-- Info List - Full Width -->
                                    <!-- SAT Info -->
                                    <div class="d-flex mb-1" t-if="record.erp_pr_id.raw_value">
                                        <span class="me-auto o_form_label">
                                            <i class="fa fa-file-text-o"/> SAT No
                                        </span>
                                        <span class="fw-bold">
                                            <field name="erp_pr_id"/>
                                        </span>
                                    </div>
                                    
                                    <!-- Target Price -->
                                    <div class="d-flex mb-1" t-if="record.target_price.raw_value">
                                        <span class="me-auto o_form_label">
                                            <i class="fa fa-target"/> Hedef Fiyat
                                        </span>
                                        <span class="text-warning fw-bold">
                                            <field name="target_price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                        </span>
                                    </div>
                                    
                                    <!-- End Date -->
                                    <div class="d-flex mb-1" t-if="record.end_date.raw_value">
                                        <span class="me-auto o_form_label">
                                            <i class="fa fa-calendar"/> Bitiş
                                        </span>
                                        <span>
                                            <field name="end_date" widget="datetime" options="{'format': 'dd-MM-yyyy HH:mm'}"/>
                                        </span>
                                    </div>
                                    
                                    <!-- Winning Result -->
                                    <div class="d-flex mb-1" t-if="record.winning_result_id.raw_value">
                                        <span class="me-auto text-success o_form_label">
                                            <i class="fa fa-trophy"/> Kazanan
                                        </span>
                                        <span class="text-success fw-bold">
                                            <field name="winning_result_id" options="{'no_open': True}"/>
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <!-- Progress Bar -->
                            <div class="mb-3 ms-2 me-2">
                                <div class="progress" style="height: 8px;">
                                    <div class="progress-bar"
                                        t-attf-class="progress-bar #{record.state.raw_value == null or record.state.raw_value == undefined ? 'bg-danger bg-opacity-50' :
                                            record.state.raw_value == 'draft' ? 'bg-secondary bg-opacity-50' :
                                            record.state.raw_value == 'first_tender_round' ? 'bg-info bg-opacity-50' :
                                            record.state.raw_value == 'target_price_set' ? 'bg-warning bg-opacity-50' :
                                            record.state.raw_value == 'second_tender_round' ? 'bg-primary bg-opacity-50' :
                                            record.state.raw_value == 'evaluation' ? 'bg-warning bg-opacity-50' :
                                            record.state.raw_value == 'approval_pending' ? 'bg-info bg-opacity-50' :
                                            record.state.raw_value == 'approved' ? 'bg-success bg-opacity-50' :
                                            record.state.raw_value == 'done' ? 'bg-success bg-opacity-50' :
                                            'bg-danger bg-opacity-50'}"
                                        t-attf-style="width: #{record.state.raw_value == null or record.state.raw_value == undefined ? '0' :
                                            record.state.raw_value == 'draft' ? '12' :
                                            record.state.raw_value == 'first_tender_round' ? '25' :
                                            record.state.raw_value == 'target_price_set' ? '37' :
                                            record.state.raw_value == 'second_tender_round' ? '50' :
                                            record.state.raw_value == 'evaluation' ? '62' :
                                            record.state.raw_value == 'approval_pending' ? '75' :
                                            record.state.raw_value == 'approved' ? '87' :
                                            record.state.raw_value == 'done' ? '100' : '0'}%">
                                    </div>
                                </div>
                            </div>

                            <!-- Footer Stats -->
                            <div name="card_content" class="row mt-auto">
                                <a name="action_view_tender_results" type="object" 
                                class="d-flex flex-column align-items-center col-4 border-end">
                                    <span class="fw-bold text-primary">
                                        <t t-esc="record.invited_partners.raw_value.length"/>
                                    </span>
                                    <span class="text-muted text-truncate mw-100" title="Davet Edilen">Davet Edilen</span>
                                </a>
                                
                                <div class="d-flex flex-column align-items-center col-4 border-end">
                                    <span class="fw-bold text-success">
                                        <field name="tender_result_count"/>
                                    </span>
                                    <span class="text-muted text-truncate mw-100" title="Teklif Veren">Teklif Veren</span>
                                </div>
                                
                                <div class="d-flex flex-column align-items-center col-4">
                                    <span class="fw-bold text-warning">
                                        <t t-if="record.target_price.raw_value">
                                            <i class="fa fa-check"/>
                                        </t>
                                        <t t-else="">
                                            <i class="fa fa-minus"/>
                                        </t>
                                    </span>
                                    <span class="text-muted text-truncate mw-100" title="Hedef Fiyat">Hedef Fiyat</span>
                                </div>
                            </div>

                            <!-- Activity indicator at bottom -->
                            <div class="position-absolute bottom-0 end-0 me-2 mb-2">
                                <field name="activity_ids" widget="kanban_activity"/>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

