<odoo>
    <data>
        <record id="ak_tender_view_form" model="ir.ui.view">
            <field name="name">ak.tender.form</field>
            <field name="model">ak.tender</field>
            <field name="arch" type="xml">
                <form string="İhale">
                    <header>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,first_tender_round,target_price_set,second_tender_round,evaluation,approved,done"/>
                        
                        <button name="action_start_first_round" type="object" string="1. Teklif Toplamayı Başlat"
                                invisible="state != 'draft'" class="oe_highlight"/>
                        
                        <button name="action_set_target_price" type="object" string="Hedef Fiyatı Belirle"
                                invisible="state != 'first_tender_round'" class="oe_highlight"
                                confirm="Hedef fiyat belirledikten sonra 1. tur teklif alımı sona erecektir. Emin misiniz?"/>
                                
                        <button name="action_start_second_round" type="object" string="2. Teklif Toplamayı Başlat"
                                invisible="state != 'target_price_set'" class="oe_highlight"/>
                                
                        <button name="action_to_evaluation" type="object" string="Değerlendirmeye Geç"
                                invisible="state not in ('first_tender_round', 'second_tender_round', 'target_price_set')" class="oe_highlight"
                                confirm="Bu işlem mevcut teklif toplama turunu sonlandıracaktır. Emin misiniz?"/>
                                
                        <button name="action_request_approval" type="object" string="Onay Talep Et"
                                invisible="state != 'evaluation'" class="oe_highlight"/>
                                
                        <button name="action_approve_tender" type="object" string="İhaleyi Onayla"
                                invisible="state != 'approval_pending'" class="oe_highlight"/>
                                
                        <button name="action_complete_tender" type="object" string="İhaleyi Tamamla"
                                invisible="state != 'approved'" class="oe_highlight"/>
                                
                        <button name="action_cancel_tender" type="object" string="İptal Et"
                                invisible="state in ('cancel', 'done')"/>
                                
                        <button name="action_set_draft" type="object" string="Taslağa Çevir"
                                invisible="state not in ('cancel')"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_purchase_orders"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-shopping-cart"
                                string="SAS'lar"
                                help="Bu ihaleden oluşturulan Satın Alma Siparişleri"
                                invisible="purchase_order_count == 0"
                            />
                            <!-- Onay bilgileri için yeni buton -->
                            <button
                                class="oe_stat_button"
                                icon="fa-check-square-o"
                                string="Onay Bilgileri"
                                help="Bu ihale ile ilgili onay bilgileri"
                                invisible="approval_user_id == False"
                                disabled="1"
                            />
                            <button name="action_view_tender_results"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-balance-scale"
                                string="Teklif Sonuçları"
                                help="Tedarikçilerden gelen teklif sonuçları"
                            />
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="İhale Adı" />
                            </h1>
                            <field name="code" readonly="1" class="oe_inline"/>
                        </div>
                        <group>
                            <group>
                                <field name="tender_type" />
                                <field name="start_date" />
                                <field name="end_date" />
                            </group>
                            <group>
                                <field name="erp_pr_id" placeholder="ERP SAT No" />
                                <field name="erp_company_code" placeholder="ERP Şirket Kodu"/>
                                <field name="erp_plant_code" placeholder="ERP Tesis Kodu"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="İhale Kalemleri" name="tender_lines">
                                <field name="tender_lines" nolabel="1">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="product_id" />
                                        <field name="name" />
                                        <field name="quantity" />
                                        <field name="uom_id" />
                                        <field name="required_delivery_date" />
                                    </list>
                                    <form>
                                        <group>
                                            <field name="product_id"/>
                                            <field name="quantity"/>
                                            <field name="uom_id"/>
                                            <field name="required_delivery_date"/>
                                        </group>
                                    </form>
                                </field>
                                <p class="oe_grey">
                                    **Önemli:** İhale başlatılmadan önce en az bir ihale kalemi tanımlanmalıdır.
                                </p>
                            </page>
                            <page string="Davetli Tedarikçiler" name="invited_partners">
                                <field name="invited_partners" widget="many2many_tags" nolabel="1"/>
                                <p class="oe_grey">
                                    **Önemli:** İhale başlatılmadan önce en az bir tedarikçi davet edilmelidir.
                                </p>
                            </page>
                            <page string="Açıklama ve Ekler" name="description_attachments">
                                <field name="description" widget="html" nolabel="1"/>
                            </page>
                            <page string="Teklif Sonuçları &amp; Değerlendirme" name="tender_results_evaluation">
                                <field name="tender_results" nolabel="1">
                                    <list>
                                        <field name="partner_id"/>
                                        <field name="tender_round"/>
                                        <field name="offer_date"/>
                                        <field name="currency_id"/>
                                        <field name="total_price" sum="Toplam Teklif"/>
                                        <field name="delivery_date"/>
                                        <field name="status"/>
                                        <field name="purchase_order_id" optional="hide"/>
                                    </list>
                                    <form>
                                        <sheet>
                                            <group>
                                                <group>
                                                    <field name="partner_id"/>
                                                    <field name="offer_date"/>
                                                    <field name="tender_round"/>
                                                </group>
                                                <group>
                                                    <field name="currency_id" options="{'no_create': True}"/>
                                                    <field name="total_price"/>
                                                    <button name="create_missing_result_lines" string="Eksik Kalemleri Oluştur"
                                                            type="object" class="oe_link" icon="fa-refresh"
                                                            context="{'from_button': True}"/>
                                                </group>
                                                <group>
                                                    <field name="delivery_date"/>
                                                    <field name="payment_terms"/>
                                                    <field name="guarantee_period"/>
                                                </group>
                                            </group>
                                            
                                            <notebook>
                                                <page string="Teklif Kalemleri" name="result_lines">
                                                    <field name="result_lines" nolabel="1" context="{'default_result_id': id}">
                                                        <list editable="bottom" create="false" edit="true">
                                                            <field name="sequence" widget="handle"/>
                                                            <field name="tender_line_id"/>
                                                            <field name="product_id"/>
                                                            <field name="name"/>
                                                            <field name="quantity"/>
                                                            <field name="uom_id"/>
                                                            <field name="price_unit"/>
                                                            <field name="price_subtotal" sum="Toplam"/>
                                                        </list>
                                                    </field>
                                                </page>
                                                <page string="Notlar" name="notes">
                                                    <field name="notes" nolabel="1"/>
                                                </page>
                                            </notebook>
                                            
                                            <group class="oe_right">
                                                <field name="status"/>
                                            </group>
                                        </sheet>
                                    </form>
                                </field>
                                <group class="oe_subtotal_footer oe_right">
                                    <field name="target_price" widget="monetary" options="{'currency_field': 'currency_id'}"
                                           readonly="state not in ('first_tender_round', 'target_price_set')"/>
                                    <field name="winning_result_id" readonly="1" />
                                </group>
                                <!-- Onay bilgileri -->
                                <group string="Onay Bilgileri" invisible="approval_user_id == False">
                                    <field name="approval_user_id" readonly="1"/>
                                    <field name="approval_date" readonly="1"/>
                                </group>
                                <p class="oe_grey">
                                    Bu sayfa, tedarikçilerden gelen tekliflerin otomatik olarak işleneceği ve karşılaştırılacağı alan olacaktır. (Bu prototipte manuel giriş için açılmıştır, gerçek sistemde portal entegrasyonu ile dolacaktır.) Teklif turu bilgisi, hangi teklifin hangi aşamada geldiğini belirtir.
                                </p>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="ak_tender_view_list" model="ir.ui.view">
            <field name="name">ak.tender.list</field>
            <field name="model">ak.tender</field>
            <field name="arch" type="xml">
                <list string="İLKOis İhaleleri" decoration-success="state in ('approved', 'done')" decoration-info="state in ('first_tender_round', 'second_tender_round', 'evaluation')" decoration-warning="state == 'approval_pending'" decoration-danger="state == 'cancel'">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="erp_pr_id"/>
                    <field name="tender_type"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="state" widget="badge"/>
                </list>
            </field>
        </record>

        <record id="ak_tender_view_search" model="ir.ui.view">
            <field name="name">ak.tender.search</field>
            <field name="model">ak.tender</field>
            <field name="arch" type="xml">
                <search string="İhale Ara">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="erp_pr_id"/>
                    <field name="tender_type"/>
                    <field name="state"/>
                    <filter name="filter_draft" string="Taslak İhaleler" domain="[('state', '=', 'draft')]"/>
                    <filter name="filter_first_round" string="1. Tur Teklif Toplama" domain="[('state', '=', 'first_tender_round')]"/>
                    <filter name="filter_target_price_set" string="Hedef Fiyat Belirlendi" domain="[('state', '=', 'target_price_set')]"/>
                    <filter name="filter_second_round" string="2. Tur Teklif Toplama" domain="[('state', '=', 'second_tender_round')]"/>
                    <filter name="filter_evaluation" string="Değerlendirmede" domain="[('state', '=', 'evaluation')]"/>
                    <filter name="filter_approval_pending" string="Onay Bekleyenler" domain="[('state', '=', 'approval_pending')]"/>
                    <filter name="filter_approved" string="Onaylanmış İhaleler" domain="[('state', '=', 'approved')]"/>
                    <filter name="filter_done" string="Tamamlanmış İhaleler" domain="[('state', '=', 'done')]"/>
                    <separator/>
                    <group expand="0" string="Grup Bazında">
                        <filter name="groupby_state" string="Durum" context="{'group_by':'state'}"/>
                        <filter name="groupby_tender_type" string="İhale Tipi" context="{'group_by':'tender_type'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="ak_tender_view_kanban" model="ir.ui.view">
            <field name="name">ak.tender.kanban</field>
            <field name="model">ak.tender</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state">
                    <field name="state"/>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="tender_type"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_global_click">
                                <div class="oe_kanban_details">
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                    <ul>
                                        <li>İhale Kodu: <field name="code"/></li>
                                        <li>ERP SAT No: <field name="erp_pr_id"/></li>
                                        <li>Durum: <field name="state"/></li>
                                        <li>Başlangıç: <field name="start_date"/></li>
                                        <li>Bitiş: <field name="end_date"/></li>
                                    </ul>
                                    <div class="oe_kanban_bottom_left">
                                        <field name="invited_partners" widget="many2many_avatar_user"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="tender_type" widget="badge"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="ak_tender_action" model="ir.actions.act_window">
            <field name="name">İhaleler</field>
            <field name="res_model">ak.tender</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="view_id" ref="ak_tender_view_list"/>
            <field name="views">
                [(ref('ak_tender_view_list'), 'list'),
                 (ref('ak_tender_view_form'), 'form'),
                 (ref('ak_tender_view_kanban'), 'kanban')]
            </field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Yeni bir ihale oluşturun ve satın alma süreçlerinizi dijitalleştirin!
                </p>
            </field>
        </record>

        <menuitem id="ak_tender_menu_root"
                  name="İhaleler"
                  sequence="10"
                  web_icon="ak_tender,static/description/icon.png"/>

        <menuitem id="ak_tender_menu_tender_list"
                  name="Tüm İhaleler"
                  parent="ak_tender_menu_root"
                  action="ak_tender_action"
                  sequence="10"/>

    </data>
</odoo>