<odoo>
    <data>
        <!-- Form View -->
        <record id="view_tender_result_line_form" model="ir.ui.view">
            <field name="name">ak.tender.result.line.form</field>
            <field name="model">ak.tender.result.line</field>
            <field name="arch" type="xml">
                <form string="Teklif Kalemi">
                    <sheet>
                        <group>
                            <group>
                                <field name="result_id"/>
                                <field name="tender_line_id"/>
                                <field name="product_id"/>
                                <field name="name"/>
                            </group>
                            <group>
                                <field name="quantity"/>
                                <field name="uom_id"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="price_unit"/>
                                <field name="price_subtotal"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Tree View -->
        <record id="view_tender_result_line_tree" model="ir.ui.view">
            <field name="name">ak.tender.result.line.tree</field>
            <field name="model">ak.tender.result.line</field>
            <field name="arch" type="xml">
                <list string="Teklif Kalemleri" editable="bottom">
                    <field name="sequence" widget="handle"/>
                    <field name="result_id"/>
                    <field name="tender_line_id"/>
                    <field name="product_id"/>
                    <field name="name"/>
                    <field name="quantity"/>
                    <field name="uom_id"/>
                    <field name="price_unit"/>
                    <field name="price_subtotal" sum="Toplam"/>
                </list>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_tender_result_line_search" model="ir.ui.view">
            <field name="name">ak.tender.result.line.search</field>
            <field name="model">ak.tender.result.line</field>
            <field name="arch" type="xml">
                <search string="Teklif Kalemleri Ara">
                    <field name="result_id"/>
                    <field name="tender_line_id"/>
                    <field name="product_id"/>
                    <field name="name"/>
                    <group expand="0" string="Grupla">
                        <filter name="group_by_result" string="Teklif Sonucu" context="{'group_by': 'result_id'}"/>
                        <filter name="group_by_tender_line" string="İhale Kalemi" context="{'group_by': 'tender_line_id'}"/>
                        <filter name="group_by_product" string="Ürün" context="{'group_by': 'product_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_view_tender_result_lines" model="ir.actions.act_window">
            <field name="name">Teklif Kalemleri</field>
            <field name="res_model">ak.tender.result.line</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_result_id': active_id}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Henüz teklif kalemi oluşturulmadı.
                </p>
            </field>
        </record>
    </data>
</odoo>