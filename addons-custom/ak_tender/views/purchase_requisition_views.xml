<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Purchase Requisition Line Tree View -->
    <record id="view_purchase_requisition_line_tree" model="ir.ui.view">
        <field name="name">purchase.requisition.line.tree</field>
        <field name="model">purchase.requisition.line</field>
        <field name="arch" type="xml">
            <list string="SAT Havuzu"
                  decoration-success="line_processing_status == 'T'"
                  decoration-info="line_processing_status == 'N'"
                  decoration-muted="deletion_indicator == True"
                  multi_edit="1">
                <header>
                    <button name="action_create_tender"
                            string="Seçili Kalemlerden İhale Oluştur"
                            type="object"
                            class="btn-primary"/>
                </header>
                <field name="erp_pr_id" string="SAT No"/>
                <field name="erp_pr_item" string="Kalem"/>
                <field name="material_code" string="Malzeme Kodu" optional="show"/>
                <field name="product_id" string="Ürün"/>
                <field name="product_qty" string="Miktar" optional="show"/>
                <field name="product_uom_id" string="Birim" optional="hide"/>
                <field name="material_group" string="Mal Grubu" optional="hide"/>
                <field name="purchasing_group" string="SA Grubu" optional="hide"/>
                <field name="erp_company_code" string="Şirket" optional="hide"/>
                <field name="tender_group_info" string="İhale Grubu" optional="show"/>
                <field name="approval_date" string="Onay Tarihi" optional="show"/>
                <field name="request_date" string="Talep Tarihi" optional="show"/>
                <field name="required_delivery_date" string="Teslim Tarihi" optional="show"/>
                <field name="vendor_preferred" string="Tercih Edilen Tedarikçi" optional="hide"/>
                <field name="vendor_fixed" string="Sabit Tedarikçi" optional="hide"/>
                <field name="po_number" string="SAS No" optional="hide"/>
                <field name="pr_count" string="SAT Sayısı" optional="hide"/>
                <field name="line_processing_status" string="Durum"/>
                <field name="tender_id" string="İhale" optional="hide"/>
                <field name="deletion_indicator" invisible="1"/>
                <field name="can_create_tender" invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Purchase Requisition Line Form View -->
    <record id="view_purchase_requisition_line_form" model="ir.ui.view">
        <field name="name">purchase.requisition.line.form</field>
        <field name="model">purchase.requisition.line</field>
        <field name="arch" type="xml">
            <form string="SAT Kalemi">
                <header>
                    <button name="action_create_tender" 
                            string="İhale Oluştur" 
                            type="object" 
                            class="oe_highlight"
                            invisible="not can_create_tender"/>
                    <button name="action_view_tender" 
                            string="İhaleyi Görüntüle" 
                            type="object"
                            invisible="not tender_id"/>
                    <field name="line_processing_status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_tender" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-gavel"
                                invisible="not tender_id">
                            <field name="tender_id" widget="statinfo" string="İhale"/>
                        </button>
                    </div>
                    
                    <group>
                        <group name="sap_info" string="SAP Bilgileri">
                            <field name="erp_pr_id"/>
                            <field name="erp_pr_item"/>
                            <field name="material_code"/>
                            <field name="erp_company_code"/>
                            <field name="erp_plant_code"/>
                            <field name="erp_requester"/>
                        </group>
                        <group name="product_info" string="Ürün Bilgileri">
                            <field name="product_id"/>
                            <field name="product_qty"/>
                            <field name="product_uom_id"/>
                            <field name="required_delivery_date"/>
                            <field name="request_date"/>
                        </group>
                    </group>
                    
                    <group>
                        <group name="classification" string="Sınıflandırma">
                            <field name="material_group"/>
                            <field name="purchasing_group"/>
                            <field name="item_type"/>
                            <field name="account_assignment_type"/>
                        </group>
                        <group name="status" string="Durum">
                            <field name="deletion_indicator"/>
                            <field name="is_urgent"/>
                            <field name="approval_indicator"/>
                            <field name="can_create_tender"/>
                        </group>
                    </group>
                    
                    <group name="additional" string="Ek Bilgiler">
                        <field name="requirement_number"/>
                        <field name="framework_agreement"/>
                        <field name="purchasing_info_record"/>
                        <field name="manufacturer_part_number"/>
                        <field name="delivering_production_location"/>
                        <field name="purchasing_organization"/>
                        <field name="vendor_preferred"/>
                        <field name="vendor_fixed"/>
                        <field name="po_number"/>
                        <field name="approval_date"/>
                        <field name="pr_count"/>
                        <field name="requester_comment"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Purchase Requisition Line Search View -->
    <record id="view_purchase_requisition_line_search" model="ir.ui.view">
        <field name="name">purchase.requisition.line.search</field>
        <field name="model">purchase.requisition.line</field>
        <field name="arch" type="xml">
            <search string="SAT Havuzu Ara">
                <field name="erp_pr_id" string="SAT No"/>
                <field name="erp_pr_item" string="Kalem"/>
                <field name="material_code" string="Malzeme Kodu"/>
                <field name="product_id" string="Ürün"/>
                <field name="material_group" string="Mal Grubu"/>
                <field name="purchasing_group" string="SA Grubu"/>
                <field name="erp_company_code" string="Şirket"/>
                <field name="vendor_preferred" string="Tercih Edilen Tedarikçi"/>
                <field name="vendor_fixed" string="Sabit Tedarikçi"/>
                <field name="po_number" string="SAS No"/>
                
                <filter name="can_create_tender" string="İhale Oluşturulabilir"
                        domain="[('can_create_tender', '=', True)]"/>
                <filter name="not_processed" string="İşlenmedi" 
                        domain="[('line_processing_status', '=', 'N')]"/>
                <filter name="in_tender" string="İhalede" 
                        domain="[('line_processing_status', '=', 'T')]"/>
                <filter name="urgent" string="Acil" 
                        domain="[('is_urgent', '=', True)]"/>
                
                <separator/>
                <filter name="group_by_tender_group" string="İhale Grubu"
                        context="{'group_by': 'tender_group_info'}"/>
                <filter name="group_by_sat" string="SAT No"
                        context="{'group_by': 'erp_pr_id'}"/>
                <filter name="group_by_material_group" string="Mal Grubu"
                        context="{'group_by': 'material_group'}"/>
                <filter name="group_by_purchasing_group" string="SA Grubu"
                        context="{'group_by': 'purchasing_group'}"/>
                <filter name="group_by_company" string="Şirket"
                        context="{'group_by': 'erp_company_code'}"/>
                <filter name="group_by_status" string="Durum"
                        context="{'group_by': 'line_processing_status'}"/>
            </search>
        </field>
    </record>

    <!-- Purchase Requisition Tree View -->
    <record id="view_purchase_requisition_tree" model="ir.ui.view">
        <field name="name">purchase.requisition.tree.inherit</field>
        <field name="model">purchase.requisition</field>
        <field name="inherit_id" ref="purchase_requisition.view_purchase_requisition_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="decoration-info">processing_status == 'N'</attribute>
                <attribute name="decoration-success">processing_status == 'T'</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="erp_pr_id" string="SAT No"/>
                <field name="processing_status" string="Durum"/>
                <field name="total_lines" string="Toplam Kalem"/>
                <field name="processed_lines" string="İşlenen"/>
                <field name="preview_groups" string="İhale Grupları" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Purchase Requisition Form View -->
    <record id="view_purchase_requisition_form" model="ir.ui.view">
        <field name="name">purchase.requisition.form.inherit</field>
        <field name="model">purchase.requisition</field>
        <field name="inherit_id" ref="purchase_requisition.view_purchase_requisition_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_create_tenders_from_lines" 
                        string="İhaleler Oluştur" 
                        type="object" 
                        class="oe_highlight"
                        invisible="processing_status != 'N'"/>
            </xpath>
            
            <xpath expr="//notebook" position="before">
                <group name="sap_info" string="SAP Bilgileri">
                    <group>
                        <field name="erp_pr_id"/>
                        <field name="processing_status"/>
                        <field name="erp_company_code"/>
                        <field name="erp_plant_code"/>
                        <field name="erp_requester"/>
                        <field name="header_note" widget="text" nolabel="1" colspan="2"/>
                    </group>
                    <group>
                        <field name="total_lines"/>
                        <field name="processed_lines"/>
                    </group>
                </group>
                <group name="preview" string="İhale Grupları Önizleme" invisible="processing_status != 'N'">
                    <field name="preview_groups" widget="text" nolabel="1" colspan="2"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Purchase Requisition Simple Form View for Manual Entry -->
    <record id="view_purchase_requisition_form_simple" model="ir.ui.view">
        <field name="name">purchase.requisition.form.simple</field>
        <field name="model">purchase.requisition</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form string="Talep Girişi">
                <header>
                    <button name="action_in_progress" string="Onaya Gönder" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_done" string="Onayla" type="object" class="oe_highlight" invisible="state != 'in_progress'" groups="ak_tender.group_tender_user,ak_tender.group_tender_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id" string="Talep Eden" readonly="state != 'draft'"/>
                            <field name="department_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="ordering_date" string="Talep Tarihi" readonly="state != 'draft'"/>
                            <field name="type_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Ürünler" name="products">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="product_qty"/>
                                    <field name="product_uom_id" groups="uom.group_uom"/>
                                    <field name="schedule_date"/>
                                    <field name="line_processing_status" string="Durum" readonly="1"/>
                                    <field name="tender_id" string="İhale" readonly="1"/>
                                    <field name="account_assignment_type" optional="hide"/>
                                </list>
                            </field>
                            <field name="description" placeholder="Talebinizle ilgili ek notlar..." readonly="state != 'draft'"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_purchase_requisition_line_pool" model="ir.actions.act_window">
        <field name="name">SAT Havuzu</field>
        <field name="res_model">purchase.requisition.line</field>
        <field name="view_mode">list,form</field>
        <field name="context">{
            'search_default_can_create_tender': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                SAT Havuzu Boş
            </p>
            <p>
                SAP'den import edilen SAT kalemleri burada görünür.<br/>
                Kalemleri seçerek ihale oluşturabilirsiniz.
            </p>
        </field>
    </record>

    <record id="action_purchase_requisition_sat" model="ir.actions.act_window">
        <field name="name">SAT Başlıkları</field>
        <field name="res_model">purchase.requisition</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('erp_pr_id', '!=', False)]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                SAT Bulunamadı
            </p>
            <p>
                SAP'den import edilen SAT'lar burada görünür.
            </p>
        </field>
    </record>

    <record id="action_purchase_requisition_manual" model="ir.actions.act_window">
        <field name="name">Talepler</field>
        <field name="res_model">purchase.requisition</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_purchase_requisition_form_simple"/>
        <field name="domain">[('erp_pr_id', '=', False)]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Yeni bir talep oluşturun
            </p>
            <p>
                Buradan satınalma taleplerinizi girebilirsiniz.
            </p>
        </field>
    </record>

    <record id="action_purchase_requisition_manual_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="purchase_requisition.view_purchase_requisition_tree"/>
        <field name="act_window_id" ref="action_purchase_requisition_manual"/>
    </record>

    <record id="action_purchase_requisition_manual_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_purchase_requisition_form_simple"/>
        <field name="act_window_id" ref="action_purchase_requisition_manual"/>
    </record>

    <!-- Server Action: Otomatik İhale Oluştur -->
    <record id="action_server_create_tenders_auto" model="ir.actions.server">
        <field name="name">Tüm SAT'lardan Otomatik İhale Oluştur</field>
        <field name="model_id" ref="purchase_requisition.model_purchase_requisition_line"/>
        <field name="binding_model_id" ref="purchase_requisition.model_purchase_requisition_line"/>
        <field name="state">code</field>
        <field name="code">
# Tüm işlenebilir SAT kalemlerini al ve ihale oluştur
lines = env['purchase.requisition.line'].search([
    ('line_processing_status', '=', 'N'),
    ('deletion_indicator', '=', False)
])
if lines:
    created_tenders = lines.create_tenders_from_lines()
    if created_tenders:
        action = {
            'type': 'ir.actions.client',
            'tag': 'display_notification',
            'params': {
                'title': 'Başarılı',
                'message': f'{len(created_tenders)} ihale oluşturuldu, {len(lines)} SAT kalemi işlendi.',
                'type': 'success',
                'sticky': True,
            }
        }
else:
    action = {
        'type': 'ir.actions.client',
        'tag': 'display_notification',
        'params': {
            'title': 'Bilgi',
            'message': 'İşlenebilir SAT kalemi bulunamadı.',
            'type': 'info',
        }
    }
        </field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_sat_pool_root"
              name="Talepler"
              parent="ak_tender.ak_tender_menu_root"
              sequence="15"/>

    <menuitem id="menu_purchase_requisition_manual"
              name="Talep Girişi"
              parent="menu_sat_pool_root"
              action="action_purchase_requisition_manual"
              sequence="5"/>

    <menuitem id="menu_sat_pool_lines"
              name="SAT Kalemleri"
              parent="menu_sat_pool_root"
              action="action_purchase_requisition_line_pool"
              sequence="10"/>

    <menuitem id="menu_sat_pool_headers"
              name="SAT Başlıkları"
              parent="menu_sat_pool_root"
              action="action_purchase_requisition_sat"
              sequence="20"/>
    
    <menuitem id="menu_sat_pool_auto_create"
              name="Otomatik İhale Oluştur"
              parent="menu_sat_pool_root"
              action="action_server_create_tenders_auto"
              sequence="30"/>

</odoo>