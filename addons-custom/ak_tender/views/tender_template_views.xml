<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_tender_template_tree" model="ir.ui.view">
        <field name="name">ak.tender.template.tree</field>
        <field name="model">ak.tender.template</field>
        <field name="arch" type="xml">
            <list string="İhale Şablonları">
                <field name="name"/>
                <field name="code"/>
                <field name="tender_type"/>
                <field name="line_count"/>
                <field name="tender_count"/>
                <field name="is_locked"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_tender_template_form" model="ir.ui.view">
        <field name="name">ak.tender.template.form</field>
        <field name="model">ak.tender.template</field>
        <field name="arch" type="xml">
            <form string="İhale Şablonu">
                <header>
                    <button name="action_lock_template" string="Şablonu Kilitle" type="object"
                            class="oe_highlight" invisible="is_locked == True"/>
                    <button name="action_unlock_template" string="Şablon Kilidini Aç" type="object"
                            class="oe_highlight" invisible="is_locked == False"/>
                    <button name="action_duplicate_template" string="Şablonu Kopyala" type="object" 
                            class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_tenders" type="object" class="oe_stat_button" icon="fa-list"
                                invisible="tender_count == 0">
                            <field name="tender_count" widget="statinfo" string="İhaleler"/>
                        </button>
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options="{'terminology': 'archive'}"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Şablon Adı" readonly="is_locked == True"/>
                        </h1>
                        <h2>
                            <field name="code" placeholder="Şablon Kodu" readonly="is_locked == True"/>
                        </h2>
                    </div>
                    <group>
                        <group>
                            <field name="tender_type" readonly="is_locked == True"/>
                            <field name="is_locked" readonly="1"/>
                            <field name="locked_by_id" readonly="1" invisible="is_locked == False"/>
                            <field name="locked_date" readonly="1" invisible="is_locked == False"/>
                        </group>
                        <group>
                            <field name="line_count" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Şablon Satırları" name="template_lines">
                            <field name="line_ids" readonly="is_locked == True">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="display_type" invisible="1"/>
                                    <field name="product_id" required="display_type == 'product'" invisible="display_type != 'product'"/>
                                    <field name="name" required="display_type in ('line_section', 'line_note')"/>
                                    <field name="product_qty" invisible="display_type != 'product'"/>
                                    <field name="product_uom_id" invisible="display_type != 'product'"/>
                                    <field name="product_uom_category_id" invisible="1"/>
                                    <field name="price_unit" invisible="display_type != 'product'"/>
                                    <field name="required" invisible="display_type != 'product'"/>
                                    <field name="allow_alternative" invisible="display_type != 'product'"/>
                                    <control>
                                        <create string="Ürün Ekle" context="{'default_display_type': 'product'}"/>
                                        <create string="Bölüm Ekle" context="{'default_display_type': 'line_section'}"/>
                                        <create string="Not Ekle" context="{'default_display_type': 'line_note'}"/>
                                    </control>
                                </list>
                            </field>
                        </page>
                        <page string="Coğrafi Filtreleme" name="geographic_filtering">
                            <group>
                                <field name="country_ids" widget="many2many_tags" readonly="is_locked == True"/>
                                <field name="state_ids" widget="many2many_tags" readonly="is_locked == True"/>
                                <field name="city" readonly="is_locked == True"/>
                            </group>
                        </page>
                        <page string="Açıklama" name="description">
                            <field name="description" readonly="is_locked == True"/>
                        </page>
                    </notebook>
                </sheet>
                <!-- Chatter -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_tender_template_search" model="ir.ui.view">
        <field name="name">ak.tender.template.search</field>
        <field name="model">ak.tender.template</field>
        <field name="arch" type="xml">
            <search string="İhale Şablonları">
                <field name="name"/>
                <field name="code"/>
                <field name="tender_type"/>
                <filter string="Kilitli" name="locked" domain="[('is_locked', '=', True)]"/>
                <filter string="Aktif" name="active" domain="[('active', '=', True)]"/>
                <filter string="Arşivlenmiş" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Grupla">
                    <filter string="İhale Tipi" name="tender_type" context="{'group_by': 'tender_type'}"/>
                    <filter string="Durum" name="locked" context="{'group_by': 'is_locked'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_tender_template" model="ir.actions.act_window">
        <field name="name">İhale Şablonları</field>
        <field name="res_model">ak.tender.template</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_tender_template_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                İlk ihale şablonunuzu oluşturun
            </p>
            <p>
                İhale şablonları, benzer ihaleler için tekrar kullanılabilir yapılar oluşturmanıza olanak tanır.
                Şablonlar, ihale satırlarını, coğrafi filtreleri ve diğer ayarları içerebilir.
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_tender_template"
              name="İhale Şablonları"
              parent="ak_tender_menu_root"
              action="action_tender_template"
              sequence="20"/>

</odoo>