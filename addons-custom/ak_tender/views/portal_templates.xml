<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Template for listing tenders in the portal -->
    <template id="portal_my_tenders_list" name="My Tenders">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">My Tenders</t>
            </t>

            <h3>Open Tenders</h3>
            <t t-if="not tenders">
                <div class="alert alert-info" role="alert">
                    You currently have no open tenders to bid on.
                </div>
            </t>
            <t t-if="tenders">
                <div class="table-responsive">
                    <table class="table table-hover o_portal_my_doc_table">
                        <thead>
                            <tr class="active">
                                <th>Tender Code</th>
                                <th>Tender Name</th>
                                <th>End Date</th>
                                <th>Status</th>
                                <th></th> <!-- Action button column -->
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="tenders" t-as="tender">
                                <tr>
                                    <td><span t-field="tender.code"/></td>
                                    <td><span t-field="tender.name"/></td>
                                    <td><span t-field="tender.end_date" t-options='{"widget": "date"}'/></td>
                                    <td><span t-field="tender.state" class="badge"/></td>
                                    <td class="text-end">
                                        <a t-attf-href="/my/tenders/{{tender.id}}" class="btn btn-primary btn-sm">
                                            View / Submit Bid
                                        </a>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
            <div t-if="pager" class="o_portal_pager text-center">
                <t t-call="portal.pager"/>
            </div>
        </t>
    </template>

    <!-- Template for the tender bid submission form -->
    <template id="portal_tender_bid_form" name="Tender Bid Form">
        <t t-call="portal.portal_layout">
            <div class="container">
                <h3>Submit Bid for Tender: <span t-field="tender.name"/> (<span t-field="tender.code"/>)</h3>
                <p>End Date: <span t-field="tender.end_date" t-options='{"widget": "datetime"}'/></p>
                <p>Status: <span t-field="tender.state" class="badge"/></p>

                <t t-if="tender.state not in ['first_tender_round', 'second_tender_round', 'target_price_set']">
                    <div class="alert alert-warning" role="alert">
                        This tender is not currently open for bidding.
                    </div>
                </t>

                <form t-attf-action="/my/tenders/{{tender.id}}/submit" method="POST" class="o_portal_details">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="delivery_date">Proposed Delivery Date:</label>
                                <input type="date" name="delivery_date" class="form-control" t-att-value="existing_bid and existing_bid.delivery_date and existing_bid.delivery_date.strftime('%Y-%m-%d') or ''"/>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="payment_terms">Payment Terms:</label>
                                <select name="payment_terms" class="form-control" required="required">
                                    <option value="">Select Payment Terms</option>
                                    <t t-foreach="payment_terms or []" t-as="term">
                                        <option t-att-value="term.id" t-att-selected="existing_bid and existing_bid.payment_terms and existing_bid.payment_terms.id == term.id">
                                            <t t-esc="term.name"/>
                                        </option>
                                    </t>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="form-group mt-3">
                        <label for="notes">Supplier Notes:</label>
                        <textarea name="notes" class="form-control" rows="3"><t t-esc="existing_bid and existing_bid.notes or ''"/></textarea>
                    </div>

                    <h4 class="mt-4">Tender Lines</h4>
                    <t t-if="not tender_lines">
                        <div class="alert alert-info">No lines in this tender.</div>
                    </t>
                    <t t-if="tender_lines">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Description</th>
                                    <th class="text-end">Quantity</th>
                                    <th>Unit Price (<span t-field="tender.currency_id.symbol"/>)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="tender_lines" t-as="line">
                                    <tr>
                                        <td><span t-field="line.product_id.display_name"/></td>
                                        <td><span t-field="line.name"/></td>
                                        <td class="text-end"><span t-field="line.quantity"/> <span t-field="line.uom_id.name"/></td>
                                        <td>
                                            <input type="number" t-attf-name="price_unit_line_{{line.id}}" class="form-control form-control-sm"
                                                   step="0.01" min="0" required="required"
                                                   t-att-value="bid_lines_data and bid_lines_data.get(line.id, {}).get('price_unit', '0.00')"
                                                   t-att-disabled="tender.state not in ['first_tender_round', 'second_tender_round', 'target_price_set'] or None" />
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary" 
                                t-att-disabled="tender.state not in ['first_tender_round', 'second_tender_round', 'target_price_set'] or None">
                            Submit Bid
                        </button>
                        <a t-attf-href="/my/tenders" class="btn btn-secondary">Cancel</a>
                    </div>
                    <t t-if="error == 'no_prices'">
                        <div class="alert alert-danger mt-2" role="alert">
                            Please enter a price for at least one tender line.
                        </div>
                    </t>
                    <t t-if="error == 'submission_failed'">
                        <div class="alert alert-danger mt-2" role="alert">
                            There was an error submitting your bid. Please try again.
                        </div>
                    </t>
                     <t t-if="bid_submitted == '1'"> <!-- This is for redirect from POST -->
                        <div class="alert alert-success mt-2" role="alert">
                            Your bid has been submitted successfully!
                        </div>
                    </t>
                </form>
            </div>
        </t>
    </template>

    <!-- Inherit portal_my_home to add Tender bids link/card -->
    <template id="portal_my_home_tender" name="Tenders" customize_show="True" inherit_id="portal.portal_my_home" priority="30">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_vendor_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_vendor_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Verdiğiniz Teklifler</t>
                <t t-set="url" t-value="'/my/tenders'"/>
                <t t-set="text">View and submit bids for open tenders</t>
                <t t-set="placeholder_count" t-value="'tender_count'"/>
                <t t-set="icon" t-value="'/ak_tender/static/src/img/tender-bids.svg'"/>
            </t>
        </div>
    </template>

    <!-- No need for a menu record as we're using template inheritance for the portal menu -->

</odoo>