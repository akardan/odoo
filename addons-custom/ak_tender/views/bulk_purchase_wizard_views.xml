<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_bulk_purchase_wizard_form" model="ir.ui.view">
            <field name="name">ak.tender.bulk.purchase.wizard.form</field>
            <field name="model">ak.tender.bulk.purchase.wizard</field>
            <field name="arch" type="xml">
                <form string="Toplu Satın Alma Sihirbazı">
                    <sheet>
                        <group>
                            <field name="tender_type" widget="radio"/>
                            <field name="pr_ids" placeholder="Örnek: PR001, PR002, PR003"/>
                            <field name="name"/>
                        </group>
                        <div class="alert alert-info" role="alert">
                            <p><strong>Bilgi:</strong> Bu sihirbaz, birden fazla SAT numarasını birleştirerek tek bir ihale oluşturmanıza olanak tanır.</p>
                            <p>Toplu satın alma optimizasyonu, satın alma gücünüzü artırarak daha iyi fiyatlar ve koşullar elde etmenizi sağlar.</p>
                        </div>
                    </sheet>
                    <footer>
                        <button name="action_create_bulk_tender" string="İhale Oluştur" type="object" class="btn-primary"/>
                        <button string="İptal" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_bulk_purchase_wizard" model="ir.actions.act_window">
            <field name="name">Toplu Satın Alma Oluştur</field>
            <field name="res_model">ak.tender.bulk.purchase.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

    </data>
</odoo>