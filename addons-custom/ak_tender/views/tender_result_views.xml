<odoo>
    <data>
        <!-- Form View for ak.tender.result -->
        <record id="view_tender_result_form" model="ir.ui.view">
            <field name="name">ak.tender.result.form</field>
            <field name="model">ak.tender.result</field>
            <field name="arch" type="xml">
                <form string="Teklif Sonucu" readonly="is_readonly">
                    <sheet>
                        <group>
                            <group>
                                <field name="partner_id"/>
                                <field name="offer_date"/>
                                <field name="tender_round"/>
                            </group>
                            <group>
                                <field name="currency_id" options="{'no_create': True}"/>
                                <field name="total_price"/>
                                <button name="create_missing_result_lines" string="Eksik Kalemleri Oluştur"
                                        type="object" class="oe_link" icon="fa-refresh"
                                        context="{'from_button': True}"
                                        invisible="is_readonly"/>
                            </group>
                            <group>
                                <field name="delivery_date"/>
                                <field name="payment_terms"/>
                                <field name="guarantee_period"/>
                            </group>
                        </group>
                        
                        <notebook>
                            <page string="Teklif Kalemleri" name="result_lines">
                                <field name="result_lines" nolabel="1" context="{'default_result_id': id}">
                                    <list editable="bottom" create="false" edit="true">
                                        <field name="sequence" widget="handle"/>
                                        <field name="tender_line_id"/>
                                        <field name="product_id"/>
                                        <field name="name"/>
                                        <field name="quantity"/>
                                        <field name="uom_id"/>
                                        <field name="price_unit"/>
                                        <field name="price_subtotal" sum="Toplam"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Notlar" name="notes">
                                <field name="notes" nolabel="1"/>
                            </page>
                        </notebook>
                        
                        <group class="oe_right">
                            <field name="status"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Tree View for ak.tender.result -->
        <record id="view_tender_result_tree" model="ir.ui.view">
            <field name="name">ak.tender.result.tree</field>
            <field name="model">ak.tender.result</field>
            <field name="arch" type="xml">
                <list string="Teklif Sonuçları" editable="bottom" create="false" edit="false">
                    <field name="sequence" widget="handle"/>
                    <field name="partner_id"/>
                    <field name="tender_round"/>
                    <field name="offer_date"/>
                    <field name="currency_id"/>
                    <field name="total_price" sum="Toplam Teklif"/>
                    <field name="delivery_date"/>
                    <field name="status"/>
                    <field name="purchase_order_id" optional="hide"/>
                </list>
            </field>
        </record>

        <!-- Pivot View for ak.tender.result -->
        <record id="view_tender_result_pivot" model="ir.ui.view">
            <field name="name">ak.tender.result.pivot</field>
            <field name="model">ak.tender.result</field>
            <field name="arch" type="xml">
                <pivot string="Teklif Sonuçları Analizi">
                    <field name="partner_id" type="row"/>
                    <field name="tender_round" type="col"/>
                    <field name="total_price" type="measure"/>
                </pivot>
            </field>
        </record>


        <!-- Tree View for ak.tender.result.line -->
        <record id="view_tender_result_line_tree" model="ir.ui.view">
            <field name="name">ak.tender.result.line.tree</field>
            <field name="model">ak.tender.result.line</field>
            <field name="arch" type="xml">
                <list string="Teklif Kalemleri" editable="bottom">
                    <field name="sequence" widget="handle"/>
                    <field name="tender_line_id"/>
                    <field name="product_id"/>
                    <field name="name"/>
                    <field name="quantity"/>
                    <field name="uom_id"/>
                    <field name="price_unit"/>
                    <field name="price_subtotal" sum="Toplam"/>
                </list>
            </field>
        </record>

        <!-- Search View for ak.tender.result (Optional, but good practice) -->
        <record id="view_tender_result_search" model="ir.ui.view">
            <field name="name">ak.tender.result.search</field>
            <field name="model">ak.tender.result</field>
            <field name="arch" type="xml">
                <search string="Teklif Sonuçları Ara">
                    <field name="partner_id"/>
                    <field name="tender_round"/>
                    <field name="offer_date"/>
                    <field name="status"/>
                    <group expand="0" string="Grupla">
                        <filter name="group_by_partner" string="Tedarikçi" context="{'group_by': 'partner_id'}"/>
                        <filter name="group_by_tender_round" string="Teklif Turu" context="{'group_by': 'tender_round'}"/>
                        <filter name="group_by_status" string="Durum" context="{'group_by': 'status'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action for ak.tender.result -->
        <record id="action_view_tender_results_standalone" model="ir.actions.act_window">
            <field name="name">Teklif Sonuçları</field>
            <field name="res_model">ak.tender.result</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Henüz teklif sonucu oluşturulmadı.
                </p>
            </field>
        </record>

    </data>
</odoo>