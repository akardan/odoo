<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action to open supplier partner from application -->
    <record id="action_open_supplier_partner" model="ir.actions.act_window">
        <field name="name">Tedarikçi</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">form</field>
        <field name="domain">[('id', '=', active_id)]</field>
        <field name="context">{'form_view_ref': 'base.view_partner_form'}</field>
    </record>

    <!-- Supplier Application List View -->
    <record id="view_supplier_application_list" model="ir.ui.view">
        <field name="name">supplier.application.list</field>
        <field name="model">supplier.application</field>
        <field name="arch" type="xml">
            <list string="Tedarikçi Başvuruları" decoration-info="state=='draft'"
                  decoration-warning="state=='submitted'" decoration-success="state=='approved'"
                  decoration-danger="state=='rejected'">
                <field name="name"/>
                <field name="application_date"/>
                <field name="company_name"/>
                <field name="vat_number"/>
                <field name="contact_name"/>
                <field name="contact_email"/>
                <field name="state" widget="badge" 
                       decoration-info="state=='draft'"
                       decoration-warning="state in ['submitted', 'under_review']"
                       decoration-success="state=='approved'"
                       decoration-danger="state=='rejected'"/>
                <field name="partner_id"/>
                <field name="create_date" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Supplier Application Form View -->
    <record id="view_supplier_application_form" model="ir.ui.view">
        <field name="name">supplier.application.form</field>
        <field name="model">supplier.application</field>
        <field name="arch" type="xml">
            <form string="Tedarikçi Başvurusu">
                <header>
                    <button name="action_submit" string="Başvuruyu Gönder" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_review" string="İncelemeyi Başlat" type="object"
                            class="oe_highlight" invisible="state != 'submitted'"
                            groups="ak_tender.group_tender_user,ak_tender.group_tender_manager"/>
                    <button name="action_approve" string="Onayla ve Tedarikçi Oluştur" type="object"
                            class="oe_highlight" invisible="state not in ['submitted', 'under_review']"
                            confirm="Bu işlem yeni bir tedarikçi oluşturacak ve portal erişimi gönderecektir. Devam edilsin mi?"
                            groups="ak_tender.group_tender_user,ak_tender.group_tender_manager"/>
                    <button name="action_reject" string="Reddet" type="object"
                            invisible="state not in ['submitted', 'under_review']"
                            groups="ak_tender.group_tender_user,ak_tender.group_tender_manager"/>
                    <button name="action_set_to_draft" string="Taslağa Geri Al" type="object"
                            invisible="state == 'draft' or partner_created == True"
                            groups="ak_tender.group_tender_user,ak_tender.group_tender_manager"/>
                    <button name="action_send_draft_link" string="Taslak Linki Gönder" type="object"
                            invisible="state != 'draft'"
                            groups="ak_tender.group_tender_user,ak_tender.group_tender_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,under_review,approved"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_open_supplier_partner)d" type="action"
                                class="oe_stat_button" icon="fa-building"
                                invisible="not partner_id"
                                groups="ak_tender.group_tender_user,ak_tender.group_tender_manager">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Görüntüle</span>
                                <span class="o_stat_text">Tedarikçi</span>
                            </div>
                        </button>
                    </div>
                    
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group>
                            <field name="application_date"/>
                            <field name="access_token" readonly="1" groups="base.group_no_one"/>
                            <field name="website_url" readonly="1" widget="url"
                                   invisible="state != 'draft'"
                                   groups="ak_tender.group_tender_user,ak_tender.group_tender_manager"/>
                        </group>
                        <group>
                            <field name="partner_created" invisible="1"/>
                            <field name="partner_id" readonly="1" invisible="not partner_id"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Firma Bilgileri" name="company_info">
                            <group>
                                <group string="Temel Bilgiler">
                                    <field name="company_name" readonly="state != 'draft'"/>
                                    <field name="vat_number" readonly="state != 'draft'"/>
                                    <field name="tax_office" readonly="state != 'draft'"/>
                                    <field name="tc_number" readonly="state != 'draft'"/>
                                    <field name="mersis_number" readonly="state != 'draft'"/>
                                    <field name="kep_address" readonly="state != 'draft'"/>
                                </group>
                                <group string="İletişim Bilgileri">
                                    <field name="company_phone" widget="phone" readonly="state != 'draft'"/>
                                    <field name="contact_name" readonly="state != 'draft'"/>
                                    <field name="contact_email" widget="email" readonly="state != 'draft'"/>
                                </group>
                            </group>
                            <group>
                                <field name="company_address" readonly="state != 'draft'"/>
                                <field name="product_service_group" readonly="state != 'draft'"/>
                            </group>
                        </page>
                        
                        <page string="Ödeme ve Bankacılık" name="payment_banking">
                            <group>
                                <group string="Ödeme Koşulları">
                                    <field name="payment_term" readonly="state != 'draft'"/>
                                    <field name="payment_method" readonly="state != 'draft'"/>
                                </group>
                                <group string="Banka Bilgileri">
                                    <field name="bank_name" readonly="state != 'draft'"/>
                                    <field name="swift_code" readonly="state != 'draft'"/>
                                </group>
                            </group>
                            <group>
                                <group string="IBAN Hesapları">
                                    <field name="iban_try" readonly="state != 'draft'"/>
                                    <field name="iban_usd" readonly="state != 'draft'"/>
                                    <field name="iban_eur" readonly="state != 'draft'"/>
                                </group>
                            </group>
                        </page>
                        
                        <page string="Belgeler" name="documents">
                            <!-- Tax Certificate Section -->
                            <group string="Vergi Levhası">
                                <field name="document_tax_certificate_filename" invisible="1"/>
                                <div class="row">
                                    <div class="col-12">
                                        <field name="document_tax_certificate"
                                               filename="document_tax_certificate_filename"
                                               widget="pdf_viewer"
                                               options="{'preview_image': true}"
                                               readonly="state != 'draft'"/>
                                    </div>
                                </div>
                            </group>
                            
                            <!-- Signature Circular Section -->
                            <group string="İmza Sirküleri">
                                <field name="document_signature_circular_filename" invisible="1"/>
                                <div class="row">
                                    <div class="col-12">
                                        <field name="document_signature_circular"
                                               filename="document_signature_circular_filename"
                                               widget="pdf_viewer"
                                               options="{'preview_image': true}"
                                               readonly="state != 'draft'"/>
                                    </div>
                                </div>
                            </group>
                            
                            <!-- Trade Registry Gazette Section -->
                            <group string="Ticaret Sicil Gazetesi">
                                <field name="document_trade_registry_filename" invisible="1"/>
                                <div class="row">
                                    <div class="col-12">
                                        <field name="document_trade_registry"
                                               filename="document_trade_registry_filename"
                                               widget="pdf_viewer"
                                               options="{'preview_image': true}"
                                               readonly="state != 'draft'"/>
                                    </div>
                                </div>
                            </group>
                            
                            <!-- Bank Information Section -->
                            <group string="Banka Bilgileri (Kaşeli)">
                                <field name="document_bank_info_filename" invisible="1"/>
                                <div class="row">
                                    <div class="col-12">
                                        <field name="document_bank_info"
                                               filename="document_bank_info_filename"
                                               widget="pdf_viewer"
                                               options="{'preview_image': true}"
                                               readonly="state != 'draft'"/>
                                    </div>
                                </div>
                            </group>
                        </page>
                        
                        <page string="Dahili Notlar" name="notes" groups="ak_tender.group_tender_user,ak_tender.group_tender_manager">
                            <group>
                                <field name="notes" placeholder="Dahili inceleme notları..." nolabel="1"/>
                                <field name="rejection_reason" readonly="state != 'rejected'" 
                                       invisible="state != 'rejected'"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <!-- Chatter -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Supplier Application Kanban View -->
    <record id="view_supplier_application_kanban" model="ir.ui.view">
        <field name="name">supplier.application.kanban</field>
        <field name="model">supplier.application</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="company_name"/>
                <field name="contact_email"/>
                <field name="state"/>
                <field name="application_date"/>
                <field name="activity_ids"/>
                <field name="activity_state"/>
                <progressbar field="activity_state" colors='{"planned": "success", "today": "warning", "overdue": "danger"}'/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="company_name"/>
                                        </strong>
                                    </div>
                                    <span class="float-end badge badge-pill" 
                                          t-attf-class="badge-#{record.state.raw_value == 'approved' ? 'success' : record.state.raw_value == 'rejected' ? 'danger' : record.state.raw_value == 'draft' ? 'secondary' : 'warning'}">
                                        <field name="state"/>
                                    </span>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="name"/>
                                    <div>
                                        <i class="fa fa-calendar"/> <field name="application_date"/>
                                    </div>
                                    <div t-if="record.contact_email.raw_value">
                                        <i class="fa fa-envelope"/> <field name="contact_email"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Supplier Application Search View -->
    <record id="view_supplier_application_search" model="ir.ui.view">
        <field name="name">supplier.application.search</field>
        <field name="model">supplier.application</field>
        <field name="arch" type="xml">
            <search string="Tedarikçi Başvuruları">
                <field name="name" string="Başvuru Numarası"/>
                <field name="company_name" string="Firma Adı"/>
                <field name="vat_number" string="Vergi Numarası"/>
                <field name="contact_email" string="İletişim E-postası"/>
                <field name="contact_name" string="İletişim Kişisi"/>
                
                <filter string="Taslak" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Gönderildi" name="submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="İnceleniyor" name="under_review" domain="[('state', '=', 'under_review')]"/>
                <filter string="Onaylandı" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Reddedildi" name="rejected" domain="[('state', '=', 'rejected')]"/>
                
                <separator/>
                <filter string="İnceleme Bekleyen" name="pending_review"
                        domain="[('state', 'in', ['submitted', 'under_review'])]"/>
                <filter string="İş Ortağı Oluşturuldu" name="partner_created"
                        domain="[('partner_created', '=', True)]"/>
                
                <separator/>
                <filter string="Bu Ay" name="this_month"
                        domain="[('application_date', '&gt;=', (context_today() - relativedelta(months=1)).strftime('%Y-%m-01'))]"/>
                <filter string="Bu Yıl" name="this_year"
                        domain="[('application_date', '&gt;=', (context_today().replace(month=1, day=1)).strftime('%Y-%m-%d'))]"/>
                
                <group expand="0" string="Grupla">
                    <filter string="Durum" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Başvuru Tarihi" name="group_date" context="{'group_by': 'application_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Supplier Application Actions -->
    <record id="action_supplier_application" model="ir.actions.act_window">
        <field name="name">Tedarikçi Başvuruları</field>
        <field name="res_model">supplier.application</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_supplier_application_search"/>
        <field name="context">{'search_default_pending_review': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Henüz tedarikçi başvurusu yok
            </p>
            <p>
                Potansiyel tedarikçiler web siteniz üzerinden kayıt olduğunda başvurular burada görünecektir.
            </p>
        </field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_supplier_applications"
              name="Tedarikçi Başvuruları"
              parent="purchase.menu_procurement_management"
              action="action_supplier_application"
              sequence="50"
              groups="ak_tender.group_tender_user,ak_tender.group_tender_manager"/>
</odoo>