<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Automated Action: Send Email When Tender Needs Approval -->
        <record id="automation_tender_approval_request_email" model="base.automation">
            <field name="name">İhale Onaya Gönderildi - Email Gönder</field>
            <field name="model_id" ref="model_ak_tender"/>
            <field name="active" eval="True"/>
            <field name="trigger">on_write</field>
            <field name="filter_pre_domain">[('workflow_current_state_id.code', '=', 'evaluation')]</field>
            <field name="filter_domain">[('workflow_current_state_id.code', '=', 'approval')]</field>
            <field name="state">email</field>
            <field name="template_id" ref="email_template_tender_approval_notification"/>
        </record>

        <!-- Automated Action: Send Email When Tender is Approved -->
        <record id="automation_tender_approved_email" model="base.automation">
            <field name="name">İhale Onaylandı - Email Gönder</field>
            <field name="model_id" ref="model_ak_tender"/>
            <field name="active" eval="True"/>
            <field name="trigger">on_write</field>
            <field name="filter_pre_domain">[('workflow_current_state_id.code', '=', 'approval')]</field>
            <field name="filter_domain">[('workflow_current_state_id.code', '=', 'completed')]</field>
            <field name="state">email</field>
            <field name="template_id" ref="email_template_tender_approved_notification"/>
        </record>

        <!-- Automated Action: Send Email When Tender is Rejected/Returned -->
        <record id="automation_tender_rejected_email" model="base.automation">
            <field name="name">İhale İade Edildi - Email Gönder</field>
            <field name="model_id" ref="model_ak_tender"/>
            <field name="active" eval="True"/>
            <field name="trigger">on_write</field>
            <field name="filter_pre_domain">[('workflow_current_state_id.code', '=', 'approval')]</field>
            <field name="filter_domain">[('workflow_current_state_id.code', '=', 'evaluation')]</field>
            <field name="state">email</field>
            <field name="template_id" ref="email_template_tender_rejected_notification"/>
        </record>
    </data>
</odoo>