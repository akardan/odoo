<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- İLKO Direkt Satın Alma Workflow -->
        <record id="ak_workflow.workflow_ilko_direkt" model="tier.definition">
            <field name="name">İLKO Direkt Satın Alma</field>
            <field name="model_id" ref="ak_tender.model_ak_tender"/>
            <field name="is_workflow" eval="True"/>
            <field name="code">ILKO_DIREKT</field>
            <field name="category">procurement</field>
            <field name="description"><![CDATA[
                <h3>İLKO Direkt Satın Alma Workflow'u</h3>
                <p>Direkt satın alma süreçleri için özelleştirilmiş workflow.</p>
            ]]></field>
            <field name="sequence">10</field>
        </record>
        
        <!-- States for Direkt Workflow -->
        <record id="ak_workflow.state_direkt_draft" model="ak.workflow.state">
            <field name="name">Taslak</field>
            <field name="code">draft</field>
            <field name="workflow_id" ref="ak_workflow.workflow_ilko_direkt"/>
            <field name="is_initial" eval="True"/>
            <field name="sequence">10</field>
        </record>
        
        <record id="ak_workflow.state_direkt_approval" model="ak.workflow.state">
            <field name="name">Onay Bekliyor</field>
            <field name="code">approval</field>
            <field name="workflow_id" ref="ak_workflow.workflow_ilko_direkt"/>
            <field name="sequence">20</field>
        </record>

        <record id="ak_workflow.state_direkt_approved" model="ak.workflow.state">
            <field name="name">Onaylandı</field>
            <field name="code">approved</field>
            <field name="workflow_id" ref="ak_workflow.workflow_ilko_direkt"/>
            <field name="sequence">30</field>
        </record>

        <record id="ak_workflow.state_direkt_completed" model="ak.workflow.state">
            <field name="name">Tamamlandı</field>
            <field name="code">completed</field>
            <field name="workflow_id" ref="ak_workflow.workflow_ilko_direkt"/>
            <field name="is_final" eval="True"/>
            <field name="sequence">100</field>
        </record>

        <!-- Set initial state for Direkt workflow -->
        <record id="ak_workflow.workflow_ilko_direkt" model="tier.definition">
            <field name="initial_state_id" ref="ak_workflow.state_direkt_draft"/>
        </record>

        <!-- Transitions for Direkt Workflow -->
        <record id="ak_workflow.trans_direkt_submit" model="ak.workflow.transition">
            <field name="name">Onaya Gönder</field>
            <field name="workflow_id" ref="ak_workflow.workflow_ilko_direkt"/>
            <field name="from_state_id" ref="ak_workflow.state_direkt_draft"/>
            <field name="to_state_id" ref="ak_workflow.state_direkt_approval"/>
            <field name="require_tier_validation" eval="True"/>
        </record>

        <record id="ak_workflow.trans_direkt_approve" model="ak.workflow.transition">
            <field name="name">Onayla</field>
            <field name="workflow_id" ref="ak_workflow.workflow_ilko_direkt"/>
            <field name="from_state_id" ref="ak_workflow.state_direkt_approval"/>
            <field name="to_state_id" ref="ak_workflow.state_direkt_approved"/>
        </record>

        <record id="ak_workflow.trans_direkt_complete" model="ak.workflow.transition">
            <field name="name">Tamamla</field>
            <field name="workflow_id" ref="ak_workflow.workflow_ilko_direkt"/>
            <field name="from_state_id" ref="ak_workflow.state_direkt_approved"/>
            <field name="to_state_id" ref="ak_workflow.state_direkt_completed"/>
        </record>

    </data>
</odoo>