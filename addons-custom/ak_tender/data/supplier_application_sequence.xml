<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sequence for Supplier Application Numbers -->
    <record id="sequence_supplier_application" model="ir.sequence">
        <field name="name">Supplier Application</field>
        <field name="code">supplier.application</field>
        <field name="prefix">SUP/APP/</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
        <field name="number_next">1</field>
        <field name="implementation">standard</field>
    </record>
</odoo>