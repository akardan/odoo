<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Email Import Scheduled Action -->
        <record id="ir_cron_email_import_sat" model="ir.cron">
            <field name="name">SAT Email Import</field>
            <field name="model_id" ref="model_ak_tender_email_import"/>
            <field name="state">code</field>
            <field name="code">model.scheduled_email_import()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="False"/>
            <field name="user_id" ref="base.user_root"/>
        </record>
    </data>
</odoo>