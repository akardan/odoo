<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Email template for notifying purchaser about supplier tender update -->
        <record id="email_template_supplier_tender_update" model="mail.template">
            <field name="name">Supplier Tender Update Notification</field>
            <field name="model_id" ref="purchase.model_purchase_order"/>
            <field name="subject">Tedarikçi Teklifi Güncellendi: {{ object.name }}{% if object.tender_id %} (İhale No: {{ object.tender_id.code }}){% endif %}</field>
            <field name="email_from"></field>
            <field name="email_to">{{ object.user_id.email_formatted }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Merhaba <t t-out="object.user_id.name or ''"/>,
                        <br/><br/>
                        <t t-if="object.tender_id">
                            <strong>İhale No:</strong> <t t-out="object.tender_id.code or ''">İHALE001</t><br/>
                        </t>
                        <t t-out="object.partner_id.name or ''"/> adlı tedarikçi,
                        <a t-attf-href="{{ object.get_base_url() }}/web#id={{ object.id }}&amp;model=purchase.order&amp;view_type=form" style="text-decoration:none;"><t t-out="object.name or ''"/></a>
                        numaralı teklifi portal üzerinden güncellemiştir.
                        <br/><br/>
                        Teklif detaylarını incelemek için aşağıdaki bağlantıyı kullanabilirsiniz:
                        <br/>
                        <div style="margin: 16px 0px 16px 0px;">
                            <a t-attf-href="{{ object.get_base_url() }}/web#id={{ object.id }}&amp;model=purchase.order&amp;view_type=form" style="padding: 8px 16px 8px 16px; font-size: 14px; color: #FFFFFF; text-decoration: none !important; background-color: #875A7B; border: 0px solid #875A7B; border-radius:3px">
                                Teklifi Görüntüle
                            </a>
                        </div>
                        <br/><br/>
                        Saygılarımızla,
                        <br/>
                        <t t-out="user.company_id.name or ''"/>
                    </p>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

        <!-- Email template for notifying buyer when all suppliers have submitted offers -->
        <record id="email_template_all_offers_submitted" model="mail.template">
            <field name="name">All Suppliers Submitted Offers Notification</field>
            <field name="model_id" ref="model_ak_tender"/>
            <field name="subject">Tüm Tedarikçiler Teklif Verdi: {{ object.code }}</field>
            <field name="email_from"></field>
            <field name="email_to">{{ object.buyer_id.email_formatted }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Merhaba <t t-out="object.buyer_id.name or ''"/>,
                        <br/><br/>
                        <strong>İhale No:</strong> <t t-out="object.code or ''">İHALE001</t><br/>
                        <strong>İhale Adı:</strong> <t t-out="object.name or ''"/><br/>
                        <strong>Teklif Turu:</strong> <t t-out="object.tender_round or 1"/><br/>
                        <br/>
                        Tüm davetli tedarikçiler tekliflerini sunmuşlardır.
                        <br/><br/>
                        <strong>Davetli Tedarikçi Sayısı:</strong> <t t-out="len(object.invited_partners)"/>
                        <br/>
                        <strong>Teklif Veren Tedarikçiler:</strong>
                        <ul>
                            <t t-foreach="object.purchase_order_ids.filtered(lambda po: po.tender_round == object.tender_round and po.amount_total > 0 and po.state != 'cancel')" t-as="po">
                                <li><t t-out="po.partner_id.name"/> - <t t-out="po.currency_id.symbol"/><t t-out="'{:,.2f}'.format(po.amount_total)"/></li>
                            </t>
                        </ul>
                        <br/>
                        Teklifleri incelemek ve karşılaştırma yapmak için aşağıdaki bağlantıyı kullanabilirsiniz:
                        <br/>
                        <div style="margin: 16px 0px 16px 0px;">
                            <a t-attf-href="{{ object.get_base_url() }}/web#id={{ object.id }}&amp;model=ak.tender&amp;view_type=form" style="padding: 8px 16px 8px 16px; font-size: 14px; color: #FFFFFF; text-decoration: none !important; background-color: #875A7B; border: 0px solid #875A7B; border-radius:3px">
                                İhaleyi Görüntüle
                            </a>
                        </div>
                        <br/><br/>
                        Saygılarımızla,
                        <br/>
                        <t t-out="user.company_id.name or ''"/>
                    </p>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>