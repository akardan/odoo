<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- MICE Tender Template: Konferans Organizasyonu -->
        <record id="tender_template_conference" model="ak.tender.template">
            <field name="name">Konferans Organizasyonu</field>
            <field name="code">MICE-CONF-001</field>
            <field name="description">Standart konferans organizasyonu için şablon. Konaklama, ulaşım, yemek ve mekan hizmetlerini içerir.</field>
            <field name="tender_type">mice</field>
            <field name="is_locked">False</field>
            <field name="country_ids" eval="[(4, ref('base.tr'))]"/>
        </record>

        <!-- Conference Template Lines -->
        <record id="tender_template_line_conf_section1" model="ak.tender.template.line">
            <field name="template_id" ref="tender_template_conference"/>
            <field name="sequence">10</field>
            <field name="display_type">line_section</field>
            <field name="name">Konaklama Hizmetleri</field>
        </record>

        <record id="tender_template_line_conf_hotel" model="ak.tender.template.line">
            <field name="template_id" ref="tender_template_conference"/>
            <field name="sequence">20</field>
            <field name="display_type">product</field>
            <field name="name">Otel Konaklama (Tek Kişilik)</field>
            <field name="product_qty">50</field>
            <field name="required">True</field>
            <field name="allow_alternative">True</field>
        </record>

        <record id="tender_template_line_conf_section2" model="ak.tender.template.line">
            <field name="template_id" ref="tender_template_conference"/>
            <field name="sequence">30</field>
            <field name="display_type">line_section</field>
            <field name="name">Ulaşım Hizmetleri</field>
        </record>

        <record id="tender_template_line_conf_transport" model="ak.tender.template.line">
            <field name="template_id" ref="tender_template_conference"/>
            <field name="sequence">40</field>
            <field name="display_type">product</field>
            <field name="name">Havaalanı-Otel Transfer</field>
            <field name="product_qty">10</field>
            <field name="required">True</field>
            <field name="allow_alternative">True</field>
        </record>

        <record id="tender_template_line_conf_section3" model="ak.tender.template.line">
            <field name="template_id" ref="tender_template_conference"/>
            <field name="sequence">50</field>
            <field name="display_type">line_section</field>
            <field name="name">Yemek Hizmetleri</field>
        </record>

        <record id="tender_template_line_conf_catering" model="ak.tender.template.line">
            <field name="template_id" ref="tender_template_conference"/>
            <field name="sequence">60</field>
            <field name="display_type">product</field>
            <field name="name">Konferans Yemek Hizmeti (Kişi Başı)</field>
            <field name="product_qty">100</field>
            <field name="required">True</field>
            <field name="allow_alternative">True</field>
        </record>

        <record id="tender_template_line_conf_section4" model="ak.tender.template.line">
            <field name="template_id" ref="tender_template_conference"/>
            <field name="sequence">70</field>
            <field name="display_type">line_section</field>
            <field name="name">Mekan Hizmetleri</field>
        </record>

        <record id="tender_template_line_conf_venue" model="ak.tender.template.line">
            <field name="template_id" ref="tender_template_conference"/>
            <field name="sequence">80</field>
            <field name="display_type">product</field>
            <field name="name">Konferans Salonu Kiralama</field>
            <field name="product_qty">1</field>
            <field name="required">True</field>
            <field name="allow_alternative">False</field>
        </record>

        <record id="tender_template_line_conf_note" model="ak.tender.template.line">
            <field name="template_id" ref="tender_template_conference"/>
            <field name="sequence">90</field>
            <field name="display_type">line_note</field>
            <field name="name">Not: Tüm hizmetler için fiyat teklifleri KDV hariç olarak verilmelidir. Konferans tarihleri kesinleştiğinde tedarikçilere bildirilecektir.</field>
        </record>

