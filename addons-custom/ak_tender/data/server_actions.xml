<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Server Action for NPV Calculation -->
        <record id="action_calculate_all_npv_values" model="ir.actions.server">
            <field name="name">NPV Değerlerini Hesapla</field>
            <field name="model_id" ref="model_ak_tender"/>
            <field name="binding_model_id" ref="model_ak_tender"/>
            <field name="binding_view_types">form,list</field>
            <field name="state">code</field>
            <field name="code">
if records:
    for record in records:
        record.calculate_all_npv_values()
</field>
            <field name="groups_id" eval="[(4, ref('group_tender_user'))]"/>
            <field name="sequence" eval="15"/>  <!-- Set sequence to appear right after "Tedarikçi Ekle" action -->
        </record>
        
        <!-- Server Action for Creating Purchase Orders for Suppliers -->
        <record id="action_create_purchase_orders_for_suppliers" model="ir.actions.server">
            <field name="name">Tedarikçiler İçin SAT Oluştur</field>
            <field name="model_id" ref="model_ak_tender"/>
            <field name="binding_model_id" ref="model_ak_tender"/>
            <field name="binding_view_types">form</field>
            <field name="state">code</field>
            <field name="code">
if records:
    for record in records:
        record.create_purchase_orders_for_suppliers()
</field>
            <field name="groups_id" eval="[(4, ref('group_tender_user'))]"/>
            <field name="sequence" eval="11"/>  <!-- Set sequence to appear right after "Tedarikçi Ekle" action -->
        </record>
        
        <!-- Server Action for Sending Bulk Emails -->
        <record id="action_send_bulk_emails_server" model="ir.actions.server">
            <field name="name">Toplu E-posta Gönder</field>
            <field name="model_id" ref="model_ak_tender"/>
            <field name="binding_model_id" ref="model_ak_tender"/>
            <field name="binding_view_types">form</field>
            <field name="state">code</field>
            <field name="code">
if records:
    for record in records:
        record.action_send_bulk_emails()
</field>
            <field name="groups_id" eval="[(4, ref('group_tender_user'))]"/>
            <field name="sequence" eval="12"/>  <!-- Set sequence to appear after "Tedarikçiler İçin SAT Oluştur" action -->
        </record>
        
        <!-- Server Action: Calculate Target Prices from Lowest Offers -->
        <record id="action_server_set_target_price" model="ir.actions.server">
            <field name="name">Hedef Fiyat Hesapla</field>
            <field name="model_id" ref="model_ak_tender"/>
            <field name="binding_model_id" ref="model_ak_tender"/>
            <field name="binding_view_types">form</field>
            <field name="state">code</field>
            <field name="code">
if records:
    for record in records:
        action = record.action_set_target_price()
</field>
            <field name="groups_id" eval="[(4, ref('group_tender_user'))]"/>
            <field name="sequence" eval="14"/>
        </record>
        
        <!-- Server Action: Trigger Move Tender Lines Wizard -->
        <record id="action_server_move_tender_lines" model="ir.actions.server">
            <field name="name">Yeni İhaleye Taşı</field>
            <field name="model_id" ref="ak_tender.model_ak_tender"/>
            <field name="state">code</field>
            <field name="code">
action = model.env.ref('ak_tender.action_ak_tender_move_lines_wizard').read()[0]
action['context'] = {'active_id': records.id}
            </field>
        </record>
    </data>
</odoo>