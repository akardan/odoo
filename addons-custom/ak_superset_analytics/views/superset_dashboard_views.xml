<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Dashboard Configuration Form View -->
    <record id="view_superset_dashboard_form" model="ir.ui.view">
        <field name="name">superset.dashboard.form</field>
        <field name="model">superset.dashboard</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="get_embedded_url" string="Test Connection"
                            type="object" class="btn-primary"
                            context="{'from_button': True}"/>
                    <button name="install_pyjwt" string="Install PyJWT"
                            type="object" class="btn-secondary"
                            help="Install the PyJWT package required for SSO authentication"/>
                    <button name="view_dashboard_new_window" string="View Dashboard (New Window)"
                            type="object" class="btn-success"
                            help="Open the dashboard directly in a new window"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert">
                        <p><strong>Note:</strong> The PyJWT package is required for SSO authentication. If it's not installed, you can install it by clicking the "Install PyJWT" button above.</p>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="dashboard_id"/> e
                            <field name="superset_url"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="jwt_secret" password="True"/>
                            <field name="allowed_groups" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group string="Superset User Credentials">
                        <group>
                            <field name="superset_username"/>
                            <field name="superset_first_name"/>
                        </group>
                        <group>
                            <field name="superset_email"/>
                            <field name="superset_last_name"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Dashboard List View -->
    <record id="view_superset_dashboard_list" model="ir.ui.view">
        <field name="name">superset.dashboard.list</field>
        <field name="model">superset.dashboard</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="dashboard_id"/>
                <field name="superset_url"/>
                <field name="active"/>
                <button name="view_dashboard_new_window" string="Görüntüle"
                        type="object" class="btn-primary"/>
            </list>
        </field>
    </record>

    <!-- Dashboard Search View -->
    <record id="view_superset_dashboard_search" model="ir.ui.view">
        <field name="name">superset.dashboard.search</field>
        <field name="model">superset.dashboard</field>
        <field name="arch" type="xml">
            <search string="Superset Dashboard Arama">
                <!-- Search Fields -->
                <field name="name" string="Dashboard Adı"
                       filter_domain="['|', ('name', 'ilike', self), ('dashboard_id', 'ilike', self)]"/>
                <field name="dashboard_id" string="Dashboard ID"/>
                <field name="superset_url" string="Superset URL"/>
                <field name="superset_username" string="Kullanıcı Adı"/>
                <field name="superset_email" string="Email"/>
                <field name="allowed_groups" string="İzin Verilen Gruplar"/>
                <field name="create_uid" string="Oluşturan"/>
                
                <!-- Filters -->
                <filter string="Aktif" name="active" domain="[('active', '=', True)]"/>
                <filter string="Arşivlenmiş" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Benim Dashboard'larım" name="my_dashboards"
                        domain="[('create_uid', '=', uid)]"/>
                <separator/>
                <filter string="Oluşturma Tarihi" name="creation_date"
                        date="create_date"/>
                <filter string="Güncelleme Tarihi" name="write_date"
                        date="write_date"/>
                
                <!-- Group By -->
                <group expand="0" string="Grupla">
                    <filter string="Durum" name="group_active"
                            context="{'group_by': 'active'}"/>
                    <filter string="Superset URL" name="group_url"
                            context="{'group_by': 'superset_url'}"/>
                    <filter string="Oluşturan Kullanıcı" name="group_creator"
                            context="{'group_by': 'create_uid'}"/>
                    <filter string="Oluşturma Tarihi" name="group_create_date"
                            context="{'group_by': 'create_date'}"/>
                </group>
                
                <!-- Search Panel - Quick Filters -->
                <searchpanel>
                    <field name="create_uid" string="Oluşturan" icon="fa-user"
                           select="multi" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>
    
    <!-- Dashboard Kanban View - Final Clean Version -->
    <record id="view_superset_dashboard_kanban" model="ir.ui.view">
        <field name="name">superset.dashboard.kanban</field>
        <field name="model">superset.dashboard</field>
        <field name="arch" type="xml">
            <kanban string="Dashboard Overview" class="o_dashboard_kanban" edit="false"  create="0" can_open="0" sample="1" style="min-height: 220px;">
                <field name="id"/>
                <field name="name"/>
                <field name="dashboard_id"/>
                <field name="superset_url"/>
                <field name="active"/>
                <field name="create_date"/>
                <field name="write_date"/>
                <field name="create_uid"/>
                <templates>
                    <t t-name="menu">
                        <div class="o_kanban_dashboard_card_manage_pane">
                            <a role="menuitem" name="view_dashboard_new_window" class="dropdown-item" type="object">Dashboard'ı Aç</a>
                            <a role="menuitem" type="open" class="dropdown-item">Düzenle</a>
                        </div>
                    </t>
                    <t t-name="card">
                        <widget name="web_ribbon" title="Arşivlenmiş" bg_color="text-bg-danger" invisible="active"/>
                        <widget name="web_ribbon" title="Aktif" bg_color="text-bg-success" invisible="not active"/>
                        
                        <field name="name" class="fw-bold fs-4 me-auto ms-1"/>
                        
                        <div style="min-height: 40px;"></div>
                        
                        <div name="card_content" class="row mt-auto">
                            <a t-if="record.active.raw_value" 
                            name="view_dashboard_new_window" 
                            type="object" 
                            class="d-flex flex-column align-items-center col-6">
                                <i class="fa fa-eye fa-2x text-success"/>
                                <span class="fw-bold text-truncate mw-100" title="Görüntüle">Görüntüle</span>
                            </a>
                            <a t-if="!record.active.raw_value" 
                            class="d-flex flex-column align-items-center col-6 text-muted">
                                <i class="fa fa-pause-circle fa-2x"/>
                                <span class="fw-bold text-truncate mw-100" title="Pasif">Pasif</span>
                            </a>
                            <div class="col-6">
                                <div class="row">
                                    <div class="d-flex flex-column align-items-center col-6">
                                        <field name="create_uid" widget="many2one_avatar_user"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Dashboard Action -->
    <record id="action_superset_dashboard" model="ir.actions.act_window">
        <field name="name">Superset Dashboards</field>
        <field name="res_model">superset.dashboard</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

</odoo>