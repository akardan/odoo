<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <record id="module_category_workflow" model="ir.module.category">
            <field name="name">Workflow</field>
            <field name="description">User access levels for the Workflow Engine.</field>
            <field name="sequence">25</field>
        </record>
        
        <record id="group_workflow_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_workflow"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Users can view and execute assigned workflow transitions.</field>
        </record>
        
        <record id="group_workflow_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_workflow"/>
            <field name="implied_ids" eval="[(4, ref('group_workflow_user'))]"/>
            <field name="comment">Managers can create and configure workflows.</field>
        </record>

    </data>
    <data>
        <!-- Rules for tier.definition when it's a workflow -->
        <record id="tier_definition_workflow_rule_manager" model="ir.rule">
            <field name="name">Workflow Definition: Manager Access</field>
            <field name="model_id" ref="base_tier_validation.model_tier_definition"/>
            <field name="domain_force">[('is_workflow', '=', True)]</field>
            <field name="groups" eval="[(4, ref('group_workflow_manager'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>
    </data>
</odoo>