<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ak_workflow.WorkflowButtonGroup" owl="1">
        <div class="o_workflow_button_group d-flex flex-nowrap">
            <t t-foreach="state.transitions" t-as="transition" t-key="transition.id">
                <button t-att-class="'btn ' + (transition.button_class || 'btn-primary') + ' me-1'" t-on-click="() => this.onButtonClick(transition.id)">
                    <t t-esc="transition.name"/>
                </button>
            </t>
        </div>
    </t>
</templates>