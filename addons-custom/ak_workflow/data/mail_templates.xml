<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Generic Notification Template -->
        <record id="mail_template_workflow_generic" model="mail.template">
            <field name="name">Workflow: Generic Notification</field>
            <field name="model_id" ref="base.model_res_partner"/> <!-- Generic model -->
            <field name="subject">Workflow Notification: ${object.display_name}</field>
            <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; font-size: 14px;">
    <p>Hello,</p>
    <p>This is a notification regarding the record <strong>${object.display_name}</strong>.</p>
    <p>It has transitioned to the state: <strong>${object.workflow_current_state_id.name}</strong>.</p>
    <br/>
    <div style="margin: 16px 0;">
        <a href="${object.get_portal_url()}" style="background-color: #875A7B; padding: 10px 20px; color: #FFF; text-decoration: none; border-radius: 5px;">View Record</a>
    </div>
    <p>Thank you,</p>
    <p>The Odoo Workflow System</p>
</div>
            ]]></field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>