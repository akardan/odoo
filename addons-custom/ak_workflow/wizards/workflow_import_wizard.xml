<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="workflow_import_wizard_form" model="ir.ui.view">
        <field name="name">workflow.import.wizard.form</field>
        <field name="model">ak.workflow.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Workflow">
                <group>
                    <field name="workflow_data" filename="file_name"/>
                    <field name="file_name" invisible="1"/>
                </group>
                <footer>
                    <button string="Import" name="action_import_workflow" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_workflow_import" model="ir.actions.act_window">
        <field name="name">Import Workflow</field>
        <field name="res_model">ak.workflow.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_workflow_import"
              name="Import Workflow"
              parent="menu_workflow_configuration"
              action="action_workflow_import"
              sequence="100"/>
</odoo>