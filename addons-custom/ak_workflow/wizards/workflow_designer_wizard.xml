<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="workflow_designer_wizard_form" model="ir.ui.view">
        <field name="name">workflow.designer.wizard.form</field>
        <field name="model">ak.workflow.designer.wizard</field>
        <field name="arch" type="xml">
            <form string="Workflow Designer">
                <field name="workflow_id" invisible="1"/>
                <!-- The JS widget for the designer will be placed here -->
                <div id="workflow_designer_widget">
                    <h1>Workflow Designer for <field name="workflow_id" readonly="1"/></h1>
                    <p>The visual designer will be rendered here.</p>
                </div>
                <footer>
                    <button string="Save" name="action_save_workflow" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>