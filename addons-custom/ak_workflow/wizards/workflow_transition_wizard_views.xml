<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ak_workflow_transition_wizard_view_form" model="ir.ui.view">
            <field name="name">ak.workflow.transition.wizard.form</field>
            <field name="model">ak.workflow.transition.wizard</field>
            <field name="arch" type="xml">
                <form string="Geçişi Uygula">
                    <group>
                        <field name="res_model" invisible="1"/>
                        <field name="res_id" invisible="1"/>
                        <field name="transition_id" invisible="1"/>
                        <div colspan="2">
                            <span>Bu geçişi uygulamak üzeresiniz: </span>
                            <strong><field name="transition_id" readonly="1" nolabel="1" class="oe_inline"/></strong>
                            <span> ( </span><field name="transition_display_info" readonly="1" nolabel="1" class="oe_inline"/><span> )</span>
                        </div>
                        <field name="comment" placeholder="İsteğe bağlı yorum ekleyin..."/>
                    </group>
                    
                    <group string="Çalıştırılacak Aksiyonlar">
                        <field name="actions_info" nolabel="1"/>
                    </group>
                    <footer>
                        <button name="execute_transition" type="object" string="Uygula" class="btn-primary"/>
                        <button string="İptal" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>