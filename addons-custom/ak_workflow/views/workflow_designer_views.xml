<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--
            Workflow Designer Views
            This view is intended to be a placeholder for a future graphical workflow designer.
            For now, it provides a list of workflows to manage.
        -->

        <record id="view_workflow_designer_list" model="ir.ui.view">
            <field name="name">workflow.designer.list</field>
            <field name="model">tier.definition</field>
            <field name="arch" type="xml">
                <list string="Workflow Designer">
                    <field name="name"/>
                    <field name="model_id"/>
                    <field name="code"/>
                    <field name="category"/>
                </list>
            </field>
        </record>

        <record id="action_workflow_designer" model="ir.actions.act_window">
            <field name="name">Workflow Designer</field>
            <field name="res_model">tier.definition</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('is_workflow', '=', True)]</field>
            <field name="context">{'default_is_workflow': True}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new workflow.
                </p>
            </field>
        </record>

        <menuitem
            id="menu_workflow_designer"
            name="Designer"
            parent="menu_ak_workflow_root"
            action="action_workflow_designer"
            sequence="20"/>

    </data>
</odoo>