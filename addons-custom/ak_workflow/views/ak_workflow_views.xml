<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherited Tier Definition Views -->
    <record id="tier_definition_form_inherit_workflow" model="ir.ui.view">
        <field name="name">tier.definition.form.inherit.workflow</field>
        <field name="model">tier.definition</field>
        <field name="inherit_id" ref="base_tier_validation.tier_definition_view_form"/>
        <field name="arch" type="xml">
            <sheet position="before">
                <header>
                    <button name="action_validate_workflow" string="Validate Workflow"
                            type="object" class="btn-primary"
                            attrs="{'invisible': [('is_workflow', '=', False)]}"/>
                </header>
            </sheet>
            <xpath expr="//sheet/group[1]" position="after">
                <group string="Workflow Configuration" attrs="{'invisible': [('is_workflow', '=', False)]}">
                    <group>
                        <field name="is_workflow"/>
                        <field name="code" attrs="{'required': [('is_workflow', '=', True)], 'invisible': [('is_workflow', '=', False)]}"/>
                        <field name="category" attrs="{'invisible': [('is_workflow', '=', False)]}"/>
                    </group>
                </group>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="States" attrs="{'invisible': [('is_workflow', '=', False)]}">
                    <field name="state_ids" context="{'default_workflow_id': active_id}">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name" required="1"/>
                            <field name="code" required="1"/>
                            <field name="is_initial"/>
                            <field name="is_final"/>
                            <field name="allow_edit"/>
                        </list>
                    </field>
                </page>
                <page string="Transitions" attrs="{'invisible': [('is_workflow', '=', False)]}">
                    <field name="transition_ids" context="{'default_workflow_id': active_id}">
                        <list>
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="from_state_id"/>
                            <field name="to_state_id"/>
                            <field name="require_tier_validation"/>
                            <field name="active" widget="boolean_toggle"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- State Views -->
    <record id="ak_workflow_state_form_view" model="ir.ui.view">
        <field name="name">ak.workflow.state.form</field>
        <field name="model">ak.workflow.state</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="workflow_id"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="is_initial"/>
                            <field name="is_final"/>
                            <field name="allow_edit"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Entry Actions">
                            <field name="entry_action_ids"/>
                        </page>
                        <page string="Exit Actions">
                            <field name="exit_action_ids"/>
                        </page>
                        <page string="Security">
                            <field name="edit_group_ids" widget="many2many_tags"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Transition Views -->
    <record id="ak_workflow_transition_form_view" model="ir.ui.view">
        <field name="name">ak.workflow.transition.form</field>
        <field name="model">ak.workflow.transition</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="workflow_id"/>
                            <field name="from_state_id"/>
                            <field name="to_state_id"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="button_label"/>
                            <field name="button_class"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Conditions">
                            <group>
                                <field name="condition_type"/>
                                <field name="condition_expression" attrs="{'invisible': [('condition_type', '!=', 'python')]}"/>
                                <field name="condition_field_id" attrs="{'invisible': [('condition_type', '!=', 'field')]}"/>
                                <field name="condition_operator" attrs="{'invisible': [('condition_type', '!=', 'field')]}"/>
                                <field name="condition_value" attrs="{'invisible': [('condition_type', '!=', 'field')]}"/>
                                <field name="condition_method" attrs="{'invisible': [('condition_type', '!=', 'method')]}"/>
                                <field name="amount_threshold" attrs="{'invisible': [('condition_type', '!=', 'amount')]}"/>
                                <field name="amount_currency_id" attrs="{'invisible': [('condition_type', '!=', 'amount')]}"/>
                            </group>
                        </page>
                        <page string="Security">
                            <field name="group_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Actions">
                            <field name="action_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_ak_workflow_root" name="AK Workflow" sequence="100" web_icon="ak_workflow,static/description/icon.png"/>
    <menuitem id="menu_workflow_configuration" name="Configuration" parent="menu_ak_workflow_root" sequence="10"/>
    <menuitem id="menu_workflow_definitions" name="Workflows" parent="menu_workflow_configuration" action="base_tier_validation.action_tier_definition" sequence="10"/>
    <menuitem id="menu_workflow_states" name="States" parent="menu_workflow_configuration" action="action_ak_workflow_state" sequence="20"/>
    <menuitem id="menu_workflow_transitions" name="Transitions" parent="menu_workflow_configuration" action="action_ak_workflow_transition" sequence="30"/>
    <menuitem id="menu_workflow_actions" name="Actions" parent="menu_workflow_configuration" action="action_ak_workflow_action" sequence="40"/>

</odoo>