<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="ak_workflow_definition_view_form" model="ir.ui.view">
            <field name="name">ak.workflow.definition.form</field>
            <field name="model">ak.workflow.definition</field>
            <field name="arch" type="xml">
                <form string="Workflow Definition">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="model_id"/>
                            <field name="model_name" readonly="1"/>
                            <field name="active"/>
                            <field name="initial_state_id"/>
                        </group>
                        <notebook>
                            <page string="States">
                                <field name="state_ids">
                                    <list>
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="code"/>
                                        <field name="is_initial"/>
                                        <field name="is_final"/>
                                        <field name="allow_edit"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Transitions">
                                <field name="transition_ids">
                                    <list string="Transitions">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name" string="Transition"/>
                                        <field name="from_state_id"/>
                                        <field name="to_state_id"/>
                                        <field name="button_label"/>
                                        <field name="condition_type"/>
                                        <field name="group_ids" widget="many2many_tags"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="ak_workflow_definition_view_tree" model="ir.ui.view">
            <field name="name">ak.workflow.definition.tree</field>
            <field name="model">ak.workflow.definition</field>
            <field name="arch" type="xml">
                <list string="Workflow Definitions">
                    <field name="name"/>
                    <field name="model_name"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <record id="ak_workflow_definition_action" model="ir.actions.act_window">
            <field name="name">Workflow Definitions</field>
            <field name="res_model">ak.workflow.definition</field>
            <field name="view_mode">tree,form</field>
        </record>

    </data>
</odoo>