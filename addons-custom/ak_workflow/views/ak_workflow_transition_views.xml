<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ak_workflow_transition_form_view" model="ir.ui.view">
            <field name="name">ak.workflow.transition.form</field>
            <field name="model">ak.workflow.transition</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="workflow_id"/>
                                <field name="from_state_id"/>
                                <field name="to_state_id"/>
                            </group>
                            <group>
                                <field name="sequence"/>
                                <field name="button_label"/>
                                <field name="button_class"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Conditions">
                                <group>
                                    <field name="condition_type"/>
                                    <field name="condition_expression" invisible="condition_type != 'python'"/>
                                    <field name="condition_field_id" invisible="condition_type != 'field'"/>
                                    <field name="condition_operator" invisible="condition_type != 'field'"/>
                                    <field name="condition_value" invisible="condition_type != 'field'"/>
                                    <field name="condition_method" invisible="condition_type != 'method'"/>
                                    <field name="amount_threshold" invisible="condition_type != 'amount'"/>
                                    <field name="amount_currency_id" invisible="condition_type != 'amount'"/>
                                </group>
                            </page>
                            <page string="Security">
                                <field name="group_ids" widget="many2many_tags"/>
                            </page>
                            <page string="Actions">
                                <field name="action_ids">
                                    <list>
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="action_type"/>
                                        <field name="active"/>
                                    </list>
                                    <form>
                                        <sheet>
                                            <group>
                                                <group>
                                                    <field name="name"/>
                                                    <field name="trigger_event"/>
                                                    <field name="action_type"/>
                                                    <field name="sequence"/>
                                                    <field name="active"/>
                                                </group>
                                            </group>
                                            <notebook>
                                                <page string="Action Configuration">
                                                    <group>
                                                        <field name="email_template_id" invisible="action_type != 'email'"/>
                                                        <field name="method_name" invisible="action_type != 'method'"/>
                                                        <field name="field_id" invisible="action_type != 'field_update'"/>
                                                        <field name="field_value" invisible="action_type != 'field_update'"/>
                                                        <field name="create_model_id" invisible="action_type != 'create_record'"/>
                                                        <field name="create_values" invisible="action_type != 'create_record'"/>
                                                        <field name="webhook_url" invisible="action_type != 'webhook'"/>
                                                        <field name="webhook_method" invisible="action_type != 'webhook'"/>
                                                        <field name="webhook_data_expression" invisible="action_type != 'webhook'"/>
                                                        <field name="notification_title" invisible="action_type != 'notification'"/>
                                                        <field name="notification_message" invisible="action_type != 'notification'"/>
                                                        <field name="notification_type" invisible="action_type != 'notification'"/>
                                                        <field name="activity_type_id" invisible="action_type != 'activity'"/>
                                                        <field name="activity_summary" invisible="action_type != 'activity'"/>
                                                        <field name="activity_note" invisible="action_type != 'activity'"/>
                                                        <field name="activity_user_id" invisible="action_type != 'activity'"/>
                                                        <field name="server_action_id" invisible="action_type != 'server_action'"/>
                                                    </group>
                                                </page>
                                                <page string="Conditions">
                                                    <group>
                                                        <field name="condition_expression" placeholder="Python expression that must return True"/>
                                                        <field name="continue_on_error"/>
                                                    </group>
                                                </page>
                                            </notebook>
                                        </sheet>
                                    </form>
                                </field>
                            </page>
                            <page string="Aşamalar" name="stages">
                                <group>
                                    <field name="stage_count" readonly="1"/>
                                    <field name="has_stages" invisible="1"/>
                                </group>
                                <field name="stage_ids">
                                    <list>
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="code"/>
                                        <field name="button_label"/>
                                        <field name="condition_type"/>
                                        <field name="active"/>
                                    </list>
                                    <form>
                                        <sheet>
                                            <group>
                                                <group>
                                                    <field name="name"/>
                                                    <field name="code"/>
                                                    <field name="sequence"/>
                                                </group>
                                                <group>
                                                    <field name="button_label"/>
                                                    <field name="button_class"/>
                                                    <field name="icon"/>
                                                    <field name="active"/>
                                                </group>
                                            </group>
                                            <notebook>
                                                <page string="Security">
                                                    <field name="group_ids" widget="many2many_tags"/>
                                                </page>
                                                <page string="Conditions">
                                                    <group>
                                                        <field name="condition_type"/>
                                                        <field name="condition_expression" invisible="condition_type != 'python'"/>
                                                    </group>
                                                </page>
                                                <page string="Actions">
                                                    <field name="action_ids">
                                                        <list>
                                                            <field name="sequence" widget="handle"/>
                                                            <field name="name"/>
                                                            <field name="action_type"/>
                                                            <field name="active"/>
                                                        </list>
                                                    </field>
                                                </page>
                                            </notebook>
                                        </sheet>
                                    </form>
                                </field>
                                <div class="alert alert-info" role="alert">
                                    <strong>ℹ️ Aşamalı Geçiş:</strong> Eğer aşamalar tanımlarsanız, geçiş sırayla her aşamadan geçecektir. 
                                    Tüm aşamalar tamamlandığında hedef state'e geçiş yapılır. Aşama yoksa direkt geçiş yapılır.
                                </div>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_ak_workflow_transition" model="ir.actions.act_window">
            <field name="name">Transitions</field>
            <field name="res_model">ak.workflow.transition</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>