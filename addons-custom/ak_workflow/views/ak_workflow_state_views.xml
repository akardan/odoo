<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ak_workflow_state_form_view" model="ir.ui.view">
            <field name="name">ak.workflow.state.form</field>
            <field name="model">ak.workflow.state</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="code"/>
                                <field name="workflow_id"/>
                            </group>
                            <group>
                                <field name="sequence"/>
                                <field name="is_initial"/>
                                <field name="is_final"/>
                                <field name="allow_edit"/>
                                <field name="default_duration_days"/>
                                <field name="fold"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Transitions">
                                <group>
                                    <group>
                                        <field name="outgoing_transition_ids"/>
                                    </group>
                                    <group>
                                        <field name="incoming_transition_ids"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Entry Actions">
                                <field name="entry_action_ids"/>
                            </page>
                            <page string="Exit Actions">
                                <field name="exit_action_ids"/>
                            </page>
                            <page string="Security">
                                <field name="edit_group_ids" widget="many2many_tags"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="ak_workflow_state_search_view" model="ir.ui.view">
            <field name="name">ak.workflow.state.search</field>
            <field name="model">ak.workflow.state</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="workflow_id"/>
                    <field name="default_duration_days"/>
                    <filter name="initial_states" string="Initial States" domain="[('is_initial', '=', True)]"/>
                    <filter name="final_states" string="Final States" domain="[('is_final', '=', True)]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_by_workflow" string="Workflow" context="{'group_by': 'workflow_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="ak_workflow_state_tree_view" model="ir.ui.view">
            <field name="name">ak.workflow.state.tree</field>
            <field name="model">ak.workflow.state</field>
            <field name="arch" type="xml">
                <list>
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="workflow_id"/>
                    <field name="is_initial"/>
                    <field name="is_final"/>
                    <field name="default_duration_days"/>
                    <field name="fold"/>
                </list>
            </field>
        </record>

        <record id="action_ak_workflow_state" model="ir.actions.act_window">
            <field name="name">States</field>
            <field name="res_model">ak.workflow.state</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="ak_workflow_state_search_view"/>
            <field name="view_ids" eval="[(5, 0, 0),
                                         (0, 0, {'view_mode': 'list', 'view_id': ref('ak_workflow_state_tree_view')}),
                                         (0, 0, {'view_mode': 'form', 'view_id': ref('ak_workflow_state_form_view')})]"/>
        </record>
    </data>
</odoo>