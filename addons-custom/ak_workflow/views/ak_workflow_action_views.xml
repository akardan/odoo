<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ak_workflow_action_form_view" model="ir.ui.view">
            <field name="name">ak.workflow.action.form</field>
            <field name="model">ak.workflow.action</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="trigger_event"/>
                                <field name="workflow_id"/>
                                <field name="trigger_state_id" invisible="trigger_event not in ('state_entry', 'state_exit')"/>
                                <field name="transition_id" invisible="trigger_event != 'transition'"/>
                            </group>
                            <group>
                                <field name="sequence"/>
                                <field name="active"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Action Configuration">
                                <group>
                                    <field name="action_type"/>
                                    <field name="email_template_id" invisible="action_type != 'email'"/>
                                    <field name="method_name" invisible="action_type != 'method'"/>
                                    <field name="field_id" invisible="action_type != 'field_update'"/>
                                    <field name="field_value" invisible="action_type != 'field_update'"/>
                                    <field name="create_model_id" invisible="action_type != 'create_record'"/>
                                    <field name="create_values" invisible="action_type != 'create_record'"/>
                                    <field name="webhook_url" invisible="action_type != 'webhook'"/>
                                    <field name="webhook_method" invisible="action_type != 'webhook'"/>
                                    <field name="webhook_data_expression" invisible="action_type != 'webhook'"/>
                                    <field name="notification_title" invisible="action_type != 'notification'"/>
                                    <field name="notification_message" invisible="action_type != 'notification'"/>
                                    <field name="notification_type" invisible="action_type != 'notification'"/>
                                    <field name="activity_type_id" invisible="action_type != 'activity'"/>
                                    <field name="activity_summary" invisible="action_type != 'activity'"/>
                                    <field name="activity_note" invisible="action_type != 'activity'"/>
                                    <field name="activity_user_id" invisible="action_type != 'activity'"/>
                                    <field name="server_action_id" invisible="action_type != 'server_action'"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_ak_workflow_action" model="ir.actions.act_window">
            <field name="name">Actions</field>
            <field name="res_model">ak.workflow.action</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>