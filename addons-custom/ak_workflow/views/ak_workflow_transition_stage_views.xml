<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Transition Stage Tree View -->
    <record id="view_ak_workflow_transition_stage_tree" model="ir.ui.view">
        <field name="name">ak.workflow.transition.stage.tree</field>
        <field name="model">ak.workflow.transition.stage</field>
        <field name="arch" type="xml">
            <list string="Transition Stages" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="condition_type"/>
                <field name="button_label"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Transition Stage Form View -->
    <record id="view_ak_workflow_transition_stage_form" model="ir.ui.view">
        <field name="name">ak.workflow.transition.stage.form</field>
        <field name="model">ak.workflow.transition.stage</field>
        <field name="arch" type="xml">
            <form string="Transition Stage">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options='{"terminology": "archive"}'/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Örn: İlk Onay, Son Onay, Review"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="transition_id" readonly="1"/>
                            <field name="code"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="workflow_model_id" invisible="1"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Security" name="security">
                            <group>
                                <group string="Required Groups">
                                    <field name="group_ids" widget="many2many_tags"/>
                                </group>
                            </group>
                        </page>
                        
                        <page string="Conditions" name="conditions">
                            <group>
                                <group>
                                    <field name="condition_type"/>
                                </group>
                            </group>
                            <group invisible="condition_type == 'none'">
                                <group string="Python Expression" invisible="condition_type != 'python'">
                                    <field name="condition_expression" widget="ace" options="{'mode': 'python'}" nolabel="1"/>
                                    <div class="text-muted">
                                        Available variables: record, env, user<br/>
                                        Example: record.amount_total > 1000
                                    </div>
                                </group>
                                <group string="Field Condition" invisible="condition_type != 'field'">
                                    <field name="condition_field_id" domain="[('model_id', '=', workflow_model_id)]"/>
                                    <field name="condition_operator"/>
                                    <field name="condition_value"/>
                                </group>
                                <group string="Method Condition" invisible="condition_type != 'method'">
                                    <field name="condition_method"/>
                                    <div class="text-muted">
                                        Method name on the model that returns True/False<br/>
                                        Example: check_approval_required
                                    </div>
                                </group>
                            </group>
                        </page>
                        
                        <page string="UI Configuration" name="ui">
                            <group>
                                <group>
                                    <field name="button_label"/>
                                    <field name="button_class"/>
                                    <field name="icon"/>
                                </group>
                            </group>
                        </page>
                        
                        <page string="Notifications" name="notifications">
                            <group>
                                <group>
                                    <field name="send_notification"/>
                                    <field name="notification_template_id" 
                                           invisible="not send_notification"
                                           domain="[('model_id', '=', workflow_model_id)]"/>
                                </group>
                            </group>
                        </page>
                        
                        <page string="Actions" name="actions">
                            <field name="action_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="action_type"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                        
                        <page string="Description" name="description">
                            <field name="description" placeholder="Bu aşama hakkında açıklama..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Transition Stage Action -->
    <record id="action_ak_workflow_transition_stage" model="ir.actions.act_window">
        <field name="name">Transition Stages</field>
        <field name="res_model">ak.workflow.transition.stage</field>
        <field name="view_mode">list, form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new transition stage
            </p>
            <p>
                Transition stages allow you to define multi-step approval processes.<br/>
                Each stage can have its own approvers, conditions, and actions.
            </p>
        </field>
    </record>

</odoo>