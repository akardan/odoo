<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--
            Workflow Dashboard Views
            This file defines the dashboard for monitoring workflow metrics.
        -->

        <record id="view_workflow_dashboard_form" model="ir.ui.view">
            <field name="name">workflow.dashboard.form</field>
            <field name="model">workflow.analytics</field>
            <field name="arch" type="xml">
                <form string="Workflow Dashboard">
                    <sheet>
                        <h1>Workflow Analytics Dashboard</h1>
                        <p>This dashboard will contain graphs and KPIs for workflows.</p>
                        <!-- Example of a graph view to be embedded -->
                        <!--
                        <group>
                            <field name="graph_view" widget="graph"/>
                        </group>
                        -->
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_workflow_dashboard" model="ir.actions.act_window">
            <field name="name">Dashboard</field>
            <field name="res_model">workflow.analytics</field>
            <field name="view_mode">form</field>
            <field name="usage">dashboard</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Workflow analytics will be displayed here.
                </p>
            </field>
        </record>

        <menuitem
            id="menu_workflow_dashboard"
            name="Dashboard"
            parent="menu_ak_workflow_root"
            action="action_workflow_dashboard"
            sequence="10"/>

    </data>
</odoo>