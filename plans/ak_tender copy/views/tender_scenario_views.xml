<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Scenario Tree View -->
    <record id="view_tender_scenario_tree" model="ir.ui.view">
        <field name="name">ak.tender.scenario.tree</field>
        <field name="model">ak.tender.scenario</field>
        <field name="arch" type="xml">
            <list string="İhale Senaryoları" decoration-success="scenario_status=='awarded'"
                  decoration-info="scenario_status=='shortlisted'"
                  decoration-muted="scenario_status=='eliminated'">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="scenario_type"/>
                <field name="location_id"/>
                <field name="hotel_partner_id"/>
                <field name="meal_plan"/>
                <field name="person_count"/>
                <field name="line_count"/>
                <field name="total_target_price" widget="monetary"/>
                <field name="best_npv_offer" widget="monetary"/>
                <field name="best_npv_partner_id"/>
                <field name="scenario_status" widget="badge" 
                       decoration-success="scenario_status=='awarded'"
                       decoration-info="scenario_status=='shortlisted'"
                       decoration-warning="scenario_status=='active'"
                       decoration-danger="scenario_status=='eliminated'"/>
                <field name="is_mandatory" widget="boolean_toggle"/>
                <field name="is_shortlisted" invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Scenario Form View -->
    <record id="view_tender_scenario_form" model="ir.ui.view">
        <field name="name">ak.tender.scenario.form</field>
        <field name="model">ak.tender.scenario</field>
        <field name="arch" type="xml">
            <form string="İhale Senaryosu">
                <header>
                    <button name="action_add_to_shortlist" string="Kısa Listeye Ekle" 
                            type="object" class="oe_highlight"/>
                    <button name="action_eliminate_scenario" string="Elenle" 
                            type="object" class="btn-danger"/>
                    <button name="action_view_comparison" string="Karşılaştırma" 
                            type="object" class="btn-primary"/>
                    <button name="action_view_lines" string="Kalemleri Görüntüle" 
                            type="object" class="btn-info"/>
                    <field name="scenario_status" widget="statusbar" 
                           statusbar_visible="active,shortlisted,awarded"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_lines" type="object" class="oe_stat_button" icon="fa-list">
                            <field name="line_count" widget="statinfo" string="Kalemler"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Senaryo adı..."/>
                        </h1>
                    </div>
                    <group>
                        <group name="basic_info" string="Temel Bilgiler">
                            <field name="tender_id" readonly="1"/>
                            <field name="scenario_type"/>
                            <field name="sequence"/>
                            <field name="is_mandatory"/>
                            <field name="scenario_source"/>
                            <field name="supplier_id"/>
                        </group>
                        <group name="location_info" string="Lokasyon ve Otel">
                            <field name="location_id"/>
                            <field name="hotel_partner_id"/>
                            <field name="meal_plan"/>
                            <field name="person_count"/>
                            <field name="vip_count"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Tarih Seçenekleri" name="dates">
                            <field name="date_option_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="days"/>
                                    <field name="season_type"/>
                                    <field name="cost_multiplier"/>
                                    <field name="estimated_total_cost" widget="monetary"/>
                                    <field name="is_preferred" widget="boolean_toggle"/>
                                    <field name="offer_count"/>
                                    <field name="best_offer_amount" widget="monetary"/>
                                    <field name="best_offer_partner_id"/>
                                </list>
                            </field>
                        </page>
                        
                        <page string="Kalemler" name="lines">
                            <field name="line_ids">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="line_type"/>
                                    <field name="quantity"/>
                                    <field name="days"/>
                                    <field name="uom_id"/>
                                    <field name="target_price" widget="monetary"/>
                                    <field name="computed_target_total" widget="monetary" sum="Toplam"/>
                                </list>
                            </field>
                        </page>
                        
                        <page string="Fiyatlandırma ve Teklifler" name="pricing">
                            <group>
                                <group string="Hedef Fiyatlar">
                                    <field name="currency_id" invisible="1"/>
                                    <field name="total_target_price" widget="monetary"/>
                                </group>
                                <group string="En İyi Teklifler">
                                    <field name="best_offer_round_1" widget="monetary"/>
                                    <field name="best_offer_round_2" widget="monetary"/>
                                    <field name="improvement_percentage" widget="percentage"/>
                                </group>
                            </group>
                            <group>
                                <group string="NPV Bazlı En İyi Teklif">
                                    <field name="best_npv_offer" widget="monetary"/>
                                    <field name="best_npv_partner_id"/>
                                </group>
                            </group>
                        </page>
                        
                        <page string="Kısa Liste Bilgileri" name="shortlist">
                            <group>
                                <field name="is_shortlisted"/>
                                <field name="shortlist_round"/>
                                <field name="shortlist_date"/>
                                <field name="shortlist_by"/>
                                <field name="shortlist_notes"/>
                            </group>
                        </page>
                        
                        <page string="Eleme Bilgileri" name="elimination"
                              invisible="scenario_status != 'eliminated'">
                            <group>
                                <field name="elimination_reason"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <!-- Chatter -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Scenario Kanban View -->
    <record id="view_tender_scenario_kanban" model="ir.ui.view">
        <field name="name">ak.tender.scenario.kanban</field>
        <field name="model">ak.tender.scenario</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="scenario_status">
                <field name="name"/>
                <field name="scenario_type"/>
                <field name="hotel_partner_id"/>
                <field name="location_id"/>
                <field name="total_target_price"/>
                <field name="best_npv_offer"/>
                <field name="best_npv_partner_id"/>
                <field name="scenario_status"/>
                <field name="is_mandatory"/>
                <field name="line_count"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <div class="o_kanban_record_subtitle">
                                        <field name="scenario_type"/>
                                        <t t-if="record.is_mandatory.raw_value">
                                            <span class="badge badge-warning">Zorunlu</span>
                                        </t>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="hotel_partner_id" widget="many2one_avatar_user"/>
                                <t t-if="record.location_id.raw_value">
                                    <i class="fa fa-map-marker"/> <field name="location_id"/>
                                </t>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <span class="badge badge-pill">
                                        <i class="fa fa-list"/> <field name="line_count"/> Kalem
                                    </span>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="total_target_price" widget="monetary"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Scenario Action -->
    <record id="action_tender_scenario" model="ir.actions.act_window">
        <field name="name">İhale Senaryoları</field>
        <field name="res_model">ak.tender.scenario</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Yeni bir senaryo oluşturun
            </p>
            <p>
                MICE ihaleleri için alternatif senaryolar tanımlayın.
            </p>
        </field>
    </record>

</odoo>
