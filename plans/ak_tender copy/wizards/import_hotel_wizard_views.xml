<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_import_hotel_wizard_form" model="ir.ui.view">
        <field name="name">import.hotel.wizard.form</field>
        <field name="model">import.hotel.wizard</field>
        <field name="arch" type="xml">
            <form string="Otelleri İçe Aktar">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        <p>Excel dosyasında aşağıdaki sütunlar olmalıdır:</p>
                        <p>Şehir, Yöre, Konum, Otel, Yıldız, Oda, Pansiyon, Döviz</p>
                    </div>
                    <group>
                        <field name="excel_file" filename="file_name"/>
                        <field name="file_name" invisible="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_import" string="İçe Aktar" type="object" class="btn-primary"/>
                    <button string="İptal" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Server Action for Import Hotels -->
    <record id="action_import_hotels" model="ir.actions.server">
        <field name="name">Otelleri İçe Aktar</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
            action = {
                'name': 'Otelleri İçe Aktar',
                'type': 'ir.actions.act_window',
                'res_model': 'import.hotel.wizard',
                'view_mode': 'form',
                'target': 'new',
                'context': {'default_file_name': 'oteller.xlsx'},
            }
        </field>
    </record>
</odoo>