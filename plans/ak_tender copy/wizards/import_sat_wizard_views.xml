<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_import_sat_wizard_form" model="ir.ui.view">
        <field name="name">import.sat.wizard.form</field>
        <field name="model">import.sat.wizard</field>
        <field name="arch" type="xml">
            <form string="İhale Tanımlarını (SAT) İçe Aktar">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        <p>Excel dosyasında aşağıdaki sayfa olmalıdır:</p>
                        <p><strong>ILP(300):</strong> İhale tanımları (SAT) verileri</p>
                        <p>Bu işlem, Excel dosyasındaki SAT verilerini ihale tanımlarına dönüştürecektir.</p>
                    </div>
                    <group>
                        <field name="sheet_name"/>
                        <field name="update_existing"/>
                        <field name="excel_file" filename="file_name"/>
                        <field name="file_name" invisible="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_import_sat" string="İçe Aktar" type="object" class="btn-primary"/>
                    <button string="İptal" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Window Action for Import SAT -->
    <record id="action_import_sat_wizard" model="ir.actions.act_window">
        <field name="name">İhale Tanımlarını (SAT) İçe Aktar</field>
        <field name="res_model">import.sat.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_file_name': 'ME5A_RaporuIHALEME5A.XLS'}</field>
    </record>

</odoo>