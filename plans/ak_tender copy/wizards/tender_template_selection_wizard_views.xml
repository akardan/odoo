<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_tender_template_selection_wizard_form" model="ir.ui.view">
            <field name="name">ak.tender.template.selection.wizard.form</field>
            <field name="model">ak.tender.template.selection.wizard</field>
            <field name="arch" type="xml">
                <form string="Şablon Seçimi">
                    <sheet>
                        <group>
                            <field name="tender_id" invisible="1"/>
                            <field name="tender_type" invisible="1"/>
                            <field name="template_id" options="{'no_create': True}"/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_apply_template" string="Şablonu Uygula" type="object" class="btn-primary"/>
                        <button string="İptal" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_tender_template_selection_wizard" model="ir.actions.act_window">
            <field name="name">Şablon Seçimi</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">ak.tender.template.selection.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>