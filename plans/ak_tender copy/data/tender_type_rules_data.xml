        </record>
        
        <!-- ============================================ -->
        <!-- ÖZEL KURALLAR (Special Rules)               -->
        <!-- ============================================ -->
        
        <!-- KURAL 1: Malzeme Grubu 6XXX (Hizmet Alımları) DAIMA INDIRECT -->
        <record id="special_rule_6xxx_direct" model="tender.type.special.rule">
            <field name="name">Hizmet Alımı (6XXX) + Direct Grup → Indirect</field>
            <field name="sequence">1</field>
            <field name="material_group_prefix">6</field>
            <field name="purchasing_group_code"></field>
            <field name="tender_type">indirect</field>
            <field name="responsible_names">Ahmet/Bahar (Hizmet)</field>
            <field name="notes">Hizmet alımları (6XXX) DAIMA indirect olarak işlenir, satınalma grubu ne olursa olsun.</field>
        </record>
        
        <!-- KURAL 2: Malzeme Grubu 9XXX + PG:110 (Bakım/Teknik) → Indirect -->
        <record id="special_rule_9xxx_maintenance" model="tender.type.special.rule">
            <field name="name">Yedek Parça (9XXX) + Bakım (PG:110) → Indirect</field>
            <field name="sequence">2</field>
            <field name="material_group_prefix">9</field>
            <field name="purchasing_group_code">110</field>
            <field name="tender_type">indirect</field>
            <field name="responsible_names">Ahmet (Bakım Yedek Parça)</field>
            <field name="notes">Bakım bölümü için yedek parça alımları indirect olarak işlenir.</field>
        </record>
        
        <!-- KURAL 3: Malzeme Grubu 9XXX + Direct Gruplar → Direct -->
        <record id="special_rule_9xxx_production" model="tender.type.special.rule">
            <field name="name">Yedek Parça (9XXX) + Üretim Grupları → Direct</field>
            <field name="sequence">3</field>
            <field name="material_group_prefix">9</field>
            <field name="purchasing_group_code">114</field>
            <field name="tender_type">direct</field>
            <field name="responsible_names">Gülcan/Eda/Peri (Üretim Yedek Parça)</field>
            <field name="notes">Üretim için yedek parça alımları direct olarak işlenir.</field>
        </record>
        
