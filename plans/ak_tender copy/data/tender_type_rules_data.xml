<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- ============================================ -->
        <!-- MALZEME GRUPLARI (Material Groups)          -->
        <!-- ============================================ -->
        
        <!-- 1XXX: Etken Madde, Yardımcı Madde, Pellet Etken Madde -->
        <record id="material_group_1000" model="tender.type.material.group">
            <field name="name">Etken Madde / Yardımcı Madde</field>
            <field name="code">1000</field>
            <field name="description">Etken Madde, Yardımcı Madde, Pellet Etken Madde</field>
            <field name="default_tender_type">direct</field>
        </record>
        
        <!-- 2XXX: Granül/Bulk, Tablet/kapsül, Kaplı Tablet -->
        <record id="material_group_2000" model="tender.type.material.group">
            <field name="name">Yarı Mamul</field>
            <field name="code">2000</field>
            <field name="description">Granül/Bulk, Tablet/kapsül, Kaplı Tablet</field>
            <field name="default_tender_type">direct</field>
        </record>
        
        <!-- 3XXX: Katı Ürünler, Likit Ürünler -->
        <record id="material_group_3000" model="tender.type.material.group">
