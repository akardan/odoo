        <!-- ============================================ -->
        <!-- TENDER TYPE MATRIX (Singleton Record)       -->
        <!-- ============================================ -->
        
        <record id="tender_type_matrix_default" model="tender.type.matrix">
            <field name="name">Tender Type Matrix</field>
        </record>
        
    </data>
</odoo>