<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Configuration parameters for ak_tender module -->
        <record id="ak_tender_max_lead_time" model="ir.config_parameter">
            <field name="key">ak_tender_max_lead_time</field>
            <field name="value">168</field>
        </record>
        
        <record id="ak_tender_allow_alternative_products" model="ir.config_parameter">
            <field name="key">ak_tender_allow_alternative_products</field>
            <field name="value">True</field>
        </record>
        
        <record id="ak_tender_quality_approval_required" model="ir.config_parameter">
            <field name="key">ak_tender_quality_approval_required</field>
            <field name="value">True</field>
        </record>
        
        <record id="ak_tender_npv_interest_rate" model="ir.config_parameter">
            <field name="key">ak_tender_npv_interest_rate</field>
            <field name="value">10.0</field>
        </record>
        
        <record id="ak_tender_target_margin_below_lowest_offer" model="ir.config_parameter">
            <field name="key">ak_tender.target_margin_below_lowest_offer</field>
            <field name="value">15.0</field>
        </record>
        
        <record id="ak_tender_email_password" model="ir.config_parameter">
            <field name="key">ak_tender.email_password</field>
            <field name="value">Ilko2019*</field>
        </record>
        
        <!-- Set website title to Ilkois -->
        <record id="web_base_title" model="ir.config_parameter">
            <field name="key">web.base.title</field>
            <field name="value">Ilkois</field>
        </record>
    </data>
</odoo>