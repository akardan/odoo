<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Azure AD / Microsoft Entra Configuration Parameters -->
        <!-- 
            Bu parametreler Microsoft Graph API ile OAuth2 authentication için gereklidir.
            Microsoft'un "Improving Security" kapsamında Basic Authentication devre dışı bırakılmıştır.
            
            NOT: Güvenlik nedeniyle gerçek değerler bu dosyada saklanmamaktadır.
            Lütfen bu değerleri Odoo arayüzünden Settings > Technical > Parameters > System Parameters
            menüsünden manuel olarak giriniz.
        -->
        
        <!-- Azure Application (Client) ID -->
        <record id="azure_client_id" model="ir.config_parameter">
            <field name="key">ak_tender.azure_client_id</field>
            <field name="value"></field>
        </record>
        
        <!-- Azure Client Secret (Gizli Dizi Değeri) -->
        <record id="azure_client_secret" model="ir.config_parameter">
            <field name="key">ak_tender.azure_client_secret</field>
            <field name="value"></field>
        </record>
        
        <!-- Azure Tenant ID (Kiracı Kimliği) -->
        <record id="azure_tenant_id" model="ir.config_parameter">
            <field name="key">ak_tender.azure_tenant_id</field>
            <field name="value"></field>
        </record>
        
        <!-- Email User -->
        <record id="email_user" model="ir.config_parameter">
            <field name="key">ak_tender.email_user</field>
            <field name="value"></field>
        </record>
        
        <!-- 
            NOT: Bu parametreler Settings > Technical > Parameters > System Parameters 
            menüsünden görüntülenebilir ve güncellenebilir.
            
            Referanslar:
            - https://learn.microsoft.com/en-us/graph/auth-register-app-v2
            - https://learn.microsoft.com/en-us/exchange/clients-and-mobile-in-exchange-online/deprecation-of-basic-authentication-exchange-online
            - https://techcommunity.microsoft.com/t5/exchange-team-blog/improving-security-together/ba-p/805892
        -->
    </data>
</odoo>