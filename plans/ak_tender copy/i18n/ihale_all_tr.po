"    <p style=\"margin: 0px; padding: 0px; font-size: 14px;\">\n"
"        Dear <t t-out=\"object.partner_id.name or ''\">Brandon Freeman</t>\n"
"        <t t-if=\"object.partner_id.parent_id\">\n"
"            (<t t-out=\"object.partner_id.parent_id.name or ''\">Azure Interior</t>)\n"
"        </t>\n"
"    </p>\n"
"    \n"
"    <!-- Tender Info -->\n"
"    <t t-if=\"object.tender_id\">\n"
"        <div style=\"margin: 15px 0; padding: 10px; background-color: #f8f9fa; border-left: 4px solid #875A7B;\">\n"
"            <strong>Tender No:</strong> <t t-out=\"object.tender_id.code or ''\">TENDER001</t><br/>\n"
"            <strong>SAT Code:</strong> <t t-out=\"object.tender_id.name or ''\">SAT Code</t>\n"
"        </div>\n"
"    </t>\n"
"    \n"
"    <!-- Button and Order Info Row -->\n"
"    <div style=\"display: flex; margin-top: 20px; margin-bottom: 20px;\">\n"
"        <!-- View Quotation Button -->\n"
"        <div style=\"display: inline-block;\">\n"
"            <a t-att-href=\"object.get_portal_url()\" target=\"_blank\" style=\"background-color: #875A7B; padding: 10px 20px; text-decoration: none; color: #fff; border-radius: 3px; font-size: 14px; font-weight: bold; display: inline-block;\">\n"
"                View Purchase Request for Quotation\n"
"            </a>\n"
"        </div>\n"
"        \n"
"        <!-- Order Number and Due Date -->\n"
"        <div style=\"display: inline-block; margin-left: 15px; padding-top: 5px;\">\n"
"            <span t-out=\"object.name or ''\" style=\"font-weight: bold; font-size: 14px;\">P00050</span><br/>\n"
"            <span style=\"background-color: #f2d675; padding: 2px 5px; font-size: 13px;\">Order due date <t t-out=\"object.date_planned and object.date_planned.strftime('%d/%m/%Y') or ''\">13/06/2025</t></span>\n"
"        </div>\n"
"    </div>\n"
"    \n"
"    <!-- Horizontal Line -->\n"
"    <div style=\"border-bottom: 1px solid #e1e1e1; margin-bottom: 15px;\"/>\n"
"    \n"
"    <p style=\"margin: 0px; padding: 0px; font-size: 14px;\">\n"
"        Please find attached the request for quotation <span style=\"font-weight:bold;\" t-out=\"object.name or ''\">P00050</span> from <t t-out=\"object.company_id.name or ''\">YourCompany</t>.\n"
"    </p>\n"
"    \n"
"    <p style=\"margin: 15px 0; font-size: 14px;\">\n"
"        Click on the link to enter your quotation details. After completing your edits, don't forget to click the \"Save All Changes\" button to finalize the save process.\n"
"    </p>\n"
"    \n"
"    <p style=\"margin: 15px 0; font-size: 14px;\">\n"
"        If you have any questions, please do not hesitate to contact us.\n"
"    </p>\n"
"    \n"
"    <p style=\"margin: 15px 0; font-size: 14px;\">\n"
"        Best regards,\n"
"    </p>\n"
"    \n"
"    <p style=\"margin: 0; font-size: 14px;\">\n"
"        <br/>\n"
"        <t t-if=\"not is_html_empty(object.user_id.signature)\" data-o-mail-quote-container=\"1\">\n"
"            <t t-out=\"object.user_id.signature or ''\" data-o-mail-quote=\"1\">ILKOis Admin</t>\n"
"        </t>\n"
"        <t t-else=\"\">\n"
"            ILKOis Admin\n"
"        </t>\n"
"    </p>\n"
"    \n"
"    <!-- Company Info Footer -->\n"
"    <div style=\"border-top: 1px solid #e1e1e1; margin-top: 15px; padding-top: 10px; color: #888888; font-size: 12px;\">\n"
"        <t t-out=\"object.company_id.name or ''\">Kardan.Digital</t>\n"
"    </div>\n"
"</div>"
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-family: Arial, sans-serif;\">\n"
"    <p style=\"margin: 0px; padding: 0px; font-size: 14px;\">\n"
"        Sayın <t t-out=\"object.partner_id.name or ''\">Brandon Freeman</t>\n"
"        <t t-if=\"object.partner_id.parent_id\">\n"
"            (<t t-out=\"object.partner_id.parent_id.name or ''\">Azure Interior</t>)\n"
"        </t>\n"
"    </p>\n"
"\n"
"    <!-- Tender Info -->\n"
"    <t t-if=\"object.tender_id\">\n"
"        <div style=\"margin: 15px 0; padding: 10px; background-color: \n"
"#f8f9fa; border-left: 4px solid \n"
"#875A7B;\">\n"
"            <strong>İhale No:</strong> <t t-out=\"object.tender_id.code or ''\">İHALE001</t><br/>\n"
"            <strong>SAT Kodu:</strong> <t t-out=\"object.tender_id.name or ''\">SAT Kodu</t>\n"
"        </div>\n"
"    </t>\n"
"\n"
"    <!-- Button and Order Info Row -->\n"
"    <div style=\"display: flex; margin-top: 20px; margin-bottom: 20px;\">\n"
"        <!-- View Quotation Button -->\n"
"        <div style=\"display: inline-block;\">\n"
"            <a t-att-href=\"object.get_portal_url()\" target=\"_blank\" style=\"background-color: \n"
"#875A7B; padding: 10px 20px; text-decoration: none; color: #fff; border-radius: 3px; font-size: 14px; font-weight: bold; display: inline-block;\">\n"
"                Satınalma Teklif Talebini Görüntüle\n"
"            </a>\n"
"        </div>\n"
"\n"
"        <!-- Order Number and Due Date -->\n"
"        <div style=\"display: inline-block; margin-left: 15px; padding-top: 5px;\">\n"
"            <span t-out=\"object.name or ''\" style=\"font-weight: bold; font-size: 14px;\">P00050</span><br/>\n"
"            <span style=\"background-color: \n"
"#f2d675; padding: 2px 5px; font-size: 13px;\">Sipariş vadesi <t t-out=\"object.date_planned and object.date_planned.strftime('%d/%m/%Y') or ''\">13/06/2025</t></span>\n"
"        </div>\n"
"    </div>\n"
"\n"
"    <!-- Horizontal Line -->\n"
"    <div style=\"border-bottom: 1px solid \n"
"#e1e1e1; margin-bottom: 15px;\"/>\n"
"\n"
"    <p style=\"margin: 0px; padding: 0px; font-size: 14px;\">\n"
"        Ekte <t t-out=\"object.company_id.name or ''\">YourCompany</t> şirketinden <span style=\"font-weight:bold;\" t-out=\"object.name or ''\">P00050</span> numaralı teklif talebi bulunmaktadır.\n"
"    </p>\n"
"\n"
"    <p style=\"margin: 15px 0; font-size: 14px;\">\n"
"        Teklif detaylarınızı girmek için linke tıklayın. Düzenlemelerinizi tamamladıktan sonra \"Tüm Değişiklikleri Kaydet\" butonuna tıklayarak kaydetme işlemini tamamlamayı unutmayın.\n"
"    </p>\n"
"\n"
"    <p style=\"margin: 15px 0; font-size: 14px;\">\n"
"        Herhangi bir sorunuz varsa, bizimle iletişime geçmekten çekinmeyin.\n"
"    </p>\n"
"\n"
"    <p style=\"margin: 15px 0; font-size: 14px;\">\n"
"        Saygılarımızla,\n"
"    </p>\n"
"\n"
"    <p style=\"margin: 0; font-size: 14px;\">\n"
"        <br/>\n"
"        <t t-if=\"not is_html_empty(object.user_id.signature)\" data-o-mail-quote-container=\"1\">\n"
"            <t t-out=\"object.user_id.signature or ''\" data-o-mail-quote=\"1\">ILKOis Admin</t>\n"
"        </t>\n"
"        <t t-else=\"\">\n"
"            ILKOis Admin\n"
"        </t>\n"
"    </p>\n"
"\n"
"    <!-- Company Info Footer -->\n"
"    <div style=\"border-top: 1px solid \n"
"#e1e1e1; margin-top: 15px; padding-top: 10px; color: \n"
"#888888; font-size: 12px;\">\n"
"        <t t-out=\"object.company_id.name or ''\">Kardan.Digital</t>\n"
"    </div>\n"
"</div>"

#. module: ak_tender
#: model:mail.template,body_html:ak_tender.email_template_new_bid_notification
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        Sayın {{ object.create_uid.name }},\n"
"                    </p>\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        <br/>\n"
"                        <b>{{ object.name }}</b> ihalesine yeni bir teklif alındı.\n"
"                        <br/><br/>\n"
"                        <b>Tedarikçi:</b> {{ ctx['supplier_name'] }}<br/>\n"
"                        <b>Teklif Tutarı:</b> {{ ctx['bid_amount'] }}<br/>\n"
