"                        <br/>\n"
"                        <a href=\"/web#id={{%20ctx['purchase_order'].id%20}}&amp;model=purchase.order&amp;view_type=form\">\n"
"                            Teklifi Görüntüle\n"
"                        </a>\n"
"                    </p>\n"
"                    <br/>\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        Saygılarımızla,<br/>\n"
"                        {{ user.company_id.name }}\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""

#. module: ak_tender
#: model:mail.template,body_html:ak_tender.email_template_all_offers_submitted
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        Merhaba <t t-out=\"object.buyer_id.name or ''\"/>,\n"
"                        <br/><br/>\n"
"                        <strong>İhale No:</strong> <t t-out=\"object.code or ''\">İHALE001</t><br/>\n"
"                        <strong>İhale Adı:</strong> <t t-out=\"object.name or ''\"/><br/>\n"
"                        <strong>Teklif Turu:</strong> <t t-out=\"object.tender_round or 1\"/><br/>\n"
"                        <br/>\n"
"                        Tüm davetli tedarikçiler tekliflerini sunmuşlardır.\n"
"                        <br/><br/>\n"
"                        <strong>Davetli Tedarikçi Sayısı:</strong> <t t-out=\"len(object.invited_partners)\"/>\n"
"                        <br/>\n"
"                        <strong>Teklif Veren Tedarikçiler:</strong>\n"
"                        </p><ul>\n"
"                            <t t-foreach=\"object.purchase_order_ids.filtered(lambda po: po.tender_round == object.tender_round and po.amount_total &gt; 0 and po.state != 'cancel')\" t-as=\"po\">\n"
"                                <li><t t-out=\"po.partner_id.name\"/> - <t t-out=\"po.currency_id.symbol\"/><t t-out=\"'{:,.2f}'.format(po.amount_total)\"/></li>\n"
"                            </t>\n"
"                        </ul>\n"
"                        <br/>\n"
"                        Teklifleri incelemek ve karşılaştırma yapmak için aşağıdaki bağlantıyı kullanabilirsiniz:\n"
"                        <br/>\n"
"                        <div style=\"margin: 16px 0px 16px 0px;\">\n"
"                            <a t-attf-href=\"{{ object.get_base_url() }}/web#id={{ object.id }}&amp;model=ak.tender&amp;view_type=form\" style=\"padding: 8px 16px 8px 16px; font-size: 14px; color: #FFFFFF; text-decoration: none !important; background-color: #875A7B; border: 0px solid #875A7B; border-radius:3px\">\n"
"                                İhaleyi Görüntüle\n"
"                            </a>\n"
"                        </div>\n"
"                        <br/><br/>\n"
"                        Saygılarımızla,\n"
"                        <br/>\n"
"                        <t t-out=\"user.company_id.name or ''\"/>\n"
"                    \n"
"                </div>\n"
"            "
msgstr ""

