odoo.define('ak_tender.portal_purchase', function (require) {
    'use strict';

    var publicWidget = require('web.public.widget');
    var ajax = require('web.ajax');
    var core = require('web.core');
    var _t = core._t;

    publicWidget.registry.PurchasePortalUnitPrice = publicWidget.Widget.extend({
        selector: '.o_portal_purchase_sidebar',
        events: {
            'change input[name^="price_unit_line_"]': '_onPriceUnitChange',
        },

        /**
         * @override
         */
        start: function () {
            return this._super.apply(this, arguments);
        },

        //--------------------------------------------------------------------------
        // Handlers
        //--------------------------------------------------------------------------

        /**
         * Handle price unit change
         *
         * @private
         * @param {Event} ev
         */
        _onPriceUnitChange: function (ev) {
            var $input = $(ev.currentTarget);
            var lineId = $input.attr('name').replace('price_unit_line_', '');
            var priceUnit = parseFloat($input.val());
            
            if (isNaN(priceUnit) || priceUnit < 0) {
                $input.addClass('is-invalid');
                return;
            }
            
            $input.removeClass('is-invalid');
            
            // Get the order ID from the table data attribute
            var orderId = $('#purchase_order_table').data('order-id');
            var token = $('#purchase_order_table').data('token');
            
            // Show loading indicator
            $input.addClass('o_loading');
            
            // Send the updated price to the server
            ajax.jsonRpc('/my/purchase/update_supplier_order', 'call', {
                'line_id': parseInt(lineId),
                'price_unit': priceUnit,
                'order_id': orderId,
                'access_token': token,
            }).then(function (data) {
                $input.removeClass('o_loading');
                if (data.error) {
                    // Show error
                    $input.addClass('is-invalid');
                    $input.tooltip({
                        title: data.error,
                        trigger: 'manual',
                        placement: 'bottom'
                    }).tooltip('show');
                    setTimeout(function () {
                        $input.tooltip('hide');
                    }, 3000);
                } else {
                    // Show success
                    $input.addClass('is-valid');
                    setTimeout(function () {
                        $input.removeClass('is-valid');
                    }, 2000);
                    
                    // Update the total if returned
                    if (data.amount_total) {
                        $('h2[data-id="total_amount"]').text(data.amount_total);
                    }
                    
                    // Update the subtotal if returned
                    if (data.price_subtotal) {
                        $input.closest('tr').find('.oe_order_line_price_subtotal').text(data.price_subtotal);
                    }
                }
            }).guardedCatch(function (error) {
                $input.removeClass('o_loading');
                $input.addClass('is-invalid');
            });
        },
    });
});